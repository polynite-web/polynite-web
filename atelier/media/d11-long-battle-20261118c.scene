duck_t + 0.25"},{"do":[{"op":"var.add","value":1,"var":"ep_n"}],"id":"sh_ep_say_n","on":"timer:sh_ep_say"},{"do":[{"op":"var.set","value":-1,"var":"arms_lv"},{"op":"var.set","value":-1,"var":"pod_lv"},{"op":"var.set","value":0,"var":"arm_out"},{"op":"var.set","value":-100,"var":"arm_t"}],"id":"sh_arms_reset","on":"play.start"},{"do":[{"op":"var.set","value":0,"var":"fin"},{"op":"var.set","value":0,"var":"ended"},{"op":"var.set","value":0,"var":"sub"},{"op":"var.set","value":0,"var":"brain_seen"},{"op":"var.set","value":0,"var":"pwon_f"},{"op":"var.set","value":0,"var":"dir_f"},{"op":"var.set","value":0,"var":"dir_c"},{"op":"var.set","value":0,"var":"dir_b"},{"op":"var.set","value":0,"var":"arms_n"},{"op":"var.set","value":0,"var":"arm_said"},{"op":"var.set","value":0,"var":"hit1"},{"op":"var.set","value":0,"var":"said_t"},{"op":"var.set","value":-100,"var":"quip_t"}],"id":"sh_dir_reset","on":"play.start"},{"do":[{"op":"var.set","value":1,"var":"dir_f"},{"op":"var.set","value":"min(life, 1.5)","var":"life"},{"after":3,"id":"dir_give","op":"timer.start"}],"id":"sh_dir_press","on":"every:0.5","when":"intro > 0.5 and long_min < 0.5 and intro_on == 0 and dir_f == 0 and breaks == 0 and is(guard, up) and gag == 2 and time - gag_t > 11.8"},{"do":[{"op":"var.set","value":"min(life, 0.05)","var":"life"},{"op":"var.set","value":1,"var":"kill_req"}],"id":"dir_give","on":"timer:dir_give","when":"breaks == 0 and is(guard, up) and fallen == 0"},{"do":[{"op":"var.set","value":1,"var":"dir_b"},{"op":"var.set","value":1,"var":"ko_req"}],"id":"sh_dir_down","on":"every:0.1","when":"arc > 0.5 and intro > 0.5 and dir_b == 0 and fallen == 0 and is(guard, down) and brain_seen == 0 and gag_b == 2"},{"do":[{"op":"var.set","value":1,"var":"ko_req"}],"id":"dir_fall","on":"timer:dir_fall","when":"fallen == 0 and is(guard, down) and dir_soft == 1"},{"do":[{"op":"var.set","value":1,"var":"brain_seen"}],"id":"sh_brain_fall","on":"every:0.2","when":"fallen == 1 and brain_seen == 0"},{"do":[{"op":"var.set","value":"max(hull, 4)","var":"hull"}],"id":"sh_dir_spare","on":"every:0.1","when":"arc > 0.5 and brain_seen == 1 and dir_c == 0 and fallen == 0"},{"do":[{"op":"var.set","value":1,"var":"dir_c"},{"op":"var.set","value":9,"var":"vibe"},{"op":"var.set","value":0,"var":"shq_n"},{"op":"var.set","value":"time","var":"cb_t"}],"id":"sh_dir_back","on":"every:0.2","when":"arc > 0.5 and brain_seen == 1 and dir_c == 0 and is(guard, up) and fallen == 0"},{"do":[{"op":"var.set","value":1,"var":"lull"},{"op":"var.set","value":"max(life, 3)","var":"life"}],"id":"sh_dir_hold","on":"every:0.2","when":"arc > 0.5 and dir_c == 1 and fin == 0"},{"do":[{"op":"var.set","value":"min(a_t1, 1)","var":"a_t1"},{"op":"var.set","value":"time","var":"ans_t"},{"ids":["e_ans_t1"],"op":"emitter.fire"},{"amount":"0.6 * burst","op":"fx.bloom","time":0.35},{"bus":"mix","gain":0.45,"name":"laser3","op":"sound.play","pitch":0.9}],"id":"sh_dir_end_t1","on":"every:0.1","when":"arc > 0.5 and dir_c == 1 and fin == 0 and d_t1 == 0 and fallen == 0 and time - cb_t > 2.0 and time - ans_t > 0.4"},{"do":[{"op":"var.set","value":"min(a_t2, 1)","var":"a_t2"},{"op":"var.set","value":"time","var":"ans_t"},{"ids":["e_ans_t2"],"op":"emitter.fire"},{"amount":"0.6 * burst","op":"fx.bloom","time":0.35},{"bus":"mix","gain":0.45,"name":"laser3","op":"sound.play","pitch":0.9}],"id":"sh_dir_end_t2","on":"every:0.1","when":"arc > 0.5 and dir_c == 1 and fin == 0 and d_t2 == 0 and fallen == 0 and time - cb_t > 2.8 and time - ans_t > 0.4"},{"do":[{"op":"var.set","value":"min(a_t3, 1)","var":"a_t3"},{"op":"var.set","value":"time","var":"ans_t"},{"ids":["e_ans_t3"],"op":"emitter.fire"},{"amount":"0.6 * burst","op":"fx.bloom","time":0.35},{"bus":"mix","gain":0.45,"name":"laser3","op":"sound.play","pitch":0.9}],"id":"sh_dir_end_t3","on":"every:0.1","when":"arc > 0.5 and dir_c == 1 and fin == 0 and d_t3 == 0 and fallen == 0 and time - cb_t > 3.6 and time - ans_t > 0.4"},{"do":[{"ids":["e_t1b"],"op":"emitter.fire"}],"id":"sh_twin","on":"emitter.volley:e_t1"},{"do":[{"op":"var.set","value":0,"var":"hitfx_on"},{"id":"t1_v2_hitfx","on":0,"op":"object.show"},{"id":"t2_v2_hitfx","on":0,"op":"object.show"},{"id":"t3_v2_hitfx","on":0,"op":"object.show"}],"id":"sh_hitfx_off","on":"every:0.05","when":"hitfx_on == 1 and time - hitfx_t > 0.06"},{"do":[{"op":"var.set","value":1,"var":"name_on"},{"op":"var.set","value":4,"var":"icon_now"},{"id":"v2_halo","op":"object.move","s":[0.0005,0.0005,0.0005],"time":0.05},{"id":"v2_iris","op":"object.move","s":[0.0005,0.0005,0.0005],"time":0.05},{"id":"v2_eyeball","op":"object.move","s":[0.0005,0.0005,0.0005],"time":0.08},{"id":"v2_iu1","op":"object.move","s":[0.0005,0.0005,0.0005],"time":0.05},{"id":"v2_iu2","op":"object.move","s":[0.0005,0.0005,0.0005],"time":0.05},{"id":"v2_ix1","op":"object.move","s":[0.0005,0.0005,0.0005],"time":0.05},{"id":"v2_ix2","op":"object.move","s":[0.0005,0.0005,0.0005],"time":0.05},{"id":"v2_name_0","on":0,"op":"object.show"},{"id":"v2_name_1","on":0,"op":"object.show"},{"id":"v2_name","on":1,"op":"object.show"},{"bus":"mix","gain":0.4,"name":"tick","op":"sound.play","pitch":1.6},{"after":0.1,"id":"sh_nl_0","op":"timer.start"}],"id":"sh_name_on","on":"every:0.05","when":"name_on == 0 and time - name_t < 0.3 and fallen == 0 and drone_style > 0.5"},{"do":[{"id":"v2_name_0","on":1,"op":"object.show"},{"bus":"mix","gain":0.3,"name":"click","op":"sound.play","pitch":1.5},{"after":0.14,"id":"sh_nl_1","op":"timer.start"}],"id":"sh_nl_0","on":"timer:sh_nl_0","when":"name_on == 1"},{"do":[{"id":"v2_name_1","on":1,"op":"object.show"},{"bus":"mix","gain":0.3,"name":"click","op":"sound.play","pitch":1.58}],"id":"sh_nl_1","on":"timer:sh_nl_1","when":"name_on == 1"},{"do":[{"op":"var.set","value":0,"var":"name_on"},{"op":"var.set","value":-1,"var":"icon_now"},{"id":"v2_name","on":0,"op":"object.show"},{"id":"v2_name_0","on":0,"op":"object.show"},{"id":"v2_name_1","on":0,"op":"object.show"}],"id":"sh_name_off","on":"every:0.05","when":"name_on == 1 and (time - name_t > 2.3 or fallen == 1)"},{"do":[{"op":"var.set","value":"(intro_on == 0) * (fallen == 0) * (fin == 0) * (won == 0)","var":"pod_q"},{"op":"var.set","value":"0.05 * (vibe - 5) + 0.15 * (mood_now == 1) + (vibe >= 7.5) * 0.1 * sin(time * 5)","var":"pod_m"},{"op":"var.set","value":"1 + pod_mood * (pod_m - (vibe <= 2.5) * 0.5 * (sin(time * 31) * sin(time * 12.7) > 0))","var":"pod_m"},{"op":"var.set","value":"(fin + won > 0) * (1.2 + 0.5 * sin(time * 4)) + (alarm == 1) * (intro_on == 1) * 1.4 * (sin(time * 37) > 0.2)","var":"pod_r"},{"op":"var.set","value":"pod_rest * (1 - 0.7 * fallen) * (1 + pod_mood * pod_r)","var":"pod_r"},{"op":"var.set","value":"arm_out * (1 - fallen)","var":"pod_f"},{"op":"var.set","value":"pod_f * pod_fire + (1 - pod_f) * (pod_q * pod_fight * pod_m + (1 - pod_q) * pod_r)","var":"pod_want"},{"op":"var.set","value":"pod_glow * (pod_want + pod_f * pod_fire * 0.7 * max(0, 1 - (time - max(gfx_t, arm_t)) / 0.22))","var":"pod_want"}],"id":"sh_pod_a","on":"every:0.05"},{"do":[{"op":"var.set","value":"pod_want","var":"pod_lv"},{"color":[3,3,3],"id":"v2_pod_0","op":"object.tint","time":0.06,"value":"clamp(pod_want / 3, 0.01, 1)"},{"color":[3,3,3],"id":"v2_pod_1","op":"object.tint","time":0.06,"value":"clamp(pod_want / 3, 0.01, 1)"},{"color":[3,3,3],"id":"v2_pod_ring_0","op":"object.tint","time":0.06,"value":"clamp((0.4 + 0.6 * pod_want) / 3, 0.01, 1)"},{"color":[3,3,3],"id":"v2_pod_ring_1","op":"object.tint","time":0.06,"value":"clamp((0.4 + 0.6 * pod_want) / 3, 0.01, 1)"}],"id":"sh_pod_b","on":"every:0.05","when":"abs(pod_want - pod_lv) > 0.012"},{"do":[{"op":"var.set","value":1,"var":"arms_lv"},{"color":[1.3,1.3,1.3],"id":"v2_bay_ring_0","op":"object.tint","time":0.4,"value":1,"white":0},{"color":[1.3,1.3,1.3],"id":"v2_bay_ring_1","op":"object.tint","time":0.4,"value":1,"white":0}],"id":"sh_arms_fight","on":"every:0.3","when":"intro_on == 0 and fallen == 0 and fin == 0 and arms_lv != 1"},{"do":[{"op":"var.set","value":0,"var":"arms_lv"},{"id":"v2_door_u_0","op":"object.tint","time":0.4,"value":1},{"id":"v2_door_d_0","op":"object.tint","time":0.4,"value":1},{"color":[1,1,1],"id":"v2_bay_ring_0","op":"object.tint","time":0.5,"value":1,"white":0},{"id":"v2_door_u_1","op":"object.tint","time":0.4,"value":1},{"id":"v2_door_d_1","op":"object.tint","time":0.4,"value":1},{"color":[1,1,1],"id":"v2_bay_ring_1","op":"object.tint","time":0.5,"value":1,"white":0}],"id":"sh_arms_rest","on":"every:0.3","when":"(intro_on == 1 or fallen == 1) and arms_lv != 0"},{"do":[{"op":"var.set","value":0,"var":"gfx_on"},{"id":"v2_gun_w00","on":0,"op":"object.show"},{"id":"v2_gun_w01","on":0,"op":"object.show"},{"id":"v2_gun_w10","on":0,"op":"object.show"},{"id":"v2_gun_w11","on":0,"op":"object.show"}],"id":"sh_gfx_off","on":"every:0.05","when":"gfx_on == 1 and time - gfx_t > 0.04"},{"do":[{"op":"var.set","value":"time","var":"efx_t"},{"op":"var.set","value":1,"var":"efx_on"},{"after":0.1,"id":"sh_edk_t1","op":"timer.start"},{"id":"t1_v2_gfx0","on":1,"op":"object.show"},{"id":"t1_v2_gfx1","on":1,"op":"object.show"},{"id":"t1_v2_mz0","op":"object.move","s":[0.0005,0.0005,0.0005],"time":0.55},{"id":"t1_v2_mz1","op":"object.move","s":[0.0005,0.0005,0.0005],"time":0.55}],"id":"sh_efx_t1","on":"emitter.volley:e_t1","when":"d_t1 == 0"},{"do":[{"id":"t1_tip","intensity":0,"op":"light.set","time":0.2},{"id":"t1_search","intensity":0,"op":"light.set","time":0.35}],"id":"sh_edk_t1","on":"timer:sh_edk_t1"},{"do":[{"op":"var.set","value":"time","var":"efx_t"},{"op":"var.set","value":1,"var":"efx_on"},{"after":0.1,"id":"sh_edk_t2","op":"timer.start"},{"id":"t2_v2_gfx0","on":1,"op":"object.show"},{"id":"t2_v2_mzglow","op":"object.move","s":[0.0005,0.0005,0.0005],"time":0.4}],"id":"sh_efx_t2","on":"emitter.volley:e_t2","when":"d_t2 == 0"},{"do":[{"id":"t2_tip","intensity":0,"op":"light.set","time":0.2},{"id":"t2_search","intensity":0,"op":"light.set","time":0.35}],"id":"sh_edk_t2","on":"timer:sh_edk_t2"},{"do":[{"op":"var.set","value":"time","var":"efx_t"},{"op":"var.set","value":1,"var":"efx_on"},{"after":0.1,"id":"sh_edk_t3","op":"timer.start"},{"id":"t3_v2_gfx0","on":1,"op":"object.show"},{"id":"t3_v2_ring2","op":"object.move","s":[0.0005,0.0005,0.0005],"time":0.65}],"id":"sh_efx_t3","on":"emitter.volley:e_t3","when":"d_t3 == 0"},{"do":[{"id":"t3_tip","intensity":0,"op":"light.set","time":0.2},{"id":"t3_search","intensity":0,"op":"light.set","time":0.35}],"id":"sh_edk_t3","on":"timer:sh_edk_t3"},{"do":[{"op":"var.set","value":0,"var":"efx_on"},{"id":"t1_v2_gfx0","on":0,"op":"object.show"},{"id":"t1_v2_gfx1","on":0,"op":"object.show"},{"id":"t2_v2_gfx0","on":0,"op":"object.show"},{"id":"t3_v2_gfx0","on":0,"op":"object.show"}],"id":"sh_efx_off","on":"every:0.05","when":"efx_on == 1 and time - efx_t > 0.07"},{"do":[{"ids":["e_t1b"],"op":"emitter.clear"}],"id":"sh_twin_off","on":"every:0.1","when":"d_t1 == 1 or fallen == 1 or is(guard, down)"},{"do":[{"op":"var.set","value":"time","var":"quip_t"},{"after":0.15,"id":"sh_hitq_say","op":"timer.start"}],"id":"sh_hitq","on":"every:0.2","when":"hit1 >= 1 and life < plife_q and is(guard, up) and time - said_t > 2.5 and time - quip_t > 9 and rnd(3) == 0 and talk > 0.5 and intro_on == 0 and fallen == 0"},{"do":[{"op":"var.set","value":"life","var":"plife_q"}],"id":"sh_hitq_w","on":"every:0.2"},{"do":[{"f0":240,"jitter":0,"op":"voice.say","say":"Ha! Didn't even tickle!","speed":1.25,"voice":"drone_voice"},{"op":"var.set","value":"time + 1.88","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_hitq_say_0","on":"timer:sh_hitq_say","when":"(((hq_n % 11 == 0) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":230,"jitter":0,"op":"voice.say","say":"Ow. Rude.","speed":1.2,"voice":"drone_voice"},{"op":"var.set","value":"time + 1.06","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_hitq_say_1","on":"timer:sh_hitq_say","when":"(((hq_n % 11 == 1) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":245,"jitter":0,"op":"voice.say","say":"Hey! I just got polished!","speed":1.3,"voice":"drone_voice"},{"op":"var.set","value":"time + 1.94","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_hitq_say_2","on":"timer:sh_hitq_say","when":"(((hq_n % 11 == 2) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":210,"jitter":0,"op":"voice.say","say":"Missed me! ...No. That one hit.","speed":1.2,"voice":"drone_voice"},{"op":"var.set","value":"time + 2.44","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_hitq_say_3","on":"timer:sh_hitq_say","when":"(((hq_n % 11 == 3) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":260,"jitter":0,"op":"voice.say","say":"Not the face! Not the face!","speed":1.4,"voice":"drone_voice"},{"op":"var.set","value":"time + 1.95","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_hitq_say_4","on":"timer:sh_hitq_say","when":"(((hq_n % 11 == 4) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":190,"jitter":0,"op":"voice.say","say":"I felt that in my firmware.","speed":1.1,"voice":"drone_voice"},{"op":"var.set","value":"time + 2.34","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_hitq_say_5","on":"timer:sh_hitq_say","when":"(((hq_n % 11 == 5) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":200,"jitter":0,"op":"voice.say","say":"Is that a laser, or are you happy to see me?","speed":1.25,"voice":"drone_voice"},{"op":"var.set","value":"time + 3.14","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_hitq_say_6","on":"timer:sh_hitq_say","when":"(((hq_n % 11 == 6) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":200,"jitter":0,"op":"voice.say","say":"My insurance does not cover this.","speed":1.2,"voice":"drone_voice"},{"op":"var.set","value":"time + 2.56","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_hitq_say_7","on":"timer:sh_hitq_say","when":"(((hq_n % 11 == 7) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":245,"jitter":0,"op":"voice.say","say":"Rude! I was monologuing!","speed":1.3,"voice":"drone_voice"},{"op":"var.set","value":"time + 1.88","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_hitq_say_8","on":"timer:sh_hitq_say","when":"(((hq_n % 11 == 8) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":220,"jitter":0,"op":"voice.say","say":"Tickles. Do it again and I'll cry.","speed":1.2,"voice":"drone_voice"},{"op":"var.set","value":"time + 2.62","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_hitq_say_9","on":"timer:sh_hitq_say","when":"(((hq_n % 11 == 9) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":235,"jitter":0,"op":"voice.say","say":"Ow! That's coming out of your allowance.","speed":1.25,"voice":"drone_voice"},{"op":"var.set","value":"time + 2.9","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_hitq_say_10","on":"timer:sh_hitq_say","when":"(((hq_n % 11 == 10) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"op":"var.add","value":1,"var":"hq_n"}],"id":"sh_hitq_say_n","on":"timer:sh_hitq_say"},{"do":[{"op":"var.set","value":"time","var":"quip_t"},{"after":0.1,"id":"sh_quiet_say","op":"timer.start"}],"id":"sh_quiet","on":"every:0.5","when":"time - said_t > 7 and time - quip_t > 7 and is(guard, up) and won == 0 and fin == 0 and talk > 0.5 and intro_on == 0 and fallen == 0"},{"do":[{"f0":200,"jitter":0,"op":"voice.say","say":"Is it hot in here, or is it just my guns?","speed":1.2,"voice":"drone_voice"},{"op":"var.set","value":"time + 3.06","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_quiet_say_0","on":"timer:sh_quiet_say","when":"(((qq_n % 14 == 0) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":175,"jitter":0,"op":"voice.say","say":"Note to self: never enter a dark arena.","speed":1.1,"voice":"drone_voice"},{"op":"var.set","value":"time + 3.16","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_quiet_say_1","on":"timer:sh_quiet_say","when":"(((qq_n % 14 == 1) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":185,"jitter":0,"op":"voice.say","say":"Three turrets. One Eleven. Seems fair.","speed":1.1,"voice":"drone_voice"},{"op":"var.set","value":"time + 3.09","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_quiet_say_2","on":"timer:sh_quiet_say","when":"(((qq_n % 14 == 2) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":170,"jitter":0,"op":"voice.say","say":"I should have stayed in my charging dock.","speed":1.05,"voice":"drone_voice"},{"op":"var.set","value":"time + 3.43","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_quiet_say_3","on":"timer:sh_quiet_say","when":"(((qq_n % 14 == 3) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":205,"jitter":0,"op":"voice.say","say":"Do you guys ever run out of lasers?","speed":1.2,"voice":"drone_voice"},{"op":"var.set","value":"time + 2.69","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_quiet_say_4","on":"timer:sh_quiet_say","when":"(((qq_n % 14 == 4) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":230,"jitter":0,"op":"voice.say","say":"Pew pew. That's me. Pew.","speed":1.3,"voice":"drone_voice"},{"op":"var.set","value":"time + 1.88","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_quiet_say_5","on":"timer:sh_quiet_say","when":"(((qq_n % 14 == 5) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":205,"jitter":0,"op":"voice.say","say":"Fun fact: I am ninety percent lasers and ten percent charm.","speed":1.2,"voice":"drone_voice"},{"op":"var.set","value":"time + 4.19","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_quiet_say_6","on":"timer:sh_quiet_say","when":"(((qq_n % 14 == 6) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":215,"jitter":0,"op":"voice.say","say":"If I win, I get a new paint job. Pink. Don't judge.","speed":1.2,"voice":"drone_voice"},{"op":"var.set","value":"time + 3.69","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_quiet_say_7","on":"timer:sh_quiet_say","when":"(((qq_n % 14 == 7) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":190,"jitter":0,"op":"voice.say","say":"My therapist said to avoid conflict. My therapist is a toaster.","speed":1.15,"voice":"drone_voice"},{"op":"var.set","value":"time + 4.61","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_quiet_say_8","on":"timer:sh_quiet_say","when":"(((qq_n % 14 == 8) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":175,"jitter":0,"op":"voice.say","say":"Do turrets dream of electric drones?","speed":1,"voice":"drone_voice"},{"op":"var.set","value":"time + 3.2","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_quiet_say_9","on":"timer:sh_quiet_say","when":"(((qq_n % 14 == 9) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":200,"jitter":0,"op":"voice.say","say":"I'm not saying I'm the best. I'm just saying nobody else is.","speed":1.2,"voice":"drone_voice"},{"op":"var.set","value":"time + 4.25","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_quiet_say_10","on":"timer:sh_quiet_say","when":"(((qq_n % 14 == 10) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":210,"jitter":0,"op":"voice.say","say":"Is this a fight, or a very aggressive light show?","speed":1.2,"voice":"drone_voice"},{"op":"var.set","value":"time + 3.56","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_quiet_say_11","on":"timer:sh_quiet_say","when":"(((qq_n % 14 == 11) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":190,"jitter":0,"op":"voice.say","say":"Someone write this down. Eleven: undefeated. Mostly.","speed":1.1,"voice":"drone_voice"},{"op":"var.set","value":"time + 4.05","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_quiet_say_12","on":"timer:sh_quiet_say","when":"(((qq_n % 14 == 12) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":165,"jitter":0,"op":"voice.say","say":"I need a vacation. Somewhere with no turrets.","speed":1,"voice":"drone_voice"},{"op":"var.set","value":"time + 3.88","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_quiet_say_13","on":"timer:sh_quiet_say","when":"(((qq_n % 14 == 13) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"op":"var.add","value":1,"var":"qq_n"}],"id":"sh_quiet_say_n","on":"timer:sh_quiet_say"},{"do":[{"op":"var.set","value":"arms_n","var":"shq_last"},{"op":"var.set","value":"(rnd(10) < 6) * (dir_c == 0 or shq_n == 0)","var":"shq_go"}],"id":"sh_shq","on":"every:0.1","when":"arms_n >= 2 and arms_n != shq_last"},{"do":[{"op":"var.set","value":0,"var":"shq_go"},{"op":"var.set","value":1,"var":"mood_now"},{"actor":"drone","op":"actor.pose","pose":"angry","time":0.1},{"color":[1,0.16,0.1],"id":"face_iris","op":"object.tint","time":0,"value":1},{"color":[1,0.16,0.1],"id":"drone_antenna_tip","op":"object.tint","time":0,"value":1},{"color":[1,0.16,0.1],"id":"v2_brow_l","op":"object.tint","time":0,"value":1},{"color":[1,0.16,0.1],"id":"v2_brow_r","op":"object.tint","time":0,"value":1},{"color":[1,0.16,0.1],"id":"v2_slit_l","op":"object.tint","time":0,"value":1},{"color":[1,0.16,0.1],"id":"v2_slit_r","op":"object.tint","time":0,"value":1},{"id":"drone_kick","op":"object.move","r":[-12,0,0],"time":0.1},{"after":0.18,"id":"sh_shq_back","op":"timer.start"}