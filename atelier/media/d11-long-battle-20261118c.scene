type":"checkbox","var":"evolve"},{"label":"The drone speaks","page":3,"type":"checkbox","var":"talk"},{"label":"Effects volume","max":1.5,"min":0,"page":2,"type":"slider_float","var":"sfx_volume"},{"items":[{"label":"Classic camera (V1)"},{"label":"Orbie (V2)"}],"label":"Drone style","page":3,"type":"combo","var":"drone_style"},{"label":"Glass ball round the eye","page":3,"type":"checkbox","var":"eye_glass"},{"label":"Side pods light (all of it)","max":2,"min":0,"page":3,"type":"slider_float","var":"pod_glow"},{"label":"Pods light: at rest","max":1,"min":0,"page":3,"type":"slider_float","var":"pod_rest"},{"label":"Pods light: in the fight","max":2,"min":0,"page":3,"type":"slider_float","var":"pod_fight"},{"label":"Pods light: firing","max":3,"min":0,"page":3,"type":"slider_float","var":"pod_fire"},{"label":"Pods light: how much its mood shows","max":2,"min":0,"page":3,"type":"slider_float","var":"pod_mood"},{"items":[{"label":"Classic (V1)"},{"label":"Armored (V2)"}],"label":"Turret style","page":1,"type":"combo","var":"turret_style"},{"label":"Intro: it wanders in singing, the alarm, the turrets rise","page":3,"type":"checkbox","var":"intro"},{"label":"Camera distance (x the game's view)","max":1.6,"min":0.4,"page":2,"type":"slider_float","var":"view_zoom"},{"label":"Long film: minutes of battle (0: the short)","max":20,"min":0,"page":3,"type":"slider_float","var":"long_min"}],"title":"Guard drone","values":{"burst":1,"camera_moves":1,"dmg":0.5,"drone_style":1,"evolve":1,"eye_glass":0,"f_t1":0.5,"f_t2":1,"f_t3":2,"flash":1,"free_look":1,"hull_dmg":0.9,"ignite":1,"intro":1,"kick":1,"laser_glow":1.6,"long_min":5,"mirror":3.6,"pod_fight":0.5,"pod_fire":1.4,"pod_glow":1,"pod_mood":1,"pod_rest":0.18,"riposte":1,"roll":1,"sfx_volume":0.8,"shake":1,"talk":1,"turret_style":1,"view_zoom":0.75,"wet":1.2}},"graphs":[{"id":"guard","rules":[{"do":[{"along":"e_t1","id":"drone_knock","k":"0 - 0.3 * min(1.1, f_t1 * kick)","lean":9,"op":"object.move","push":0.16,"time":0.3},{"after":0.31,"id":"settle","op":"timer.start"}],"id":"back_t1","on":"timer:back_t1"},{"do":[{"emitter":"e_t1","from":"t1","material":"shield_fx","op":"vfx.hit"},{"after":1.3,"id":"mood","op":"timer.start"},{"op":"var.set","value":"time","var":"hit_t"},{"at_hit":"e_t1","ids":["shield_spray","deflect"],"op":"emitter.fire","ricochet":true,"scale":"0.9 + 0.35 * f_t1"},{"at_hit":"e_t1","ids":["hit_ring"],"op":"emitter.fire","scale":"0.7 + 0.3 * f_t1"},{"max":10,"min":0,"op":"var.add","value":"0 - dmg * f_t1 * (1 + 0.7 * surge)","var":"life"},{"along":"e_t1","ease":"out","id":"drone_knock","k":"min(1.1, f_t1 * kick)","lean":9,"op":"object.move","push":0.16,"time":0.16},{"after":0.17,"id":"back_t1","op":"timer.start"},{"material":"shield_fx","op":"vfx.set","path":"tint.value","time":0.25,"value":"life / 10"},{"material":"fx_thrust","op":"vfx.set","path":"tint.value","time":0.25,"value":"life / 10"},{"amount":"min(1, (0.05 + 0.07 * f_t1) * shake)","op":"fx.shake","time":0.2},{"amount":0.33,"op":"fx.kick"},{"bus":"mix","gain":0.45,"gap":0.05,"name":"techhit","op":"sound.play","pitch":"1.35 - 0.25 * f_t1"}],"id":"hit_t1","on":"emitter.hit:e_t1","when":"is(up)"},{"do":[{"op":"var.set","value":1,"var":"mood_now"},{"actor":"drone","op":"actor.pose","pose":"angry","time":0.08},{"color":[1,0.16,0.1],"id":"face_iris","op":"object.tint","time":0,"value":1},{"color":[1,0.16,0.1],"id":"drone_antenna_tip","op":"object.tint","time":0,"value":1},{"color":[1,0.16,0.1],"id":"v2_brow_l","op":"object.tint","time":0,"value":1},{"color":[1,0.16,0.1],"id":"v2_brow_r","op":"object.tint","time":0,"value":1},{"color":[1,0.16,0.1],"id":"v2_slit_l","op":"object.tint","time":0,"value":1},{"color":[1,0.16,0.1],"id":"v2_slit_r","op":"object.tint","time":0,"value":1},{"color":[1,0.16,0.1],"id":"v2_iris","op":"object.tint","time":0,"value":1},{"color":[1,0.16,0.1],"id":"v2_glow_top","op":"object.tint","time":0,"value":1}],"id":"anger_t1","on":"emitter.hit:e_t1","when":"is(up) and mood_now != 1 and gag != 1 and