on":"every:0.2","when":"vst != 0 and vibe <= 2.5"},{"do":[{"op":"var.set","value":1,"var":"vst"}],"id":"sh_even","on":"every:0.2","when":"(vst == 2 and vibe < 6) or (vst == 0 and vibe > 4)"},{"do":[{"f0":210,"jitter":0,"op":"voice.say","say":"I'm on fire!","speed":1.25,"voice":"drone_voice"},{"op":"var.set","value":"time + 1.22","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_hot_say_0","on":"timer:sh_hot_say","when":"(((hot_n % 3 == 0 and talk > 0.5 and intro_on == 0 and fallen == 0) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":190,"jitter":0,"op":"voice.say","say":"Is that all you've got?","speed":1.15,"voice":"drone_voice"},{"op":"var.set","value":"time + 2.0","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_hot_say_1","on":"timer:sh_hot_say","when":"(((hot_n % 3 == 1 and talk > 0.5 and intro_on == 0 and fallen == 0) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":220,"jitter":0,"op":"voice.say","say":"Eleven is the best!","speed":1.25,"voice":"drone_voice"},{"op":"var.set","value":"time + 1.64","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_hot_say_2","on":"timer:sh_hot_say","when":"(((hot_n % 3 == 2 and talk > 0.5 and intro_on == 0 and fallen == 0) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"op":"var.add","value":1,"var":"hot_n"}],"id":"sh_hot_say_n","on":"timer:sh_hot_say"},{"do":[{"f0":150,"jitter":0,"op":"voice.say","say":"This is not going well.","speed":0.9,"voice":"drone_voice"},{"op":"var.set","value":"time + 2.42","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_nerv_say_0","on":"timer:sh_nerv_say","when":"(((nerv_n % 3 == 0 and talk > 0.5 and intro_on == 0 and fallen == 0) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":170,"jitter":0,"op":"voice.say","say":"Okay. Okay. Stay calm.","speed":1.3,"voice":"drone_voice"},{"op":"var.set","value":"time + 1.77","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_nerv_say_1","on":"timer:sh_nerv_say","when":"(((nerv_n % 3 == 1 and talk > 0.5 and intro_on == 0 and fallen == 0) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":160,"jitter":0,"op":"voice.say","say":"I want my charger.","speed":0.95,"voice":"drone_voice"},{"op":"var.set","value":"time + 1.92","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_nerv_say_2","on":"timer:sh_nerv_say","when":"(((nerv_n % 3 == 2 and talk > 0.5 and intro_on == 0 and fallen == 0) and time - said_t > 1.4) and fin == 0) and time > duck_t + 0.25"},{"do":[{"op":"var.add","value":1,"var":"nerv_n"}],"id":"sh_nerv_say_n","on":"timer:sh_nerv_say"},{"do":[{"op":"var.set","value":"time","var":"cine_t"},{"after":0.3,"id":"sh_peek_say","op":"timer.start"}],"id":"sh_peek","on":"every:13","when":"vst == 0 and is(guard, up) and time - cine_t > 15 and talk > 0.5 and intro_on == 0 and fallen == 0"},{"do":[{"at":"drone","in":1,"lean":0.8,"op":"camera.move","out":1.3,"pitch":3,"time":2.6,"zoom":0.67}],"id":"sh_peek_cam","on":"every:13","when":"vst == 0 and is(guard, up) and camera_moves > 0.5 and time - cine_t < 0.1 and talk > 0.5 and intro_on == 0 and fallen == 0"},{"do":[{"f0":230,"jitter":0,"op":"voice.say","say":"Are they gone?","speed":1.2,"voice":"drone_voice"},{"op":"var.set","value":"time + 1.38","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_peek_say_0","on":"timer:sh_peek_say","when":"((peek_n % 3 == 0) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":200,"jitter":0,"op":"voice.say","say":"I am a very small drone. Please ignore me.","speed":1.25,"voice":"drone_voice"},{"op":"var.set","value":"time + 3.02","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_peek_say_1","on":"timer:sh_peek_say","when":"((peek_n % 3 == 1) and fin == 0) and time > duck_t + 0.25"},{"do":[{"f0":170,"jitter":0,"op":"voice.say","say":"Note to self: ask for a raise.","speed":1.1,"voice":"drone_voice"},{"op":"var.set","value":"time + 2.55","var":"duck_t"},{"op":"var.set","value":"time","var":"said_t"}],"id":"sh_peek_say_2","on":"timer:sh_peek_say","when":"((peek_n % 3 == 2) and fin == 0) and time > duck_t + 0.25"},{"do":[{"op":"var.add","value":1,"var":"peek_n"}],"id":"sh_peek_say_n","on":"timer:sh_peek_say"},{"do":[{"op":"var.set","value":1,"var":"sp_on"},{"op":"var.set","value":0,"var":"sp_fired"},{"op":"var.set","value":0,"var":"sp_last"},{"op":"var.set","value":"wrap(90 - heading(drone))","var":"ra1"},{"op":"var.set","value":"wrap(-150 - heading(drone))","var":"ra2"},{"op":"var.set","value":"wrap(-30 - heading(drone))","var":"ra3"},{"op":"var.set","value":"ra1 + 1000 * d_t1 + 1000 * (abs(ra1) > 75)","var":"la1"},{"op":"var.set","value":"ra2 + 1000 * d_t2 + 1000 * (abs(ra2) > 75)","var":"la2"},{"op":"var.set","value":"ra3 + 1000 * d_t3 + 1000 * (abs(ra3) > 75)","var":"la3"},{"op":"var.set","value":"ra1 - 1000 * d_t1 - 1000 * (abs(ra1) > 75)","var":"ha1"},{"op":"var.set","value":"ra2 - 1000 * d_t2 - 1000 * (abs(ra2) > 75)","var":"ha2"},{"op":"var.set","value":"ra3 - 1000 * d_t3 - 1000 * (abs(ra3) > 75)","var":"ha3"},{"op":"var.set","value":"(la1 <= la2 and la1 <= la3) * 1 + (la2 < la1 and la2 <= la3) * 2 + (la3 < la1 and la3 < la2) * 3","var":"sp_l"},{"op":"var.set","value":"(ha1 >= ha2 and ha1 >= ha3) * 1 + (ha2 > ha1 and ha2 >= ha3) * 2 + (ha3 > ha1 and ha3 > ha2) * 3","var":"sp_r"},{"op":"var.set","value":"sp_l != sp_r and min(la1, min(la2, la3)) < 500 and max(ha1, max(ha2, ha3)) > -500","var":"split"},{"op":"var.set","value":"split","var":"sp_on"}],"id":"sh_sp_begin","on":"every:0.05","when":"split == 1 and sp_on == 0"},{"do":[{"op":"var.set","value":1,"var":"sp_go"},{"bus":"mix","gain":0.4,"name":"techhit","op":"sound.play","pitch":1.3},{"amount":"0.5 * burst","op":"fx.bloom","time":0.4},{"after":0.05,"id":"sh_epic","op":"timer.start"}],"id":"sh_sp_go","on":"every:0.05","when":"sp_on == 1 and sp_go == 0"},{"do":[{"op":"var.set","value":"(sp_l == 1) * atan2(x(t1) - x(drone), z(t1) - z(drone)) + (sp_l == 2) * atan2(x(t2) - x(drone), z(t2) - z(drone)) + (sp_l == 3) * atan2(x(t3) - x(drone), z(t3) - z(drone))","var":"rl"},{"op":"var.set","value":"wrap(rl - heading(drone))","var":"rl"},{"op":"var.set","value":"clamp(rl, -75, 75) * (abs(rl) < 105)","var":"rl"},{"op":"var.set","value":"(sp_r == 1) * atan2(x(t1) - x(drone), z(t1) - z(drone)) + (sp_r == 2) * atan2(x(t2) - x(drone), z(t2) - z(drone)) + (sp_r == 3) * atan2(x(t3) - x(drone), z(t3) - z(drone))","var":"rr"},{"op":"var.set","value":"wrap(rr - heading(drone))","var":"rr"},{"op":"var.set","value":"clamp(rr, -75, 75) * (abs(rr) < 105)","var":"rr"}],"id":"sh_sp_aim","on":"every:0.05","when":"sp_on == 1"},{"do":[{"id":"v2_gun_0","k":"rl","op":"object.move","r":[0,1,0],"time":0.12}],"id":"sh_gun0","on":"every:0.05","when":"sp_on == 1"},{"do":[{"id":"v2_gun_1","k":"rr","op":"object.move","r":[0,1,0],"time":0.12}],"id":"sh_gun1","on":"every:0.05","when":"sp_on == 1"},{"do":[{"ids":["e_split_0_t1"],"op":"emitter.fire"},{"amount":3.5,"object":"v2_gun_t00","op":"fx.glow","time":0.12},{"id":"v2_gun_w00","on":1,"op":"object.show"},{"op":"var.set","value":"time","var":"gfx_t"},{"op":"var.set","value":1,"var":"gfx_on"}],"id":"sh_fire0_t1","on":"every:0.05","when":"sp_on == 1 and mg_n > 0 and mg_n != sp_last and mg_n % 2 == 0 and sp_l == 1"},{"do":[{"ids":["e_split_0_t2"],"op":"emitter.fire"},{"amount":3.5,"object":"v2_gun_t00","op":"fx.glow","time":0.12},{"id":"v2_gun_w00","on":1,"op":"object.show"},{"op":"var.set","value":"time","var":"gfx_t"},{"op":"var.set","value":1,"var":"gfx_on"}],"id":"sh_fire0_t2","on":"every:0.05","when":"sp_on == 1 and mg_n > 0 and mg_n != sp_last and mg_n % 2 == 0 and sp_l == 2"},{"do":[{"ids":["e_split_0_t3"],"op":"emitter.fire"},{"amount":3.5,"object":"v2_gun_t00","op":"fx.glow","time":0.12},{"id":"v2_gun_w00","on":1,"op":"object.show"},{"op":"var.set","value":"time","var":"gfx_t"},{"op":"var.set","value":1,"var":"gfx_on"}],"id":"sh_fire0_t3","on":"every:0.05","when":"sp_on == 1 and mg_n > 0 and mg_n != sp_last and mg_n % 2 == 0 and sp_l == 3"},{"do":[{"ids":["e_split_1_t1"],"op":"emitter.fire"},{"amount":3.5,"object":"v2_gun_t10","op":"fx.glow","time":0.12},{"id":"v2_gun_w10","on":1,"op":"object.show"},{"op":"var.set","value":"time","var":"gfx_t"},{"op":"var.set","value":1,"var":"gfx_on"}],"id":"sh_fire1_t1","on":"every:0.05","when":"sp_on == 1 and mg_n > 0 and mg_n != sp_last and mg_n % 2 == 1 and sp_r == 1"},{"do":[{"ids":["e_split_1_t2"],"op":"emitter.fire"},{"amount":3.5,"object":"v2_gun_t10","op":"fx.glow","time":0.12},{"id":"v2_gun_w10","on":1,"op":"object.show"},{"op":"var.set","value":"time","var":"gfx_t"},{"op":"var.set","value":1,"var":"gfx_on"}],"id":"sh_fire1_t2","on":"every:0.05","when":"sp_on == 1 and mg_n > 0 and mg_n != sp_last and mg_n % 2 == 1 and sp_r == 2"},{"do":[{"ids":["e_split_1_t3"],"op":"emitter.fire"},{"amount":3.5,"object":"v2_gun_t10","op":"fx.glow","time":0.12},{"id":"v2_gun_w10","on":1,"op":"object.show"},{"op":"var.set","value":"time","var":"gfx_t"},{"op":"var.set","value":1,"var":"gfx_on"}],"id":"sh_fire1_t3","on":"every:0.05","when":"sp_on == 1 and mg_n > 0 and mg_n != sp_last and mg_n % 2 == 1 and sp_r == 3"},{"do":[{"op":"var.set","value":"mg_n","var":"sp_last"},{"op":"var.set","value":1,"var":"sp_fired"}],"id":"sh_fire_mark","on":"every:0.05","when":"sp_on == 1 and mg_n > 0 and mg_n != sp_last"},{"do":[{"op":"var.set","value":0,"var":"sp_on"},{"op":"var.set","value":0,"var":"sp_go"},{"op":"var.set","value":0,"var":"split"},{"op":"var.set","value":9,"var":"glb"},{"op":"var.set","value":9,"var":"grb"},{"id":"v2_gun_0","op":"object.move","r":[0,0,0],"time":0.25},{"id":"v2_gun_1","op":"object.move","r":[0,0,0],"time":0.25}],"id":"sh_sp_end","on":"every:0.1","when":"sp_on == 1 and sp_fired == 1 and mg_n == 0"},{"do":[{"op":"var.set","value":"time","var":"cine_t"},{"actor":"drone","key":"scripted","op":"a