{
  "module": "assembly",
  "style": "rustic",
  "context": [
    {
      "name": "walk",
      "path": "walkway"
    }
  ],
  "program": {
    "version": 1,
    "inputs": [
      {
        "name": "length",
        "min": 2,
        "max": 16,
        "value": 8,
        "description": "Fence length, metres",
        "group": "shape",
        "integer": false
      },
      {
        "name": "height",
        "min": 0.4,
        "max": 3,
        "value": 1.15,
        "description": "Post height, metres",
        "group": "shape",
        "integer": false
      },
      {
        "name": "bays",
        "min": 4,
        "max": 48,
        "value": 24,
        "description": "Number of fence bays",
        "group": "shape",
        "integer": true
      },
      {
        "name": "post_width",
        "min": 0.03,
        "max": 0.3,
        "value": 0.075,
        "description": "Square post width, metres",
        "group": "shape",
        "integer": false
      },
      {
        "name": "clearance",
        "min": 0,
        "max": 1,
        "value": 0.18,
        "description": "Extra free space beyond the path capsule, metres",
        "group": "shape",
        "integer": false
      }
    ],
    "let": [
      {
        "name": "step",
        "value": [
          "div",
          "$length",
          "$bays"
        ]
      },
      {
        "name": "post_radius",
        "value": [
          "mul",
          "$post_width",
          0.707107
        ]
      },
      {
        "name": "panel_radius",
        "value": [
          "sqrt",
          [
            "add",
            [
              "mul",
              0.25,
              [
                "mul",
                "%step",
                "%step"
              ]
            ],
            [
              "mul",
              "$post_width",
              "$post_width"
            ]
          ]
        ]
      }
    ],
    "nodes": [
      {
        "id": "post",
        "op": "primitive",
        "kind": "cube",
        "role": "wood",
        "repeat": {
          "count": [
            "add",
            "$bays",
            1
          ]
        },
        "let": [
          {
            "name": "x",
            "value": [
              "add",
              [
                "mul",
                -0.5,
                "$length"
              ],
              [
                "mul",
                "@i",
                "%step"
              ]
            ]
          }
        ],
        "when": [
          "gte",
          [
            "distance",
            "@walk",
            "%x",
            0
          ],
          [
            "add",
            "$clearance",
            "%post_radius"
          ]
        ],
        "p": [
          "%x",
          [
            "mul",
            "$height",
            0.5
          ],
          0
        ],
        "s": [
          "$post_width",
          "$height",
          "$post_width"
        ]
      },
      {
        "id": "rail",
        "op": "beam",
        "role": "wood",
        "repeat": {
          "count": "$bays",
          "rows": 2
        },
        "let": [
          {
            "name": "mx",
            "value": [
              "add",
              [
                "add",
                [
                  "mul",
                  -0.5,
                  "$length"
                ],
                [
                  "mul",
                  "@i",
                  "%step"
                ]
              ],
              [
                "mul",
                0.5,
                "%step"
              ]
            ]
          },
          {
            "name": "y",
            "value": [
              "mul",
              "$height",
              [
                "add",
                0.35,
                [
                  "mul",
                  "@j",
                  0.5
                ]
              ]
            ]
          }
        ],
        "when": [
          "gte",
          [
            "distance",
            "@walk",
            "%mx",
            0
          ],
          [
            "add",
            "$clearance",
            "%panel_radius"
          ]
        ],
        "a": [
          [
            "add",
            [
              "mul",
              -0.5,
              "$length"
            ],
            [
              "mul",
              "@i",
              "%step"
            ]
          ],
          "%y",
          0
        ],
        "b": [
          [
            "add",
            [
              "add",
              [
                "mul",
                -0.5,
                "$length"
              ],
              [
                "mul",
                "@i",
                "%step"
              ]
            ],
            "%step"
          ],
          "%y",
          0
        ],
        "width": "$post_width"
      },
      {
        "id": "cap",
        "op": "primitive",
        "kind": "sphere",
        "role": "metal",
        "repeat": {
          "count": [
            "add",
            "$bays",
            1
          ]
        },
        "let": [
          {
            "name": "x",
            "value": [
              "add",
              [
                "mul",
                -0.5,
                "$length"
              ],
              [
                "mul",
                "@i",
                "%step"
              ]
            ]
          }
        ],
        "when": [
          "gte",
          [
            "distance",
            "@walk",
            "%x",
            0
          ],
          [
            "add",
            "$clearance",
            "%post_radius"
          ]
        ],
        "p": [
          "%x",
          [
            "add",
            "$height",
            0.025
          ],
          0
        ],
        "s": [
          [
            "mul",
            "$post_width",
            1.3
          ],
          0.05,
          [
            "mul",
            "$post_width",
            1.3
          ]
        ]
      }
    ]
  },
  "materials": {
    "wood": "cedar",
    "roof": "jade_tile",
    "stone": "garden_stone",
    "metal": "dark_metal"
  }
}
