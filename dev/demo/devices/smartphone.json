{
 "op": "architecture",
 "id": "phone",
 "module": "assembly",
 "program": {
  "version": 1,
  "inputs": [
   {"name": "height", "min": 0.1, "max": 0.2, "value": 0.15, "group": "body", "description": "Body height (m)"},
   {"name": "width", "min": 0.05, "max": 0.1, "value": 0.071, "group": "body", "description": "Body width (m)"},
   {"name": "depth", "min": 0.006, "max": 0.014, "value": 0.0079, "group": "body", "description": "Body thickness (m)"},
   {"name": "corner", "min": 0.002, "max": 0.02, "value": 0.0095, "group": "body", "description": "Corner rounding (m)"},
   {"name": "lift", "min": 0, "max": 2, "value": 0, "group": "placement", "description": "Height of the bottom edge above the ground (m)"},
   {"name": "bezel", "min": 0.0012, "max": 0.008, "value": 0.0024, "group": "screen", "description": "Black border around the screen (m)"},
   {"name": "punch", "min": 0, "max": 1, "value": 1, "integer": true, "group": "screen", "description": "Front camera hole"},
   {"name": "lenses", "min": 1, "max": 4, "value": 3, "integer": true, "group": "camera", "description": "Rear lenses"},
   {"name": "lens_size", "min": 0.006, "max": 0.016, "value": 0.0115, "group": "camera", "description": "Lens diameter (m)"},
   {"name": "island", "min": 0, "max": 2, "value": 0, "integer": true, "group": "camera", "description": "Camera island: 0 square, 1 vertical pill, 2 full-width bar"},
   {"name": "bump", "min": 0.0005, "max": 0.004, "value": 0.0016, "group": "camera", "description": "Island thickness (m)"},
   {"name": "body_r", "min": 0, "max": 1, "value": 0.16, "group": "colour"},
   {"name": "body_g", "min": 0, "max": 1, "value": 0.17, "group": "colour"},
   {"name": "body_b", "min": 0, "max": 1, "value": 0.19, "group": "colour"},
   {"name": "frame_tone", "min": 0, "max": 1, "value": 0.55, "group": "colour", "description": "Side frame brightness"}
  ],
  "let": [
   {"name": "cy", "value": ["add", "$lift", ["mul", "$height", 0.5]]},
   {"name": "hd", "value": ["mul", "$depth", 0.5]},
   {"name": "m", "value": ["max", 0.006, ["mul", "$width", 0.09]]},
   {"name": "pitch", "value": ["mul", "$lens_size", 1.32]},
   {"name": "cols", "value": ["min", 2, "$lenses"]},
   {"name": "rows", "value": ["floor", ["div", ["add", "$lenses", 1], 2]]},
   {"name": "iw", "value": ["mix", ["mix", ["add", ["mul", "%cols", "%pitch"], ["mul", "$lens_size", 0.55]], ["add", "$lens_size", ["mul", "$lens_size", 0.5]], ["min", 1, "$island"]], ["sub", "$width", ["mul", "%m", 1.2]], ["max", 0, ["sub", "$island", 1]]]},
   {"name": "ih", "value": ["mix", ["add", ["mul", "%rows", "%pitch"], ["mul", "$lens_size", 0.55]], ["add", ["mul", "$lenses", "%pitch"], ["mul", "$lens_size", 0.3]], ["min", 1, "$island"]]},
   {"name": "ix", "value": ["mix", ["sub", ["mul", "$width", 0.5], ["add", "%m", ["mul", "%iw", 0.5]]], 0, ["max", 0, ["sub", "$island", 1]]]},
   {"name": "iy", "value": ["sub", ["add", "%cy", ["mul", "$height", 0.5]], ["add", "%m", ["mul", "%ih", 0.5]]]},
   {"name": "ir", "value": ["min", ["mul", "%iw", 0.45], ["max", ["mul", "$lens_size", 0.35], ["mul", "$corner", 0.7]]]}
  ],
  "nodes": [
   {"id": "body", "op": "primitive", "kind": "cube", "role": "metal",
    "p": [0, "%cy", 0], "s": ["$width", "$height", "$depth"], "bevel": "$corner",
    "color": ["$body_r", "$body_g", "$body_b"]},
   {"id": "rim", "op": "primitive", "kind": "cube", "role": "metal",
    "p": [0, "%cy", 0], "s": [["add", "$width", 0.0003], ["add", "$height", 0.0003], ["mul", "$depth", 0.62]], "bevel": ["add", "$corner", 0.00015],
    "color": [["mul", "$frame_tone", 0.95], ["mul", "$frame_tone", 0.96], "$frame_tone"]},
   {"id": "gls", "op": "primitive", "kind": "cube", "role": "metal",
    "p": [0, "%cy", ["add", "%hd", 0.0001]], "s": [["sub", "$width", 0.0007], ["sub", "$height", 0.0007], 0.0006], "bevel": ["mul", "$corner", 0.96],
    "color": [0.012, 0.013, 0.016]},
   {"id": "scr", "op": "primitive", "kind": "cube", "role": "metal",
    "p": [0, "%cy", ["add", "%hd", 0.0003]], "s": [["sub", "$width", ["mul", "$bezel", 2]], ["sub", "$height", ["mul", "$bezel", 2]], 0.0004],
    "bevel": ["max", 0.0005, ["sub", "$corner", "$bezel"]], "color": [0.008, 0.009, 0.011]},
   {"id": "pch", "op": "primitive", "kind": "cylinder", "role": "metal", "when": ["gte", "$punch", 0.5],
    "p": [0, ["sub", ["add", "%cy", ["mul", "$height", 0.5]], ["add", "$bezel", 0.0055]], ["add", "%hd", 0.0008]],
    "s": [0.0034, 0.0006, 0.0034], "r": [90, 0, 0], "color": [0.004, 0.004, 0.005]},
   {"id": "isl", "op": "primitive", "kind": "cube", "role": "metal",
    "p": ["%ix", "%iy", ["neg", ["add", "%hd", ["mul", "$bump", 0.5]]]], "s": ["%iw", "%ih", "$bump"], "bevel": "%ir",
    "color": [["mul", "$body_r", 0.82], ["mul", "$body_g", 0.82], ["mul", "$body_b", 0.82]]},
   {"id": "lens", "op": "primitive", "kind": "cylinder", "role": "metal", "repeat": {"count": "$lenses"},
    "let": [{"name": "col", "value": ["mix", ["sub", "@i", ["mul", 2, ["floor", ["div", "@i", 2]]]], 0, ["min", 1, "$island"]]},
            {"name": "row", "value": ["mix", ["floor", ["div", "@i", 2]], "@i", ["min", 1, "$island"]]}],
    "p": [["add", "%ix", ["mul", ["sub", "%col", ["mul", ["sub", ["mix", "%cols", 1, ["min", 1, "$island"]], 1], 0.5]], "%pitch"]],
          ["sub", "%iy", ["mul", ["sub", "%row", ["mul", ["sub", ["mix", "%rows", "$lenses", ["min", 1, "$island"]], 1], 0.5]], "%pitch"]],
          ["neg", ["add", "%hd", ["add", "$bump", 0.0007]]]],
    "s": ["$lens_size", 0.0014, "$lens_size"], "r": [90, 0, 0],
    "color": [["mul", "$frame_tone", 0.6], ["mul", "$frame_tone", 0.6], ["mul", "$frame_tone", 0.62]]},
   {"id": "eye", "op": "primitive", "kind": "cylinder", "role": "metal", "repeat": {"count": "$lenses"},
    "let": [{"name": "col", "value": ["mix", ["sub", "@i", ["mul", 2, ["floor", ["div", "@i", 2]]]], 0, ["min", 1, "$island"]]},
            {"name": "row", "value": ["mix", ["floor", ["div", "@i", 2]], "@i", ["min", 1, "$island"]]}],
    "p": [["add", "%ix", ["mul", ["sub", "%col", ["mul", ["sub", ["mix", "%cols", 1, ["min", 1, "$island"]], 1], 0.5]], "%pitch"]],
          ["sub", "%iy", ["mul", ["sub", "%row", ["mul", ["sub", ["mix", "%rows", "$lenses", ["min", 1, "$island"]], 1], 0.5]], "%pitch"]],
          ["neg", ["add", "%hd", ["add", "$bump", 0.0013]]]],
    "s": [["mul", "$lens_size", 0.66], 0.0006, ["mul", "$lens_size", 0.66]], "r": [90, 0, 0],
    "color": [0.01, 0.012, 0.02]},
   {"id": "fls", "op": "primitive", "kind": "cylinder", "role": "metal",
    "p": [["add", "%ix", ["mul", "%iw", -0.32]], ["sub", "%iy", ["mul", "%ih", 0.36]], ["neg", ["add", "%hd", ["add", "$bump", 0.0004]]]],
    "s": [0.0028, 0.0005, 0.0028], "r": [90, 0, 0], "color": [0.9, 0.86, 0.7]},
   {"id": "pwr", "op": "primitive", "kind": "cube", "role": "metal",
    "p": [["add", ["mul", "$width", 0.5], 0.0004], ["add", "%cy", ["mul", "$height", 0.16]], 0], "s": [0.0012, ["mul", "$height", 0.11], ["mul", "$depth", 0.36]], "bevel": 0.0005,
    "color": [["mul", "$frame_tone", 0.95], ["mul", "$frame_tone", 0.96], "$frame_tone"]},
   {"id": "vol", "op": "primitive", "kind": "cube", "role": "metal",
    "p": [["neg", ["add", ["mul", "$width", 0.5], 0.0004]], ["add", "%cy", ["mul", "$height", 0.2]], 0], "s": [0.0012, ["mul", "$height", 0.16], ["mul", "$depth", 0.36]], "bevel": 0.0005,
    "color": [["mul", "$frame_tone", 0.95], ["mul", "$frame_tone", 0.96], "$frame_tone"]},
   {"id": "base", "op": "anchor", "p": [0, "$lift", 0]},
   {"id": "face", "op": "anchor", "p": [0, "%cy", ["add", "%hd", 0.0008]]}
  ]
 }
}
