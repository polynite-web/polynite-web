 "graphs": [
  {
   "id": "shield",
   "vars": {
    "shield_hit_t": -10
   },
   "rules": [
    {
     "id": "blink",
     "on": "every:3.3",
     "when": "is(game, play) or is(game, title)",
     "do": [
      {
       "op": "object.show",
       "id": "pv_q0_pup_l",
       "on": false
      },
      {
       "op": "object.show",
       "id": "pv_q0_pup_r",
       "on": false
      },
      {
       "op": "object.show",
       "id": "pv_q2_pup_l",
       "on": false
      },
      {
       "op": "object.show",
       "id": "pv_q2_pup_r",
       "on": false
      },
      {
       "op": "actor.pose",
       "actor": "player",
       "pose": "blink",
       "time": 0.05
      },
      {
       "op": "timer.start",
       "id": "unblink",
       "after": 0.12
      }
     ]
    },
    {
     "id": "unblink",
     "on": "timer:unblink",
     "do": [
      {
       "op": "object.show",
       "id": "pv_q0_pup_l",
       "on": true
      },
      {
       "op": "object.show",
       "id": "pv_q0_pup_r",
       "on": true
      },
      {
       "op": "object.show",
       "id": "pv_q2_pup_l",
       "on": true
      },
      {
       "op": "object.show",
       "id": "pv_q2_pup_r",
       "on": true
      },
      {
       "op": "actor.pose",
       "actor": "player",
       "pose": "focus",
       "time": 0.07
      }
     ]
    },
    {
     "id": "unblink_low",
     "on": "timer:unblink",
     "when": "hp(player) <= 1",
     "do": [
      {
       "op": "actor.pose",
       "actor": "player",
       "pose": "worried",
       "time": 0.07
      }
     ]
    },
    {
     "id": "shielded",
     "on": "actor.hit:player",
     "when": "is(game, play) and hp(player) >= hp_seen",
     "do": [
      {
       "op": "fx.glow",
       "object": "pv_player",
       "amount": 2.5,
       "time": 0.25,
       "gap": 0.3
      },
      {
       "op": "fx.shake",
       "amount": 0.25,
       "time": 0.15,
       "gap": 0.3
      },
      {
       "op": "shape.play",
       "id": "pv_shock",
       "time": 0.5,
       "gap": 0.3
      },
      {
       "op": "sound.play",
       "name": "chirp",
       "gain": 0.4,
       "pitch": 0.7,
       "gap": 0.3
      }
     ]
    },
    {
     "id": "steal_sq",
     "on": "emitter.volley:shards",
     "when": "is(game, play) and hp(boss) > 0",
     "do": [
      {
       "op": "fx.glow",
       "object": "pv_boss",
       "amount": 4,
       "time": 0.14
      },
      {
       "op": "sound.play",
       "name": "chirp",
       "gain": 0.25,
       "pitch": 1.6
      }
     ]
    },
    {
     "id": "steal_hx",
     "on": "emitter.volley:shards",
     "when": "is(game, play) and hp(boss) <= 0 and hp(hex) > 0",
     "do": [
      {
       "op": "fx.glow",
       "object": "hx_boss",
       "amount": 4,
       "time": 0.14
      },
      {
       "op": "sound.play",
       "name": "chirp",
       "gain": 0.25,
       "pitch": 1.6
      }
     ]
    },
    {
     "id": "gather",
     "on": "emitter.volley:boss_aim",
     "when": "is(game, play)",
     "do": [
      {
       "op": "sound.play",
       "name": "magic",
       "gain": 0.22,
       "pitch": 1.5
      }
     ]
    },
    {
     "id": "gather_hx",
     "on": "emitter.volley:hx_curve",
     "when": "is(game, play)",
     "do": [
      {
       "op": "sound.play",
       "name": "magic",
       "gain": 0.22,
       "pitch": 1.3
      }
     ]
    },
    {
     "id": "ripple",
     "on": "actor.hit:player",
     "when": "is(game, play)",
     "do": [
      {
       "op": "var.set",
       "var": "shield_hit_t",
       "value": "time"
      }
     ]
    },
    {
     "id": "collect",
     "on": "emitter.hit:shards",
     "when": "is(game, play)",
     "do": [
      {
       "op": "var.add",
       "var": "shards",
       "value": "n"
      },
      {
       "op": "var.add",
       "var": "score",
       "value": "50 * n"
      },
      {
       "op": "fx.glow",
       "object": "pv_player",
       "amount": 1.2,
       "time": 0.15
      },
      {
       "op": "sound.play",
       "name": "message",
       "gain": 0.35,
       "pitch": "0.9 + shards * 0.06",
       "gap": 0.05
      }
     ]
    },
    {
     "id": "collect_up",
     "on": "emitter.hit:shards",
     "when": "is(game, play) and shards >= 4",
     "do": [
      {
       "op": "var.add",
       "var": "shards",
       "value": -4
      },
      {
       "op": "actor.shield",
       "actor": "player",
       "value": "shield(player) + 1"
      },
      {
       "op": "fx.pulse",
       "object": "pv_player",
       "scale": 1.4,
       "time": 0.3
      },
      {
       "op": "sound.play",
       "name": "bell",
       "gain": 0.6,
       "pitch": 1.0
      }
     ]
    },
    {
     "id": "hp_track",
     "on": "actor.hit:player",
     "do": [
      {
       "op": "var.set",
       "var": "hp_seen",
       "value": "hp(player)"
      }
     ]
    }
   ]
  }
 ],
 "notes": "Give the hero actor shield and shield_max, and add \"shards\" to the hit.spark list of its guns. The shards are thrown toward the hero and LIE ON THE FLOOR (accel < 0 stops them) to be picked up; at full power SHARDS_MAGNET (home) draws them in. The hud binds pv_shield_k with v [x(player), z(player)] when shield(player) >= k. A pickup emitter has hit damage 0: emitter.hit:<id> fires, actor.hit does not. hp_seen (a variable, the hero hp at start) tells a hit the shield took from one that hurt; the game graph hurt rules read hp(player) < hp_seen."
}