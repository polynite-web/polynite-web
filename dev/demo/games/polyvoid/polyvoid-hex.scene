     }
    }
   ],
   "hud": [
    {
     "shape": "pv_hud_boss",
     "v": [
      "hp_ratio(boss)",
      "phase"
     ],
     "when": "is(game, play) and hp(boss) > 0"
    },
    {
     "shape": "pv_hud_score",
     "v": [
      "score",
      "mult",
      "grazes(player)"
     ],
     "when": "not is(game, title)"
    },
    {
     "shape": "pv_hud_lives",
     "v": [
      "hp(player)",
      "best"
     ],
     "when": "not is(game, title)"
    },
    {
     "shape": "pv_title",
     "when": "is(game, title) and not paused"
    },
    {
     "shape": "pv_pause",
     "when": "paused"
    },
    {
     "shape": "pv_over",
     "v": [
      "score",
      "best"
     ],
     "when": "is(game, over) and not paused"
    },
    {
     "shape": "pv_win",
     "v": [
      "score",
      "best",
      "clear_time"
     ],
     "when": "is(game, win) and not paused"
    },
    {
     "shape": "hx_hud",
     "v": [
      "hp_ratio(hex)",
      "hphase"
     ],
     "when": "(is(game, play) or is(game, win)) and not is(hex, dormant)"
    }
   ]
  },
