      },
      {
       "do": [
        {
         "op": "var.add",
         "value": "10 * mult * n",
         "var": "score"
        },
        {
         "gain": 0.35,
         "gap": 0.07,
         "name": "tick",
         "op": "sound.play",
         "pitch": "0.9 + mult * 0.06"
        }
       ],
       "id": "hit_boss",
       "on": "actor.hit:boss",
