        }
       ],
       "id": "dash",
       "on": "input.pressed:Dash",
       "when": "is(play)"
      },
      {
       "do": [
        {
         "max": 8,
         "op": "var.add",
         "value": "0.1 * n",
         "var": "mult"
        },
        {
         "op": "var.add",
         "value": "25 * mult * n",
         "var": "score"
        },
        {
         "gain": 0.45,
         "gap": 0.05,
         "name": "click",
         "op": "sound.play",
         "pitch": "1.1 + mult * 0.08"
