05}],"id":"m_join1","on":"msg:mouse_in","when":"time > join_t and hp(mouse1) <= 0 and hp(mouse0) > 0"},{"do":[{"op":"var.set","value":"time","var":"join_t"},{"actor":"mouse2","op":"actor.hp","value":3},{"id":"pv_mz2","on":true,"op":"object.show"},{"ids":["mouse_fire2"],"op":"emitter.start"},{"object":"pv_mz2","op":"fx.pulse","scale":1.8,"time":0.35},{"amount":3,"object":"pv_mz2","op":"fx.glow","time":0.4},{"bus":"snd_mice","gain":0.5,"name":"chirp","op":"sound.play","pitch":2.2}],"id":"m_join2","on":"msg:mouse_in","when":"time > join_t and hp(mouse2) <= 0 and hp(mouse0) > 0 and hp(mouse1) > 0"},{"do":[{"object":"pv_mz0","op":"fx.pulse","scale":1.5,"time":0.25},{"amount":2.5,"object":"pv_mz0","op":"fx.glow","time":0.3},{"bus":"snd_mice","gain":0.35,"gap":0.1,"name":"chirp","op":"sound.play","pitch":2.4}],"id":"m_hurt0","on":"actor.hit:mouse0","when":"hp(mouse0) > 0"},{"do":[{"object":"pv_mz1","op":"fx.pulse","scale":1.5,"time":0.25},{"amount":2.5,"object":"pv_mz1","op":"fx.glow","time":0.3},{"bus":"snd_mice","gain":0.35,"gap":0.1,"name":"chirp","op":"sound.play","pitch":2.4}],"id":"m_hurt1","on":"actor.hit:mouse1","when":"hp(mouse1) > 0"},{"do":[{"object":"pv_mz2","op":"fx.pulse","scale":1.5,"time":0.25},{"amount":2.5,"object":"pv_mz2","op":"fx.glow","time":0.3},{"bus":"snd_mice","gain":0.35,"gap":0.1,"name":"chirp","op":"sound.play","pitch":2.4}],"id":"m_hurt2","on":"actor.hit:mouse2","when":"hp(mouse2) > 0"},{"do":[{"id":"pv_mz0","on":false,"op":"object.show"},{"ids":["mouse_fire0"],"op":"emitter.stop"},{"ids":["mouse_run"],"op":"emitter.fire"},{"bus":"snd_mice","gain":0.45,"gap":0.05,"name":"chirp","op":"sound.play","pitch":2.8}],"id":"m_flee0","on":"actor.dead:mouse0"},{"do":[{"id":"pv_mz1","on":false,"op":"object.show"},{"ids":["mouse_fire1"],"op":"emitter.stop"},{"ids":["mouse_run"],"op":"emitter.fire"},{"bus":"snd_mice","gain":0.45,"gap":0.05,"name":"chirp","op":"sound.play","pitch":2.8}],"id":"m_flee1","on":"actor.dead:mouse1"},{"do":[{"id":"pv_mz2","on":false,"op":"object.show"},{"ids":["mouse_fire2"],"op":"emitter.stop"},{"ids":["mouse_run"],"op":"emitter.fire"},{"bus":"snd_mice","gain":0.45,"gap":0.05,"name":"chirp","op":"sound.play","pitch":2.8}],"id":"m_flee2","on":"actor.dead:mouse2"},{"do":[{"ids":["mouse_fire0"],"op":"emitter.start"}],"id":"m_back0","on":"msg:guns_back","when":"is(game, play) and hp(mouse0) > 0"},{"do":[{"ids":["mouse_fire1"],"op":"emitter.start"}],"id":"m_back1","on":"msg:guns_back","when":"is(game, play) and hp(mouse1) > 0"},{"do":[{"ids":["mouse_fire2"],"op":"emitter.start"}],"id":"m_back2","on":"msg:guns_back","when":"is(game, play) and hp(mouse2) > 0"},{"do":[{"ids":["mouse_fire0","mouse_fire1","mouse_fire2"],"op":"emitter.stop"}],"id":"m_rest","on":"every:0.25","when":"not is(game, play)"}],"vars":{"join_t":-10}}],"hud":[{"shape":"pv_rays","when":"(is(game, title) or is(game, over) or is(game, win)) and not paused"},{"shape":"pv_stage_rays","when":"gfx_tier != 1"},{"shape":"pv_demo_tag","when":"is(game, title) and not paused"},{"shape":"pv_title","when":"is(game, title) and not paused and abs(wrap(angle(player))) < 115"},{"shape":"pv_menu_sq","when":"is(game, title) and not paused"},{"shape":"pv_menu_sq_on","when":"is(game, title) and not paused and abs(wrap(angle(player) + 90)) < 32"},{"shape":"pv_menu_sq_arc","when":"is(game, title) and not paused"},{"shape":"pv_menu_sq_on_arc","when":"is(game, title) and not paused and abs(wrap(angle(player) + 90)) < 32"},{"shape":"pv_menu_all","when":"is(game, title) and not paused"},{"shape":"pv_menu_all_on","when":"is(game, title) and not paused and abs(wrap(angle(player))) < 32"},{"shape":"pv_menu_all_arc","when":"is(game, title) and not paused"},{"shape":"pv_menu_all_on_arc","when":"is(game, title) and not paused and abs(wrap(angle(player))) < 32"},{"shape":"pv_menu_hx","when":"is(game, title) and not paused"},{"shape":"pv_menu_hx_on","when":"is(game, title) and not paused and abs(wrap(angle(player) - 90)) < 32"},{"shape":"pv_menu_hx_arc","when":"is(game, title) and not paused"},{"shape":"pv_menu_hx_on_arc","when":"is(game, title) and not paused and abs(wrap(angle(player) - 90)) < 32"},{"shape":"pv_menu_l0","when":"is(game, title) and not paused and not abs(wrap(angle(player) + 140)) < 12"},{"shape":"pv_menu_l0_on","when":"is(game, title) and not paused and abs(wrap(angle(player) + 140)) < 12"},{"shape":"pv_menu_l0_arc","when":"is(game, title) and not paused"},{"shape":"pv_menu_l0_on_arc","when":"is(game, title) and not paused and abs(wrap(angle(player) + 140)) < 12"},{"shape":"pv_menu_l1","when":"is(game, title) and not paused and not abs(wrap(angle(player) - 180)) < 10"},{"shape":"pv_menu_l1_on","when":"is(game, title) and not paused and abs(wrap(angle(player) - 180)) < 10"},{"shape":"pv_menu_l1_arc","when":"is(game, title) and not paused"},{"shape":"pv_menu_l1_on_arc","when":"is(game, title) and not paused and abs(wrap(angle(player) - 180)) < 10"},{"shape":"pv_menu_l2","when":"is(game, title) and not paused and not abs(wrap(angle(player) - 140)) < 12"},{"shape":"pv_menu_l2_on","when":"is(game, title) and not paused and abs(wrap(angle(player) - 140)) < 12"},{"shape":"pv_menu_l2_arc","when":"is(game, title) and not paused"},{"shape":"pv_menu_l2_on_arc","when":"is(game, title) and not paused and abs(wrap(angle(player) - 140)) < 12"},{"shape":"pv_menu_l3","when":"is(game, title) and not paused and not abs(wrap(angle(player) + 160)) < 8"},{"shape":"pv_menu_l3_on","when":"is(game, title) and not paused and abs(wrap(angle(player) + 160)) < 8"},{"shape":"pv_menu_l3_arc","when":"is(game, title) and not paused"},{"shape":"pv_menu_l3_on_arc","when":"is(game, title) and not paused and abs(wrap(angle(player) + 160)) < 8"},{"shape":"pv_menu_l4","when":"is(game, title) and not paused and not abs(wrap(angle(player) - 160)) < 8"},{"shape":"pv_menu_l4_on","when":"is(game, title) and not paused and abs(wrap(angle(player) - 160)) < 8"},{"shape":"pv_menu_l4_arc","when":"is(game, title) and not paused"},{"shape":"pv_menu_l4_on_arc","when":"is(game, title) and not paused and abs(wrap(angle(player) - 160)) < 8"},{"shape":"pv_silname0","when":"is(game, title) and not paused and menu_pick == 3"},{"shape":"pv_silname1","when":"is(game, title) and not paused and menu_pick == 4"},{"shape":"pv_silname2","when":"is(game, title) and not paused and menu_pick == 5"},{"shape":"pv_silname3","when":"is(game, title) and not paused and menu_pick == 7"},{"shape":"pv_silname4","when":"is(game, title) and not paused and menu_pick == 8"},{"shape":"pv_cage","when":"is(game, title) and not paused and menu_pick >= 3 and menu_pick != 6"},{"shape":"pv_silwait","when":"is(game, title) and not paused and menu_pick >= 3 and menu_pick <= 5"},{"shape":"pv_silleg","when":"is(game, title) and not paused and menu_pick >= 7"},{"shape":"pv_sub_sq","when":"is(game, title) and not paused and abs(wrap(angle(player) + 90)) < 32"},{"shape":"pv_sub_hx","when":"is(game, title) and not paused and abs(wrap(angle(player) - 90)) < 32"},{"shape":"pv_sub_all","when":"is(game, title) and not paused and abs(wrap(angle(player))) < 32 and ((won_sq and won_hx) or unlock_all)"},{"shape":"pv_lock_all","when":"is(game, title) and not paused and abs(wrap(angle(player))) < 32 and not ((won_sq and won_hx) or unlock_all)"},{"shape":"pv_title_ring","when":"is(game, title) and not paused"},{"shape":"pv_title_ring_t","when":"is(game, title) and not paused"},{"shape":"pv_life_sq","v":["hp_ratio(boss)"],"when":"is(game, play) and hp(boss) > 0 and time > card_end"},{"shape":"pv_arena_edge","v":["1.6 * min(ring_form, 1)"],"when":"not is(game, title) or is(game, title)"},{"shape":"pv_arena_live","v":["kick(7) * ring_live * (0.45 + 0.55 * (phase >= 2 or hphase >= 2 or ring_form >= 1))","11.2 + 4.2 * min(ring_form, 1) + 6.3 * max(0, ring_form - 1)"],"when":"is(game, play)"},{"shape":"pv_arena_warn_y","v":["min((time - ring_warn) / 0.8, max(0, 1 - (time - ring_warn - 0.8) / 0.3)) * (0.8 + 0.2 * sin(time * 40))","11.2 + 4.2 * min(ring_form, 1) + 6.3 * max(0, ring_form - 1)"],"when":"is(game, play) and time - ring_warn < 1.1 and ring_col == 0"},{"shape":"pv_arena_warn_o","v":["min((time - ring_warn) / 0.8, max(0, 1 - (time - ring_warn - 0.8) / 0.3)) * (0.8 + 0.2 * sin(time * 40))","11.2 + 4.2 * min(ring_form, 1) + 6.3 * max(0, ring_form - 1)"],"when":"is(game, play) and time - ring_warn < 1.1 and ring_col == 1"},{"shape":"pv_arena_warn_r","v":["min((time - ring_warn) / 0.8, max(0, 1 - (time - ring_warn - 0.8) / 0.3)) * (0.8 + 0.2 * sin(time * 40))","11.2 + 4.2 * min(ring_form, 1) + 6.3 * max(0, ring_form - 1)"],"when":"is(game, play) and time - ring_warn < 1.1 and ring_col == 2"},{"shape":"pv_arena_red","v":["11.2 + 4.2 * min(ring_form, 1) + 6.3 * max(0, ring_form - 1)"],"when":"is(game, play) and ring_form >= 1"},{"shape":"pv_life_hx","v":["hp_ratio(hex)"],"when":"is(game, play) and hp(hex) > 0 and not is(hex, dormant) and time > card_end"},{"shape":"pv_hud_score","v":["score","hp(player)"],"when":"not is(game, title) and not is(game, opening) and time > card_end"},{"shape":"pv_shield_0","v":["x(player)","z(player)","max(0, 1 - (time - shield_hit_t) * 1.6)","(hit_angle(player) - 90) * 0.0174533"],"when":"is(game, play) and hp(player) > 0 and shield(player) >= 1"},{"shape":"pv_shield_1","v":["x(player)","z(player)","max(0, 1 - (time - shield_hit_t) * 1.6)","(hit_angle(player) - 90) * 0.0174533"],"when":"is(game, play) and hp(player) > 0 and shield(player) >= 1 and shield_spiral == 0"},{"shape":"pv_shield_2","v":["x(player)","z(player)","max(0, 1 - (time - shield_hit_t) * 1.6)","(hit_angle(player) - 90) * 0.0174533"],"when":"is(game, play) and hp(player) > 0 and shield(player) >= 2 and shield_spiral == 0"},{"shape":"pv_shield_3","v":["x(player)","z(player)","max(0, 1 - (time - shield_hit_t) * 1.6)","(hit_angle(player) - 90) * 0.0174533"],"when":"is(game, play) and hp(player) > 0 and shield(player) >= 3 and shield_spiral == 0"},{"shape":"pv_shield_4","v":["x(player)","z(player)","max(0, 1 - (time - shield_hit_t) * 1.6)","(hit_angle(player) - 90) * 0.0174533"],"when":"is(game, play) and hp(player) > 0 and shield(player) >= 4 and shield_spiral == 0"},{"shape":"pv_shock_boss","v":["shock_x","shock_z","time - shock_t"],"when":"time - shock_t >= 0 and time - shock_t < 0.9"},{"shape":"pv_burst","v":["burst_x","burst_z","time - burst_t","burst_k"],"when":"time - burst_t >= 0 and time - burst_t < 2.7"},{"shape":"pv_emote_ha","v":["x(boss) * (1 - emote_hex) + x(hex) * emote_hex","z(boss) * (1 - emote_hex) + z(hex) * emote_hex"],"when":"is(game, play) and emote == 1 and time < emote_until"},{"shape":"pv_emote_dots","v":["x(boss) * (1 - emote_hex) + x(hex) * emote_hex","z(boss) * (1 - emote_hex) + z(hex) * emote_hex"],"when":"is(game, play) and emote == 2 and time < emote_until"},{"shape":"pv_emote_bang","v":["x(boss) * (1 - emote_hex) + x(hex) * emote_hex","z(boss) * (1 - emote_hex) + z(hex) * emote_hex"],"when":"is(game, play) and emote == 3 and time < emote_until"},{"shape":"pv_emote_what","v":["x(boss) * (1 - emote_hex) + x(hex) * emote_hex","z(boss) * (1 - emote_hex) + z(hex) * emote_hex"],"when":"is(game, play) and emote == 4 and time < emote_until"},{"shape":"pv_emote_ow","v":["x(boss) * (1 - emote_hex) + x(hex) * emote_hex","z(boss) * (1 - emote_hex) + z(hex) * emote_hex"],"when":"is(game, play) and emote == 5 and time < emote_until"},{"ease":[0,0,0,0.3],"shape":"pv_gun_ring","v":["x(player)","z(player)","heading(player) * 0.0174533","min(1, (wlvl - 1 + (wlvl < 5) * max(0, min(1, (wxp - w_at) / max(0.01, w_next - w_at)))) / 4)"],"when":"is(game, play) and gun_ring == 1 and hp(player) > 0"},{"shape":"pv_gun_lost","v":["x(player)","z(player)","max(0, 1 - (time - gun_lost_t) * 2)","heading(player) * 0.0174533"],"when":"is(game, play) and gun_ring == 1 and time - gun_lost_t < 0.5"},{"shape":"pv_charge_0","v":["x(player)","z(player)","nova_charge","time"],"when":"is(game, play) and hp(player) > 0 and nova_hold == 1 and nova_charge < 1"},{"shape":"pv_charge_1","v":["x(player)","z(player)","nova_charge","time"],"when":"is(game, play) and hp(player) > 0 and nova_hold == 1 and nova_charge >= 1 and nova_charge < 2.5"},{"shape":"pv_charge_2","v":["x(player)","z(player)","nova_charge","time"],"when":"is(game, play) and hp(player) > 0 and nova_hold == 1 and nova_charge >= 2.5"},{"ease":[0,0,0.35],"shape":"pv_shield_next","v":["x(player)","z(player)","min(tail_max - 0.001, shield(player) + shards / (8 / shield_rate))"],"when":"is(game, play) and hp(player) > 0 and shield(player) < 4 and shield_spiral == 0"},{"ease":[0,0,0.35,0],"shape":"pv_shield_tail","v":["x(player)","z(player)","min(tail_max, shield(player) + shards / (8 / shield_rate))","(angle(player) + 90) * 0.0174533 + 10 * round(max(0, 1 - (time - shield_hit_t) * 1.6) * 99) + 1000 * round((wrap(hit_angle(player) - angle(player) - 180) + 180) / 10)"],"when":"is(game, play) and hp(player) > 0 and shield_spiral == 1 and shield_style == 1 and min(tail_max, shield(player) + shards / (8 / shield_rate)) > 0"},{"ease":[0,0,0.35,0],"shape":"pv_shield_spiral","v":["x(player)","z(player)","min(tail_max, shield(player) + shards / (8 / shield_rate))","(angle(player) + 90) * 0.0174533 + 10 * round(max(0, 1 - (time - shield_hit_t) * 1.6) * 99) + 1000 * round((wrap(hit_angle(player) - angle(player) - 180) + 180) / 10)"],"when":"is(game, play) and hp(player) > 0 and shield_spiral == 1 and shield_style == 2 and min(tail_max, shield(player) + shards / (8 / shield_rate)) > 0"},{"ease":[0,0,0.12],"shape":"pv_nova_ring","v":["x(player)","z(player)","nova_charge / 4"],"when":"is(game, play) and hp(player) > 0 and nova_hold == 1"},{"ease":[0,0,0.6],"shape":"pv_shield_soft","tail":{"actor":"player","block":true,"damp":0.6,"firm":90,"fold":0.35,"inertia":"tail_inertia","kick":3,"msg":"tail_hit","n":80,"rest":[0.95,0.18,10,24],"soft":14,"wave_amp":"tail_wave","wave_fade":"tail_wave_fade","wave_speed":"tail_wave_speed","width":0.1},"v":["x(player)","z(player)","min(tail_max, shield(player) + shards / (8 / shield_rate))"],"when":"is(game, play) and shield_spiral == 1 and shield_style == 0 and hp(player) > 0"},{"ease":[0,0.3],"shape":"pv_hud_mult","v":["floor(min(tail_max, shield(player) + shards / (8 / shield_rate)))","(min(tail_max, shield(player) + shards / (8 / shield_rate)) >= tail_max) + min(tail_max, shield(player) + shards / (8 / shield_rate)) - floor(min(tail_max, shield(player) + shards / (8 / shield_rate)))"],"when":"is(game, play) and time > card_end"},{"shape":"pv_hud_tail_max","when":"is(game, play) and time > card_end and min(tail_max, shield(player) + shards / (8 / shield_rate)) >= tail_max"},{"ease":[0,0.3],"shape":"pv_hud_laser","v":["wlvl","min(1, (wlvl >= 5) + (wxp - w_at) / max(0.01, w_next - w_at))"],"when":"is(game, play) and time > card_end"},{"shape":"pv_arena_out1","when":"is(game, play) and ring_form >= 1"},{"shape":"pv_arena_out2","when":"is(game, play) and ring_form >= 2"},{"shape":"pv_pause","when":"paused"},{"shape":"pv_ctrl_touch","when":"paused and is(game, play) and input_touch == 1"},{"shape":"pv_ctrl_mouse","when":"paused and is(game, play) and input_touch == 0"},{"shape":"pv_btn_resume","when":"paused"},{"shape":"pv_btn_quit","when":"paused"},{"shape":"pv_btn_view_far","when":"paused and view_zoom > 0.89"},{"shape":"pv_btn_view_near","when":"paused and view_zoom <= 0.89"},{"shape":"pv_over","v":["score"],"when":"is(game, over) and not paused"},{"shape":"pv_win","v":["score",0,"clear_time"],"when":"is(game, win) and not paused"},{"shape":"pv_btn_skip","when":"is(game, opening) and not paused"},{"shape":"pv_cine_rose","when":"is(game, opening) and cine_beat == 3"},{"shape":"pv_cine_no","when":"is(game, opening) and cine_no == 1"},{"shape":"pv_freed","v":["mice_freed"],"when":"(is(game, play) or is(game, win)) and not paused and time - freed_t < 6"},{"shape":"pv_tease","when":"is(game, win) and not paused and time - clear_time > 3.6"},{"shape":"pv_cine_save","when":"is(game, title) and time - save_t > 0.5 and time - save_t < 3.6"},{"shape":"pv_btn_retry","when"