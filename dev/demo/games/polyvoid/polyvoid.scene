e":"checkbox","var":"dev_god"},{"label":"Unlock all levels","page":4,"text":"Every level open on the menu.","type":"checkbox","var":"unlock_all"},{"label":"Controls tips seen (untick: shown again)","page":4,"text":"Untick to see the controls tips again.","type":"checkbox","var":"tut_seen"},{"items":[{"label":"Never"},{"label":"First time"},{"label":"Every time"}],"label":"Intro","page":4,"text":"The little scene before the title: never, only the first time, or each time the game opens (never after RETRY or MENU).","type":"combo","var":"intro_mode"},{"label":"Intro seen","page":4,"text":"Untick to see the intro again when it plays only the first time.","type":"checkbox","var":"intro_seen"},{"label":"Beam tip seen","page":4,"text":"Untick to see the beam tip again.","type":"checkbox","var":"tip_beam"},{"label":"Run: Square beaten","page":4,"text":"Kept progress: the Square beaten.","type":"checkbox","var":"won_sq"},{"label":"Run: Warden beaten","page":4,"text":"Kept progress: the Warden beaten.","type":"checkbox","var":"won_hx"},{"label":"Run: Gauntlet beaten","page":4,"text":"Kept progress: the Gauntlet beaten.","type":"checkbox","var":"won_all"},{"label":"Medal: Square untouched","page":4,"text":"Medal: the Square beaten without a hit.","type":"checkbox","var":"nohit_sq"},{"label":"Medal: Warden untouched","page":4,"text":"Medal: the Warden beaten without a hit.","type":"checkbox","var":"nohit_hx"},{"label":"Medal: Square final form","page":4,"text":"Medal: the Square's final form beaten.","type":"checkbox","var":"final_sq"},{"label":"Medal: Warden final form","page":4,"text":"Medal: the Warden's final form beaten.","type":"checkbox","var":"final_hx"},{"label":"Shield always full","page":4,"text":"For trying things: off for a real game. Hold the game icon to hide or show its HUD.","type":"checkbox","var":"dev_shield"},{"label":"Wet floor (neon streaks)","page":5,"text":"Glows streak down on the floor, as on a wet street.","type":"checkbox","var":"wet_on"},{"decimals":2,"label":"Wet strength","max":3,"min":0.1,"page":5,"text":"Every glow leaves a streak under it, as a neon sign on wet asphalt.","type":"slider_float","unit":"x","var":"wet_amount"},{"decimals":2,"label":"Floor reflection","max":4,"min":0,"page":5,"text":"How much the floor reflects.","type":"slider_float","var":"mirror_amount"},{"decimals":2,"label":"Reflection blur","max":1,"min":0,"page":5,"text":"How blurred the floor's reflection is.","type":"slider_float","var":"mirror_blur"},{"decimals":2,"label":"Pause: dimming","max":0.9,"min":0,"page":5,"text":"How dark the scene goes while paused.","type":"slider_float","var":"pause_dim"},{"decimals":2,"label":"Pause: inertia","max":2,"min":0,"page":5,"text":"How long time takes to stop and start again.","type":"slider_float","unit":" s","var":"pause_inertia"},{"decimals":1,"label":"Pause: camera sway","max":6,"min":0,"page":5,"text":"How far the camera drifts and pushes in while paused.","type":"slider_float","unit":" deg","var":"pause_sway"},{"decimals":2,"label":"Pause: sound","max":2,"min":0,"page":5,"text":"The pause and resume notes' volume.","type":"slider_float","unit":"x","var":"pause_sfx"},{"decimals":2,"label":"Laser lighting: white-hot","max":3,"min":0,"page":5,"text":"A laser lighting: how white-hot the beam flares.","type":"slider_float","var":"ignite_glow"},{"decimals":2,"label":"Laser lighting: screen glow","max":3,"min":0,"page":5,"text":"A laser lighting: how much the screen's glow swells.","type":"slider_float","var":"ignite_bloom"},{"decimals":1,"label":"Laser lighting: camera knock","max":8,"min":0,"page":5,"text":"A laser lighting or a big moment: how far the camera is knocked up.","type":"slider_float","unit":" deg","var":"ignite_tilt"},{"label":"Screen impact","page":5,"type":"section"},{"decimals":2,"label":"Impact: overall strength","max":3,"min":0,"page":5,"text":"Every screen jolt (knock, roll, shake), times this.","type":"slider_float","unit":"x","var":"impact"},{"decimals":2,"label":"Impact: roll side to side","max":5,"min":0,"page":5,"small":true,"text":"How far a blow rolls the view side to side.","type":"slider_float","unit":" deg","var":"impact_roll"},{"decimals":2,"label":"Impact: jolt across (X/Y)","max":3,"min":0,"page":5,"small":true,"text":"How far a blow jolts the view across.","type":"slider_float","unit":"x","var":"impact_xy"},{"decimals":2,"label":"Impact: shake","max":3,"min":0,"page":5,"small":true,"text":"A blow (a name landing, a laser lighting) knocks the camera up (camera knock), rolls the view side to side and jolts it across; the shakes too.","type":"slider_float","unit":"x","var":"shake_gain"},{"label":"Close shave slow-mo (a shot grazes the ship)","page":5,"text":"A shot grazing the ship slows time a moment.","type":"checkbox","var":"graze_slow"},{"decimals":2,"label":"Living ring: throb","max":2,"min":0,"page":5,"text":"How much the arena's rings throb with the music.","type":"slider_float","unit":"x","var":"ring_live"},{"label":"Hits to shut an eye","max":150,"min":10,"page":6,"text":"Darts on one eye to shut it; a shut eye fires nothing that way.","type":"slider_int","var":"eye_hits"},{"label":"Final forms","max":2,"min":0,"page":6,"text":"Final forms a boss rises into after it falls.","type":"slider_int","var":"forms"},{"label":"Final forms: the ship may go back inward (over the ring it left)","page":6,"text":"At 0 life the last boss of the run falls - and rises again, bigger: the arena opens a ring wider, the ship is pushed out, its shots grow. 0: none.","type":"checkbox","var":"inner_band"}],"title":"Polyvoid","values":{"beam_glow":3,"blue_tail":1,"body_ratio":4,"core_look":0,"core_min":0.35,"core_pow":1,"core_tail":4,"core_xp":1,"dev_god":0,"dev_shield":0,"disc_on":1,"disc_strength":1,"eye_hits":40,"final_hx":1,"final_pick":0,"final_sq":1,"forms":1,"full_bonus":150,"graze_slow":1,"gun_ring":1,"ignite_bloom":1.2,"ignite_glow":1,"ignite_tilt":2.5,"impact":1,"impact_roll":1.2,"impact_xy":1,"inner_band":0,"intro_mode":2,"intr