"}],"id":"tail_begin","on":"msg:start_mode"},{"do":[{"amount":0.25,"id":"pv_hud_tail_max","op":"shape.kick"}],"id":"tail_full","on":"every:1.1","when":"is(game, play) and min(tail_max, shield(player) + shards / (8 / shield_rate)) >= tail_max"},{"do":[{"op":"var.set","value":0,"var":"shards"}],"id":"tail_cap","on":"every:0.1","when":"is(game, play) and shield(player) >= tail_max and shards > 0"},{"do":[{"op":"var.add","value":"1 * n * full_bonus","var":"score"},{"amount":0.4,"id":"pv_hud_tail_max","op":"shape.kick"}],"id":"tail_over","on":"emitter.hit:shards","when":"is(game, play) and shield(player) >= tail_max"},{"do":[{"op":"var.add","value":"1 * n * full_bonus","var":"score"},{"amount":0.4,"id":"pv_hud_tail_max","op":"shape.kick"}],"id":"tail_over_b","on":"emitter.hit:bcores","when":"is(game, play) and shield(player) >= tail_max"},{"do":[{"op":"var.add","value":"1 * n * full_bonus","var":"score"},{"amount":0.4,"id":"pv_hud_tail_max","op":"shape.kick"}],"id":"tail_over_bh","on":"emitter.hit:bcores_h","when":"is(game, play) and shield(player) >= tail_max"},{"do":[{"op":"var.add","value":"(2 * core_val) * n * full_bonus","var":"score"},{"amount":0.4,"id":"pv_hud_tail_max","op":"shape.kick"}],"id":"tail_over_c","on":"emitter.hit:cores","when":"is(game, play) and shield(player) >= tail_max"},{"do":[{"op":"var.add","value":"(2 * core_val) * n * full_bonus","var":"score"},{"amount":0.4,"id":"pv_hud_tail_max","op":"shape.kick"}],"id":"tail_over_ch","on":"emitter.hit:cores_h","when":"is(game, play) and shield(player) >= tail_max"},{"do":[{"amount":0.35,"gap":0.15,"id":"pv_hud_laser","op":"shape.kick"},{"op":"var.set","value":"(wlvl + (wlvl < 5) * min(1, max(0, (wxp - w_at) / max(0.01, w_next - w_at))))","var":"gun_seen"}],"id":"gun_up","on":"every:0.05","when":"is(game, play) and (wlvl + (wlvl < 5) * min(1, max(0, (wxp - w_at) / max(0.01, w_next - w_at)))) > gun_seen + 0.01"},{"do":[{"gap":0.3,"id":"pv_hud_laser_dn","op":"shape.play","time":0.35},{"op":"var.set","value":"(wlvl + (wlvl < 5) * min(1, max(0, (wxp - w_at) / max(0.01, w_next - w_at))))","var":"gun_seen"}],"id":"gun_dn","on":"every:0.05","when":"is(game, play) and (wlvl + (wlvl < 5) * min(1, max(0, (wxp - w_at) / max(0.01, w_next - w_at)))) < gun_seen - 0.01"}],"vars":{"body_ratio":{"keep":true,"value":4},"full_bonus":{"keep":true,"value":150},"gun_seen":1,"heal":0,"life_mode":{"keep":true,"value":2},"shield_hit_t":-10,"shield_rate":{"keep":true,"value":1},"shield_spiral":{"keep":true,"value":1},"shield_style":{"keep":true,"value":0},"tail_cost":{"keep":true,"value":0.25},"tail_inertia":{"keep":true,"value":0.5},"tail_len":0,"tail_max":{"keep":true,"value":4},"tail_seen":0,"tail_start":{"keep":true,"value":2},"tail_wave":{"keep":true,"value":0.12},"tail_wave_fade":{"keep":true,"value":2.5},"tail_wave_speed":{"keep":true,"value":6}}},{"id":"boss","rules":[{"do":[{"id":"pv_boss","on":true,"op":"object.show"},{"id":"pv_orbs","on":false,"op":"object.show"},{"id":"pv_crown","on":true,"op":"object.show"},{"id":"pv_core","on":false,"op":"object.show"},{"id":"pv_gem","on":false,"op":"object.show"},{"id":"pv_player","on":true,"op":"object.show"},{"actor":"boss","op":"actor.radius","value":1.6},{"id":"pv_crown","op":"object.move","s":[0.02,0.02,0.02],"time":0}],"id":"start","on":"state.enter:phase1"},{"do":[{"id":"pv_sq","on":true,"op":"object.show"},{"id":"pv_q0","on":false,"op":"object.show"},{"id":"pv_q1","on":false,"op":"object.show"},{"id":"pv_q2","on":false,"op":"object.show"},{"id":"pv_q3","on":false,"op":"object.show"},{"id":"pv_sq","op":"object.move","r":[0,0,0],"time":0,"to":[0,0,0]},{"op":"var.set","value":1,"var":"solo"}],"id":"start_solo","on":"state.enter:phase1"},{"do":[{"id":"pv_q0","op":"object.move","r":[0,0,0],"s":[2.2,2.2,2.2],"time":0,"to":[0,0,0]},{"id":"pv_q1","op":"object.move","r":[0,0,0],"s":[2.2,2.2,2.2],"time":0,"to":[0,0,0]},{"id":"pv_q2","op":"object.move","r":[0,0,0],"s":[2.2,2.2,2.2],"time":0,"to":[0,0,0]},{"id":"pv_q3","op":"object.move","r":[0,0,0]