","max(0, 1 - (time - shield_hit_t) * 1.6)","(hit_angle(player) - 90) * 0.0174533"],"when":"is(game, play) and hp(player) > 0 and shield(player) >= 1"},{"shape":"pv_shield_1","v":["x(player)","z(player)","max(0, 1 - (time - shield_hit_t) * 1.6)","(hit_angle(player) - 90) * 0.0174533"],"when":"is(game, play) and hp(player) > 0 and shield(player) >= 1 and shield_spiral == 0"},{"shape":"pv_shield_2","v":["x(player)","z(player)","max(0, 1 - (time - shield_hit_t) * 1.6)","(hit_angle(player) - 90) * 0.0174533"],"when":"is(game, play) and hp(player) > 0 and shield(player) >= 2 and shield_spiral == 0"},{"shape":"pv_shield_3","v":["x(player)","z(player)","max(0, 1 - (time - shield_hit_t) * 1.6)","(hit_angle(player) - 90) * 0.0174533"],"when":"is(game, play) and hp(player) > 0 and shield(player) >= 3 and shield_spiral == 0"},{"shape":"pv_shield_4","v":["x(player)","z(player)","max(0, 1 - (time - shield_hit_t) * 1.6)","(hit_angle(player) - 90) * 0.0174533"],"when":"is(game, play) and hp(player) > 0 and shield(player) >= 4 and shield_spiral == 0"},{"shape":"pv_shock_boss","v":["shock_x","shock_z","time - shock_t"],"when":"time - shock_t >= 0 and time - shock_t < 0.9"},{"shape":"pv_burst","v":["burst_x","burst_z","time - burst_t","burst_k"],"when":"time - burst_t >= 0 and time - burst_t < 2.7"},{"shape":"pv_emote_ha","v":["x(boss) * (1 - emote_hex) + x(hex) * emote_hex","z(boss) * (1 - emote_hex) + z(hex) * emote_hex"],"when":"is(game, play) and emote == 1 and time < emote_until"},{"shape":"pv_emote_dots","v":["x(boss) * (1 - emote_hex) + x(hex) * emote_hex","z(boss) * (1 - emote_hex) + z(hex) * emote_hex"],"when":"is(game, play) and emote == 2 and time < emote_until"},{"shape":"pv_emote_bang","v":["x(boss) * (1 - emote_hex) + x(hex) * emote_hex","z(boss) * (1 - emote_hex) + z(hex) * emote_hex"],"when":"is(game, play) and emote == 3 and time < emote_until"},{"shape":"pv_emote_what","v":["x(boss) * (1 - emote_hex) + x(hex) * emote_hex","z(boss) * (1 - emote_hex) + z(hex) * emote_