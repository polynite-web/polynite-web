"state.set","state":"win"}],"id":"won1","on":"msg:won_boss","when":"is(play) and mode == 1 and forms_left <= 0"},{"do":[{"ids":["boss_spiral","boss_ring","boss_aim","boss_laser","boss_wide","boss_spikes","orb_fire_0","orb_fire_1"],"op":"emitter.stop"},{"op":"var.add","value":"2000 + 200 * hp(player)","var":"score"}],"id":"won","on":"actor.dead:boss","when":"is(play) and mode == 3 and forms_left <= 0"},{"do":[{"op":"state.set","state":"win"}],"id":"won2","on":"msg:won_hex","when":"is(play) and forms_left <= 0 and mode != 3"},{"do":[{"op":"var.set","value":"max(best, score)","var":"best"},{"bus":"snd_music","gain":0.7,"id":"sad","op":"music.play"},{"op":"fx.slowmo","scale":0.5,"time":0.6},{"ids":["player_laser"],"op":"emitter.stop"},{"bus":"snd_over","gain":0.5,"name":"boom","op":"sound.play","pitch":0.6}],"id":"over","on":"state.enter:over"},{"do":[{"op":"var.add","value":"max(0, 8000 - floor(time) * 20) + hp(player) * 1000","var":"score"},{"op":"var.set","value":"time","var":"clear_time"},{"op":"var.set","value":"max(best, score)","var":"best"},{"op":"emitter.clear"}],"id":"win","on":"state.enter:win"},{"do":[{"msg":"atk_stop","op":"emit"},{"ids":["player_laser"],"op":"emitter.stop"},{"ids":["boss_spiral","boss_ring","boss_aim","boss_laser","boss_wide","boss_spikes","orb_fire_0","orb_fire_1"],"op":"emitter.stop"},{"ids":["hx_lattice","hx_curve","hx_burst","hx_laser","hx_wide"],"op":"emitter.stop"}],"id":"win_cam","on":"state.enter:win"},{"do":[{"msg":"atk_stop","op":"emit"},{"amount":0.22,"op":"fx.shake","time":0.7}],"id":"over_cam","on":"state.enter:over"},{"do":[{"id":"pv_orbs","on":false,"op":"object.show"},{"bus":"snd_music","gain":0.7,"id":"title","op":"music.play"},{"bus":"snd_win","gain":0.45,"name":"bell","op":"sound.play"}],"id":"win_fx","on":"state.enter:win"},{"do":[{"op":"var.set","value":1,"var":"retry"},{"op":"play.restart"}],"id":"again","on":"input.pressed:Again","when":"(is(over) or is(win)) and state_time > 1.0"},{"do":[{"op":"play.restart"},{"bus":"snd_menuopen","gain":2,"name":"appear","op":"sound.play"}],"id":"menu","on":"input.pressed:Menu","when":"is(over) or is(win)"}],"state":"title","states":["title","play","over","win"],"vars":{"ban_end":-10,"best":{"keep":true,"value":0},"card_end":-10,"clear_time":0,"hp_seen":3,"mode":{"keep":true,"value":3},"mult":1,"power":1,"retry":{"keep":true,"value":0},"score":0,"shards":0,"shock_t":-10,"shock_x":0,"shock_z":0,"tap_t":-10,"view_zoom":{"keep":true,"value":1}}},{"id":"mood","rules":[{"do":[{"actor":"boss","op":"actor.pose","pose":"smug","time":0.3}],"id":"sq_start1","on":"msg:sq_go","when":"phase == 1"},{"do":[{"actor":"boss","op":"actor.pose","pose":"angry","time":0.3}],"id":"sq_start2","on":"msg:sq_go","when":"phase >= 2"},{"do":[{"actor":"boss","op":"actor.pose","pose":"chat2","time":0.15},{"after":0.9,"id":"sq_calm","op":"timer.start"},{"bus":"snd_speech","gain":0.18,"name":"message","op":"sound.play","pitch":1.3}],"id":"sq_banter","on":"every:3.7","when":"is(game, play) and phase == 1 and is(atk_sq, fan)"},{"do":[{"actor":"boss","op":"actor.pose","pose":"smug","time":0.25}],"id":"sq_calm1","on":"timer:sq_calm","when":"phase == 1"},{"do":[{"actor":"boss","op":"actor.pose","pose":"angry","time":0.25}],"id":"sq_calm2","on":"timer:sq_calm","when":"phase >= 2"},{"do":[{"actor":"boss","at":"self","op":"actor.eyes"},{"actor":"boss","op":"actor.pose","pose":"chat1","time":0.15},{"id":"pv_quad","op":"object.move","time":0.18,"to":[0,0.45,0]},{"after":0.2,"id":"hop","op":"timer.start"},{"after":1.1,"id":"plan","op":"timer.start"},{"op":"var.set","value":2,"var":"emote"},{"op":"var.set","value":"time + 0.9","var":"emote_until"},{"op":"var.set","value":0,"var":"emote_hex"}],"id":"huddle","on":"msg:sq_huddle"},{"do":[{"id":"pv_quad","op":"object.move","time":0.2,"to":[0,0,0]},{"actor":"boss","op":"actor.pose","pose":"chat2","time":0.15},{"bus":"snd_speech","gain":0.3,"name":"message","op":"sound.play","pitch":0.8},{"bus":"snd_speech","gain":0.25,"name":"message","op":"sound.play","pitch":1.1}],"id":"hop","on":"timer:hop"},{"do":[{"actor":"boss","at":"player","op":"actor.eyes"},{"actor":"boss","op":"actor.pose","pose":"angry","time":0.12},{"bus":"snd_speech","gain":2,"name":"click","op":"sound.play","pitch":0.7},{"op":"var.set","value":3,"var":"emote"},{"op":"var.set","value":"time + 0.8","var":"emote_until"},{"op":"var.set","value":0,"var":"emote_hex"}],"id":"plan","on":"timer:plan"},{"do":[{"actor":"hex","op":"actor.pose","pose":"smug","time":0.3}],"id":"hx_start1","on":"msg:hx_go","when":"hphase <= 1"},{"do":[{"actor":"hex","op":"actor.pose","pose":"angry","time":0.3}],"id":"hx_start2","on":"msg:hx_go","when":"hphase >= 2"},{"do":[{"actor":"hex","gap":1.6,"op":"actor.pose","pose":"pain","time":0.05},{"after":0.35,"gap":1.6,"id":"hx_calm","op":"timer.start"}],"id":"hx_ouch","on":"actor.hit:hex","when":"is(game, play)"},{"do":[{"actor":"hex","op":"actor.pose","pose":"smug","time":0.25}],"id":"hx_calm1","on":"timer:hx_calm","when":"hphase <= 1"},{"do":[{"actor":"hex","op":"actor.pose","pose":"angry","time":0.25}],"id":"hx_calm2","on":"timer:hx_calm","when":"hphase >= 2"},{"do":[{"actor":"player","op":"actor.pose","pose":"pain","time":0.05},{"after":0.7,"id":"hero_ok","op":"timer.start"},{"actor":"boss","op":"actor.pose","pose":"smug","time":0.15},{"actor":"hex","op":"actor.pose","pose":"smug","time":0.15},{"op":"var.set","value":1,"var":"emote"},{"op":"var.set","value":"time + 1.2","var":"emote_until"},{"op":"var.set","value":"hp(hex) > 0","var":"emote_hex"}],"id":"hero_hurt","on":"actor.hit:player","when":"is(game, play) and hp(player) < hp_seen"},{"do":[{"actor":"player","gap":0.8,"op":"actor.pose","pose":"wow","time":0.05},{"after":0.45,"gap":0.8,"id":"hero_ok","op":"timer.start"}],"id":"hero_shielded","on":"actor.hit:player","when":"is(game, play) and hp(player) >= hp_seen and nova_open == 0"},{"do":[{"actor":"player","op":"actor.pose","pose":"focus","time":0.25}],"id":"hero_ok1","on":"timer:hero_ok","when":"hp(player) > 1 and not hero_mad and nova_open == 0"},{"do":[{"actor":"player","op":"actor.pose","pose":"angry","time":0.15},{"op":"var.set","value":0,"var":"hero_mad"},{"after":1.4,"id":"hero_ok","op":"timer.start"}],"id":"hero_mad1","on":"timer:hero_ok","when":"hp(player) > 1 and hero_mad and nova_open == 0"},{"do":[{"op":"var.set","value":1,"var":"hero_mad"}],"id":"hero_mad","on":"actor.hit:player","when":"is(game, play) and hp(player) < hp_seen"},{"do":[{"actor":"player","op":"actor.pose","pose":"proud","time":0.2},{"after":1.6,"id":"hero_ok","op":"timer.start"}],"id":"hero_proud","on":"msg:sq_go","when":"is(game, play) and phase >= 2 and nova_open == 0"},{"do":[{"actor":"player","op":"actor.pose","pose":"worried","time":0.25}],"id":"hero_ok2","on":"timer:hero_ok","when":"hp(player) <= 1 and nova_open == 0"},{"do":[{"actor":"player","gap":2,"op":"actor.pose","pose":"wow","time":0.06},{"after":0.5,"gap":2,"id":"hero_ok","op":"timer.start"}],"id":"hero_graze","on":"actor.graze:player","when":"is(game, play) and nova_open == 0"},{"do":[{"actor":"boss","gap":6,"op":"actor.pose","pose":"wow","time":0.1},{"actor":"hex","gap":6,"op":"actor.pose","pose":"wow","time":0.1},{"after":0.9,"gap":6,"id":"sq_calm","op":"timer.start"},{"after":0.9,"gap":6,"id":"hx_calm","op":"timer.start"},{"gap":6,"op":"var.set","value":4,"var":"emote"},{"gap":6,"op":"var.set","value":"time + 1","var":"emote_until"},{"gap":6,"op":"var.set","value":"hp(hex) > 0","var":"emote_hex"}],"id":"boss_wonder","on":"actor.graze:player","when":"is(game, play) and shield(player) >= 3"},{"do":[{"actor":"player","gap":1,"op":"actor.pose","pose":"happy","time":0.1},{"after":0.8,"gap":1,"id":"hero_ok","op":"timer.start"}],"id":"hero_joy","on":"emitter.hit:shards","when":"is(game, play) and nova_open == 0"},{"do":[{"actor":"boss","op":"actor.pose","pose":"pain","time":0.1},{"actor":"player","op":"actor.pose","pose":"happy","time":0.3},{"op":"var.set","value":5,"var":"emote"},{"op":"var.set","value":"time + 1.5","var":"emote_until"