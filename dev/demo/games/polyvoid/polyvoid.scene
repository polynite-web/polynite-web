acks":0,"grain":0.65,"metallic":0,"mottling":0.4,"parallax":0.4,"relief":1.6,"rotation":0,"roughness":0.95,"roughness_variation":0.35,"seed":0,"tile":11.1111,"variant":"organic","vein_strength":1,"vein_width":0.095,"warp":1,"wetness":0.12}},"message_styles":[],"metallic":0,"mirror_enable":1,"mist_density":0.1,"mist_on":0,"mist_start":8,"model_hidden":1,"motion_blur":0,"music_bpm":120,"music_cycle_0_0":{"fade":0.8,"gain":0.4,"note":72,"on":0,"period":4,"pulses":4,"rotation":0,"steps":8},"music_cycle_0_1":{"fade":0.8,"gain":0.4,"note":79,"on":0,"period":3,"pulses":3,"rotation":0,"steps":8},"music_cycle_1_0":{"fade":0.8,"gain":0.4,"note":45,"on":0,"period":4,"pulses":4,"rotation":0,"steps":8},"music_cycle_1_1":{"fade":0.8,"gain":0.4,"note":45,"on":0,"period":3,"pulses":3,"rotation":0,"steps":8},"music_cycle_2_0":{"fade":0.8,"gain":0.4,"note":72,"on":0,"period":4,"pulses":4,"rotation":0,"steps":8},"music_cycle_2_1":{"fade":0.8,"gain":0.4,"note":79,"on":0,"period":3,"pulses":3,"rotation":0,"steps":8},"music_cycle_3_0":{"fade":0.8,"gain":0.4,"note":72,"on":0,"period":4,"pulses":4,"rotation":0,"steps":8},"music_cycle_3_1":{"fade":0.8,"gain":0.4,"note":79,"on":0,"period":3,"pulses":3,"rotation":0,"steps":8},"music_gain":0.55,"music_grid0":0.5,"music_layout_seed":0,"music_level_0":0.55,"music_level_1":0.7,"music_level_2":0.5,"music_level_3":0.35,"music_on":0,"music_pos_0":[-2,1,-2],"music_pos_1":[0,0.5,-3],"music_pos_2":[2,1.8,-2],"music_pos_3":[0,2,-4],"music_reveal":6,"music_ring_intensity":1.35,"music_role_arp":1,"music_role_bass":1,"music_role_bell":1,"music_role_drums":1,"music_role_lead":1,"music_role_pad":1,"music_role_riser":1,"music_theme_level":1,"music_tm_0_gain":1,"music_tm_0_mute":0,"music_tm_0_solo":0,"music_tm_0_timbre":0,"music_tm_0_transpose":0,"music_tm_1_gain":1,"music_tm_1_mute":0,"music_tm_1_solo":0,"music_tm_1_timbre":1,"music_tm_1_transpose":0,"music_tm_2_gain":1,"music_tm_2_mute":0,"music_tm_2_solo":0,"music_tm_2_timbre":2,"music_tm_2_transpose":0,"music_tm_3_gain":1,"music_tm_3_mute":0,"music_tm_3_solo":0,"music_tm_3_timbre":3,"music_tm_3_transpose":0,"music_tm_4_gain":1,"music_tm_4_mute":0,"music_tm_4_solo":0,"music_tm_4_timbre":4,"music_tm_4_transpose":0,"music_tm_5_gain":1,"music_tm_5_mute":0,"music_tm_5_solo":0,"music_tm_5_timbre":5,"music_tm_5_transpose":0,"music_tm_6_gain":1,"music_tm_6_mute":0,"music_tm_6_solo":0,"music_tm_6_timbre":6,"music_tm_6_transpose":0,"music_tm_7_gain":1,"music_tm_7_mute":0,"music_tm_7_solo":0,"music_tm_7_timbre":7,"music_tm_7_transpose":0,"music_tm_8_gain":1,"music_tm_8_mute":0,"music_tm_8_solo":0,"music_tm_8_timbre":8,"music_tm_8_transpose":0,"music_visible_0":1,"music_visible_1":1,"music_visible_2":1,"music_visible_3":1,"music_wave_gain":0.22,"music_wave_intensity":1.45,"music_waves":1,"nature":{},"nod":{"game":{"color":"#4fe6ff","draw":[{"closed":true,"poly":[[0,-0.62],[0.56,0.38],[-0.56,0.38]]},{"circle":[0,0.04],"fill":true,"r":0.15},{"a0":-2.4,"a1":2,"arc":[0,0.04],"r":0.86},{"a0":2,"a1":3.6,"arc":[0,0.04],"r":1,"width":0.6}],"id":"polyvoid","page":0,"pages":["Shield","Soft tail","Nova","Sound","Dev","Look","Boss","Boss sounds","Game sounds"],"settings":[{"label":"Spiral shield (one line)","page":0,"text":"On: the tail is one line wound round the ship. Off: separate rings.","type":"checkbox","var":"shield_spiral"},{"items":[{"label":"Soft tail"},{"label":"Tail"},{"label":"Both ways"}],"label":"Spiral style","page":0,"text":"How the tail is drawn: a soft tail that trails and coils, a stiff tail, or a line grown both ways from the front.","type":"combo","var":"shield_style"},{"decimals":2,"label":"Fill speed","max":3,"min":0.25,"page":0,"text":"x1: 8 cubes a turn of shield, x2: 4, x0.5: 16. Spiral off: the rings.","type":"slider_float","unit":"x","var":"shield_rate"},{"items":[{"label":"Separate"},{"label":"Tail first"},{"label":"Tail heals"}],"label":"Life and tail","page":0,"text":"What a hit on the ship costs: a life, the tail first, or the tail heals the lives.","type":"combo","var":"life_mode"},{"decimals":1,"label":"Body hit vs tail hit","max":8,"min":1,"page":0,"text":"Separate: a hit on the ship costs a life. Tail first: the tail melts, then the lives; cubes heal first. Tail heals: hurt, the tail draws in and heals it - dim once it is gone. A hit on the ship costs the ratio x a stopped shot.","type":"slider_float","unit":"x","var":"body_ratio"},{"decimals":2,"label":"Inertia","max":1,"min":0,"page":1,"text":"How loosely the soft tail follows the ship: low firm, high floppy.","type":"slider_float","var":"tail_inertia"},{"decimals":2,"label":"Shrink per blocked shot","max":1,"min":0,"page":1,"text":"How much tail a shot it stops costs.","type":"slider_float","unit":" turn","var":"tail_cost"},{"decimals":2,"label":"Wave strength","max":0.4,"min":0,"page":1,"text":"How strong the shockwave running along the tail is when a shot hits it.","type":"slider_float","unit":" m","var":"tail_wave"},{"decimals":1,"label":"Wave speed","max":20,"min":1,"page":1,"text":"How fast that shockwave runs along the tail.","type":"slider_float","unit":" m/s","var":"tail_wave_speed"},{"decimals":1,"label":"Wave fade","max":8,"min":0.5,"page":1,"text":"It trails the ship, then coils round it, and stops shots: each costs that much and sends a shockwave along it.","type":"slider_float","var":"tail_wave_fade"},{"label":"Tail: most turns","max":8,"min":2,"page":0,"text":"The most turns of tail the ship can carry.","type":"slider_int","var":"tail_max"},{"decimals":1,"label":"Tail: at the start","max":8,"min":0,"page":0,"text":"The tail a game begins with (kept under its most turns).","type":"slider_float","unit":" turns","var":"tail_start"},{"decimals":0,"label":"Tail full: points a cube","max":600,"min":0,"page":0,"small":true,"text":"Full, its ring turns gold; every cube taken then is points (green cores: twice, times their size).","type":"slider_float","var":"full_bonus"},{"decimals":2,"label":"Beam power","max":3,"min":0.25,"page":2,"text":"The beam's damage, times this.","type":"slider_float","unit":"x","var":"nova_power"},{"decimals":1,"label":"Absorb speed","max":4,"min":0.5,"page":2,"text":"How fast the tail is drawn in while the beam charges (turns a second).","type":"slider_float","unit":" turn/s","var":"nova_rate"},{"label":"Aim the Supernova (it follows the pointer)","page":2,"text":"On: the Supernova follows the pointer. Off: it fires straight at the boss.","type":"checkbox","var":"nova_aim"},{"label":"Parry while charging","page":2,"text":"Hold: the tail is drawn in. Let go: a beam as strong as what you took. 2.5 turns or more: SUPERNOVA.","type":"checkbox","var":"nova_parry"},{"label":"Gun: starting level","max":5,"min":1,"page":2,"text":"The gun's level (darts at once) when a game starts.","type":"slider_int","var":"w_start"},{"decimals":2,"label":"Core: least charge for one","max":3,"min":0,"page":2,"text":"The least charge a beam needs to knock off green cores (below: blue cubes, tail only).","type":"slider_float","unit":" turns","var":"core_min"},{"decimals":2,"label":"Core: bigger with power","max":2,"min":0,"page":2,"text":"Bigger beams knock off bigger cores: their size and worth grow with the charge, times this.","type":"slider_float","unit":"x","var":"core_pow"},{"decimals":2,"label":"Supernova core: power (and size)","max":1.5,"min":0.1,"page":2,"small":true,"text":"A Supernova's cores: their power and size, times this. High: one core can pay for the next Supernova.","type":"slider_float","unit":"x","var":"super_core"},{"label":"Supernova: most cores","max":6,"min":1,"page":2,"small":true,"text":"The most cores a Supernova knocks off.","type":"slider_int","var":"super_cores"},{"decimals":1,"label":"Core: tail it gives","max":8,"min":0,"page":2,"text":"Tail a green core gives (cubes of tail, times its size).","type":"slider_float","unit":" cubes","var":"core_tail"},{"decimals":2,"label":"Gun: cores a level","max":3,"min":0.5,"page":2,"text":"Green cores needed for each gun level, times this.","type":"slider_float","unit":"x","var":"w_scale"},{"label":"Fine tuning: the cubes and the gun","page":2,"type":"section"},{"decimals":2,"label":"Floor cube: tail it gives","max":4,"min":0,"page":2,"small":true,"text":"Tail a cube picked up from the floor gives.","type":"slider_float","unit":" cubes","var":"shard_tail"},{"decimals":2,"label":"Blue cube: tail it gives","max":4,"min":0,"page":2,"small":true,"text":"Tail a blue cube (a weak beam's) gives.","type":"slider_float","unit":" cubes","var":"blue_tail"},{"decimals":2,"label":"Green core: gun it gives","max":4,"min":0,"page":2,"small":true,"text":"Gun progress a green core gives, times this.","type":"slider_float","unit":"x","var":"core_xp"},{"decimals":1,"label":"Gun: 2 darts at","max":40,"min":0.5,"page":2,"small":true,"text":"Green cores taken in all for 2 darts.","type":"slider_float","unit":" cores","var":"w_t2"},{"decimals":1,"label":"Gun: 3 darts at","max":40,"min":0.5,"page":2,"small":true,"text":"Green cores taken in all for 3 darts.","type":"slider_float","unit":" cores","var":"w_t3"},{"decimals":1,"label":"Gun: 4 darts at","max":40,"min":0.5,"page":2,"small":true,"text":"Green cores taken in all for 4 darts.","type":"slider_float","unit":" cores","var":"w_t4"},{"decimals":1,"label":"Gun: 5 darts at","max":40,"min":0.5,"page":2,"small":true,"text":"Green cores taken in all (x cores a level); keep each above the one before.","type":"slider_float","unit":" cores","var":"w_t5"},{"label":"Hit: gun levels lost (2: all)","max":2,"min":0,"page":2,"text":"Gun levels a hit costs: 0 none, 1 one, 2 all.","type":"slider_int","var":"w_loss"},{"label":"Gun line round the ship (turquoise, from the nose: the gun's level)","page":2,"text":"A turquoise line round the ship, from its nose: how far the gun is to its next level.","type":"checkbox","var":"gun_ring"},{"label":"Core look (0 cube, 1 gem, 2 diamond)","max":2,"min":0,"page":2,"text":"A beam on a boss knocks green cores off it: tail, and the gun grows - 1 dart, then 2, 3, 4, 5 (2, 5, 9, 14 cores). A hit costs levels.","type":"slider_int","var":"core_look"},{"decimals":2,"label":"Mouth open after a beam","max":1.5,"min":0,"page":2,"small":true,"text":"How long the ship keeps its mouth open once its beam is gone.","type":"slider_float","unit":" s","var":"mouth_hold"},{"decimals":2,"label":"Beam hit glow","max":3,"min":0,"page":2,"text":"The pieces the beam crosses light up, the bigger the beam the brighter; it breaks the shots it crosses and throws sparks.","type":"slider_float","unit":"x","var":"beam_glow"},{"page":3,"text":"Every sound its own volume (0: silent, 1: as made). The bosses' and the game's: the next pages.","type":"text_disabled"},{"decimals":2,"label":"Music","max":2,"min":0,"page":3,"small":true,"text":"Music: its volume. 0 silent, 1 as made, 2 louder.","type":"slider_float","var":"snd_music"},{"decimals":2,"label":"Hero's darts","max":4,"min":0,"page":3,"small":true,"text":"Hero's darts: its volume. 0 silent, 1 as made, 2 louder.","type":"slider_float","var":"sfx_hero"},{"items":[{"label":"Changing"},{"label":"Evolving"},{"label":"Nervous"},{"label":"Alert"}],"label":"The final form's song","page":3,"text":"Changing: it rises to Nervous, turns Evolving at two thirds of its life, Alert at a third - on the bar.","type":"combo","var":"final_pick"},{"items":[{"label":"Zap"},{"label":"Thoom"},{"label":"Surge"},{"label":"Shear"}],"label":"Beam sound (heard as you pick it)","page":3,"text":"The sound of the beam let go: pick one, it plays.","type":"combo","var":"laser_snd"},{"label":"Hero","page":3,"type":"section"},{"decimals":2,"label":"Dash","max":2,"min":0,"page":3,"small":true,"text":"Dash: its volume. 0 silent, 1 as made, 2 louder.","type":"slider_float","var":"snd_dash"},{"decimals":2,"label":"Close shave","max":2,"min":0,"page":3,"small":true,"text":"Close shave: its volume. 0 silent, 1 as made, 2 louder.","type":"slider_float","var":"snd_graze"},{"decimals":2,"label":"Hurt","max":2,"min":0,"page":3,"small":true,"text":"Hurt: its volume. 0 silent, 1 as made, 2 louder.","type":"slider_float","var":"snd_hurt"},{"decimals":2,"label":"Shield takes a hit","max":2,"min":0,"page":3,"small":true,"text":"Shield takes a hit: its volume. 0 silent, 1 as made, 2 louder.","type":"slider_float","var":"snd_shielded"},{"decimals":2,"label":"Tail takes a hit","max":2,"min":0,"page":3,"small":true,"text":"Tail takes a hit: its volume. 0 silent, 1 as made, 2 louder.","type":"slider_float","var":"snd_tailhit"},{"decimals":2,"label":"Tail mends a life","max":2,"min":0,"page":3,"small":true,"text":"Tail mends a life: its volume. 0 silent, 1 as made, 2 louder.","type":"slider_float","var":"snd_mend"},{"decimals":2,"label":"Life healed","max":2,"min":0,"page":3,"small":true,"text":"Life healed: its volume. 0 silent, 1 as made, 2 louder.","type":"slider_float","var":"snd_heal"},{"decimals":2,"label":"Gun level up","max":2,"min":0,"page":3,"small":true,"text":"Gun level up: its volume. 0 silent, 1 as made, 2 louder.","type":"slider_float","var":"snd_gunup"},{"decimals":2,"label":"Gun level lost","max":2,"min":0,"page":3,"small":true,"text":"Gun level lost: its volume. 0 silent, 1 as made, 2 louder.","type":"slider_float","var":"snd_gundown"},{"decimals":2,"label":"Wingmen arrive","max":2,"min":0,"page":3,"small":true,"text":"Wingmen arrive: its volume. 0 silent, 1 as made, 2 louder.","type":"slider_float","var":"snd_allyon"},{"decimals":2,"label":"Mice at your side","max":2,"min":0,"page":3,"small":true,"text":"Mice at your side: its volume. 0 silent, 1 as made, 2 louder.","type":"slider_float","var":"snd_mice"},{"decimals":2,"label":"Wingmen lost","max":2,"min":0,"page":3,"small":true,"text":"Wingmen lost: its volume. 0 silent, 1 as made, 2 louder.","type":"slider_float","var":"snd_allydown"},{"label":"Beam","page":3,"type":"section"},{"decimals":2,"label":"Beam: drawing in","max":2,"min":0,"page":3,"small":true,"text":"Beam: drawing in: its volume. 0 silent, 1 as made, 2 louder.","type":"slider_fl