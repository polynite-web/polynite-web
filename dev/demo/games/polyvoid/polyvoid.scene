lay","pitch":1.8}],"id":"shielded","on":"actor.hit:player","when":"is(game, play) and hp(player) >= hp_seen"},{"do":[{"bus":"snd_knocked","gain":0.06,"gap":0.12,"name":"chirp","op":"sound.play","pitch":2.3}],"id":"steal_sq","on":"emitter.volley:shards","when":"is(game, play) and hp(boss) > 0"},{"do":[{"bus":"snd_knocked","gain":0.06,"gap":0.12,"name":"chirp","op":"sound.play","pitch":2.3}],"id":"steal_hx","on":"emitter.volley:shards","when":"is(game, play) and hp(boss) <= 0 and hp(hex) > 0"},{"do":[{"bus":"snd_gather","gain":0.18,"name":"whoosh","op":"sound.play","pitch":1.5}],"id":"gather","on":"emitter.volley:boss_aim","when":"is(game, play)"},{"do":[{"bus":"snd_gather","gain":0.18,"name":"whoosh","op":"sound.play","pitch":1.3}],"id":"gather_hx","on":"emitter.volley:hx_curve","when":"is(game, play)"},{"do":[{"op":"var.set","value":"time","var":"shield_hit_t"}],"id":"ripple","on":"actor.hit:player","when":"is(game, play)"},{"do":[{"op":"var.add","value":"n","var":"heal"}],"id":"collect_heal","on":"emitter.hit:shards","when":"is(game, play) and hp(player) < hp_max(player) and life_mode != 2"},{"do":[{"actor":"player","op":"actor.hp","value":"hp(player) + 1"},{"op":"var.add","value":-4,"var":"heal"},{"op":"var.set","value":"hp(player)","var":"hp_seen"},{"op":"var.set","value":"heal * (hp(player) < hp_max(player))","var":"heal"},{"object":"pv_player","op":"fx.pulse","scale":1.5,"time":0.4},{"amount":2.5,"object":"pv_player","op":"fx.glow","time":0.5},{"bus":"snd_heal","gain":0.55,"name":"bell","op":"sound.play","pitch":1.5},{"bus":"snd_heal","gain":0.35,"name":"chirp","op":"sound.play","pitch":1.1}],"id":"heal_up","on":"emitter.hit:shards","when":"is(game, play) and hp(player) < hp_max(player) and heal >= 4 and life_mode != 2"},{"do":[{"op":"var.add","value":"n * shard_tail * (hp(player) >= hp_max(player) or life_mode == 2)","var":"shards"},{"op":"var.add","value":"50 * n","var":"score"},{"amount":1.2,"object":"pv_player","op":"fx.glow","time":0.15},{"bus":"snd_taken","gain":0.16,"gap":0.05,"name":"message","op":"sound.play","pitch":"0.9 + shards * 0.06"}],"id":"collect","on":"emitter.hit:shards","when":"is(game, play)"},{"do":[{"op":"var.add","value":"0 - (8 / shield_rate)","var":"shards"},{"actor":"player","op":"actor.shield","value":"shield(player) + 1"},{"object":"pv_player","op":"fx.pulse","scale":1.4,"time":0.3},{"bus":"snd_turn","gain":0.6,"name":"bell","op":"sound.play","pitch":1}],"id":"collect_up","on":"emitter.hit:shards","when":"is(game, play) and shards >= (8 / shield_rate) and shield(player) < tail_max"},{"do":[{"op":"var.set","value":"max(0, shield(player) * (8 / shield_rate) + shards + (8 / shield_rate) - body_ratio * tail_cost * (8 / shield_rate))","var":"tail_len"},{"actor":"player","op":"actor.shield","value":"floor(tail_len / (8 / shield_rate))"},{"op":"var.set","value":"tail_len - floor(tail_len / (8 / shield_rate)) * (8 / shield_rate)","var":"shards"}],"id":"body_cost","on":"actor.hit:player","when":"is(game, play) and life_mode >= 1 and hp(player) >= hp_seen"},{"do":[{"op":"var.set","value":"max(0, shield(player) * (8 / shield_rate) + shards - body_ratio * tail_cost * (8 / shield_rate))","var":"tail_len"},{"actor":"player","op":"actor.shield","value":"floor(tail_len / (8 / shield_rate))"},{"op":"var.set","value":"tail_len - floor(tail_len / (8 / shield_rate)) * (8 / shield_rate)","var":"shards"},{"actor":"player","op":"actor.hp","value":"hp(player) + 1"},{"op":"var.set","value":"hp(player)","var":"hp_seen"},{"amount":2.2,"object":"pv_player","op":"fx.glow","time":0.4},{"bus":"snd_mend","gain":0.35,"name":"chirp","op":"sound.play","pitch":1.2}],"id":"mend","on":"every:0.05","when":"is(game, play) and life_mode == 2 and hp(player) > 0 and hp(player) < hp_max(player) and shield(player) * (8 / shield_rate) + shards >= body_ratio * tail_cost * (8 / shield_rate)"},{"do":[{"op":"var.set","value":"max(0, shield(player) * (8 / shield_rate) + shards - body_ratio * tail_cost * (8 / shield_rate))","var":"tail_len"},{"