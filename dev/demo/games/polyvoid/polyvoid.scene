       "do": [
        {
         "op": "var.set",
         "value": 1,
         "var": "hero_mad"
        }
       ],
       "id": "hero_mad",
       "on": "actor.hit:player",
       "when": "is(game, play) and hp(player) < hp_seen"
      },
      {
       "do": [
        {
         "actor": "player",
         "op": "actor.pose",
         "pose": "proud",
         "time": 0.2
        },
        {
         "after": 1.6,
         "id": "hero_ok",
         "op": "timer.start"
        }
       ],
       "id": "hero_proud",
       "on": "msg:sq_go",
       "when": "is(game, play) and phase >= 2 and nova_open == 0"
      },
      {
       "do": [
        {
         "actor": "player",
         "op": "actor.pose",
         "pose": "worried",
         "time": 0.25
        }
       ],
       "id": "hero_ok2",
       "on": "timer:hero_ok",
       "when": "hp(player) <= 1 and nova_open == 0"
      },
      {
       "do": [
        {
         "actor": "player",
         "gap": 2,
         "op": "actor.pose",
         "pose": "wow",
         "time": 0.06
        },
        {
         "after": 0.5,
         "gap": 2,
         "id": "hero_ok",
         "op": "timer.start"
        }
       ],
       "id": "hero_graze",
       "on": "actor.graze:player",
       "when": "is(game, play) and nova_open == 0"
      },
      {
       "do": [
        {
         "actor": "boss",
         "gap": 6,
         "op": "actor.pose",
         "pose": "wow",
         "time": 0.1
        },
        {
         "actor": "hex",
         "gap": 6,
         "op": "actor.pose",
         "pose": "wow",
         "time": 0.1
        },
        {
         "after": 0.9,
         "gap": 6,
         "id": "sq_calm",
         "op": "timer.start"
        },
        {
         "after": 0.9,
         "gap": 6,
         "id": "hx_calm",
         "op": "timer.start"
        },
        {
         "gap": 6,
         "op": "var.set",
         "value": 4,
         "var": "emote"
        },
        {
         "gap": 6,
         "op": "var.set",
         "value": "time + 1",
         "var": "emote_until"
        },
        {
         "gap": 6,
         "op": "var.set",
         "value": "hp(hex) > 0",
         "var": "emote_hex"
        }
       ],
       "id": "boss_wonder",
       "on": "actor.graze:player",
       "when": "is(game, play) and mult >= 3"
      },
      {
       "do": [
        {
         "actor": "player",
         "gap": 1,
         "op": "actor.pose",
         "pose": "happy",
         "time": 0.1
        },
        {
         "after": 0.8,
         "gap": 1,
         "id": "hero_ok",
         "op": "timer.start"
        }
       ],
       "id": "hero_joy",
       "on": "emitter.hit:shards",
       "when": "is(game, play) and nova_open == 0"
      },
      {
       "do": [
        {
         "actor": "boss",
         "op": "actor.pose",
         "pose": "pain",
         "time": 0.1
        },
        {
         "actor": "player",
         "op": "actor.pose",
         "pose": "happy",
         "time": 0.3
        },
        {
         "op": "var.set",
         "value": 5,
         "var": "emote"
        },
        {
         "op": "var.set",
         "value": "time + 1.5",
         "var": "emote_until"
        },
        {
         "op": "var.set",
         "value": 0,
         "var": "emote_hex"
        }
       ],
       "id": "sq_down",
       "on": "actor.dead:boss"
      },
      {
       "do": [
        {
         "actor": "hex",
         "op": "actor.pose",
         "pose": "pain",
         "time": 0.1
        },
        {
         "actor": "player",
         "op": "actor.pose",
         "pose": "happy",
         "time": 0.3
        },
        {
         "op": "var.set",
         "value": 5,
         "var": "emote"
        },
        {
         "op": "var.set",
         "value": "time + 1.5",
         "var": "emote_until"
        },
        {
         "op": "var.set",
         "value": 1,
         "var": "emote_hex"
        }
       ],
       "id": "hx_down",
       "on": "actor.dead:hex"
      }
     ],
     "vars": {
      "emote": 0,
      "emote_hex": 0,
      "emote_until": 0,
      "hero_mad": 0
     }
    },
    {
     "id": "shield",
     "rules": [
      {
       "do": [
        {
         "id": "pv_q0_pup_l",
         "on": false,
         "op": "object.show"
        },
        {
         "id": "pv_q0_pup_r",
         "on": false,
         "op": "object.show"
        },
        {
         "id": "pv_q2_pup_l",
         "on": false,
         "op": "object.show"
        },
        {
         "id": "pv_q2_pup_r",
         "on": false,
         "op": "object.show"
        },
        {
         "after": 0.12,
         "id": "unblink",
         "op": "timer.start"
        }
       ],
       "id": "blink",
       "on": "every:3.3",
       "when": "is(game, play) or is(game, title)"
      },
      {
       "do": [
        {
         "actor": "player",
         "op": "actor.pose",
         "pose": "blink",
         "time": 0.05
        }
       ],
       "id": "blink_hero",
       "on": "every:3.3",
       "when": "(is(game, play) or is(game, title)) and nova_open == 0"
      },
      {
       "do": [
        {
         "id": "pv_q0_pup_l",
         "on": true,
         "op": "object.show"
        },
        {
         "id": "pv_q0_pup_r",
         "on": true,
         "op": "object.show"
        },
        {
         "id": "pv_q2_pup_l",
         "on": true,
         "op": "object.show"
        },
        {
         "id": "pv_q2_pup_r",
         "on": true,
         "op": "object.show"
        }
       ],
       "id": "unblink",
       "on": "timer:unblink"
      },
      {
       "do": [
        {
         "actor": "player",
         "op": "actor.pose",
         "pose": "focus",
         "time": 0.07
        }
       ],
       "id": "unblink_hero",
       "on": "timer:unblink",
       "when": "nova_open == 0 and hp(player) > 1"
      },
      {
       "do": [
        {
         "actor": "player",
         "op": "actor.pose",
         "pose": "worried",
         "time": 0.07
        }
       ],
       "id": "unblink_low",
       "on": "timer:unblink",
       "when": "hp(player) <= 1 and nova_open == 0"
      },
      {
       "do": [
        {
         "amount": 2.5,
         "gap": 0.3,
         "object": "pv_player",
         "op": "fx.glow",
         "time": 0.25
        },
        {
         "amount": 0.25,
         "gap": 0.3,
         "op": "fx.shake",
         "time": 0.15
        },
        {
         "gap": 0.3,
         "id": "pv_shock",
         "op": "shape.play",
         "time": 0.5
        },
        {
         "gain": 0.4,
         "gap": 0.3,
         "name": "chirp",
         "op": "sound.play",
         "pitch": 0.7
        }
       ],
       "id": "shielded",
       "on": "actor.hit:player",
       "when": "is(game, play) and hp(player) >= hp_seen"
      },
      {
       "do": [
        {
         "amount": 4,
         "object": "pv_boss",
         "op": "fx.glow",
         "time": 0.14
        },
        {
         "gain": 0.25,
         "name": "chirp",
         "op": "sound.play",
         "pitch": 1.6
        }
       ],
       "id": "steal_sq",
       "on": "emitter.volley:shards",
       "when": "is(game, play) and hp(boss) > 0"
      },
      {
       "do": [
        {
         "amount": 4,
         "object": "hx_boss",
         "op": "fx.glow",
         "time": 0.14
        },
        {
         "gain": 0.25,
         "name": "chirp",
         "op": "sound.play",
         "pitch": 1.6
        }
       ],
       "id": "steal_hx",
       "on": "emitter.volley:shards",
       "when": "is(game, play) and hp(boss) <= 0 and hp(hex) > 0"
      },
      {
       "do": [
        {
         "gain": 0.22,
         "name": "magic",
         "op": "sound.play",
         "pitch": 1.5
        }
       ],
       "id": "gather",
       "on": "emitter.volley:boss_aim",
       "when": "is(game, play)"
      },
      {
       "do": [
        {
         "gain": 0.22,
         "name": "magic",
         "op": "sound.play",
         "pitch": 1.3
        }
       ],
       "id": "gather_hx",
       "on": "emitter.volley:hx_curve",
       "when": "is(game, play)"
      },
      {
       "do": [
        {
         "op": "var.set",
         "value": "time",
         "var": "shield_hit_t"
        }
       ],
       "id": "ripple",
       "on": "actor.hit:player",
       "when": "is(game, play)"
      },
      {
       "do": [
        {
         "op": "var.add",
         "value": "n",
         "var": "shards"
        },
        {
         "op": "var.add",
         "value": "50 * n",
         "var": "score"
        },
        {
         "amount": 1.2,
         "object": "pv_player",
         "op": "fx.glow",
         "time": 0.15
        },
        {
         "gain": 0.35,
         "gap": 0.05,
         "name": "message",
         "op": "sound.play",
         "pitch": "0.9 + shards * 0.06"
        }
       ],
       "id": "collect",
       "on": "emitter.hit:shards",
       "when": "is(game, play)"
      },
      {
       "do": [
        {
         "op": "var.add",
         "value": "0 - (8 / shield_rate)",
         "var": "shards"
        },
        {
         "actor": "player",
         "op": "actor.shield",
         "value": "shield(player) + 1"
        },
        {
         "object": "pv_player",
         "op": "fx.pulse",
         "scale": 1.4,
         "time": 0.3
        },
        {
         "gain": 0.6,
         "name": "bell",
         "op": "sound.play",
         "pitch": 1
        }
       ],
       "id": "collect_up",
       "on": "emitter.hit:shards",
       "when": "is(game, play) and shards >= (8 / shield_rate)"
      },
      {
       "do": [
        {
         "op": "var.set",
         "value": "hp(player)",
         "var": "hp_seen"
        }
       ],
       "id": "hp_track",
       "on": "actor.hit:player"
      },
      {
       "do": [
        {
         "actor": "player",
         "op": "actor.radius",
         "value": "0.55 + min(1, shield(player)) * (0.4 + 0.28 * min(4, shield(player)))"
        }
       ],
       "id": "reach_rings",
       "on": "every:0.1",
       "when": "is(game, play) and shield_spiral == 0"
      },
      {
       "do": [
        {
         "actor": "player",
         "op": "actor.radius",
         "value": "0.55 + min(1, shield(player)) * (1.24 + 0.14 * min(4, shield(player) + shards / (8 / shield_rate)))"
        }
       ],
       "id": "reach_both",
       "on": "every:0.1",
       "when": "is(game, play) and shield_spiral == 1 and shield_style == 2"
      },
      {
       "do": [
        {
         "actor": "player",
         "op": "actor.radius",
         "value": "0.55 + min(1, shield(player)) * (0.95 + 0.18 * min(4, shield(player) + shards / (8 / shield_rate)) - 0.55)"
        }
       ],
       "id": "reach_tail",
       "on": "every:0.1",
       "when": "is(game, play) and shield_spiral == 1 and shield_style == 1"
      },
      {
       "do": [
        {
         "actor": "player",
         "op": "actor.radius",
         "value": 0.55
        }
       ],
       "id": "reach_soft",
       "on": "every:0.1",
       "when": "is(game, play) and shield_spiral == 1 and shield_style == 0"
      },
      {
       "do": [
        {
         "op": "var.set",
         "value": "max(0, shield(player) * (8 / shield_rate) + shards - n * tail_cost * (8 / shield_rate))",
         "var": "tail_len"
        },
        {
         "actor": "player",
         "op": "actor.shield",
         "value": "floor(tail_len / (8 / shield_rate))"
        },
        {
         "op": "var.set",
         "value": "tail_len - floor(tail_len / (8 / shield_rate)) * (8 / shield_rate)",
         "var": "shards"
        },
        {
         "amount": 1.6,
         "gap": 0.2,
         "object": "pv_player",
         "op": "fx.glow",
         "time": 0.15
        },
        {
         "gain": 0.3,
         "gap": 0.15,
         "name": "chirp",
         "op": "sound.play",
         "pitch": 1.3
        }
       ],
       "id": "tail_hit",
       "on": "msg:tail_hit",
       "when": "is(game, play) and not (nova_hold == 1 and nova_parry == 1)"
      }
     ],
     "vars": {
      "shield_hit_t": -10,
      "shield_rate": {
       "keep": true,
       "value": 1
      },
      "shield_spiral": {
       "keep": true,
       "value": 1
      },
      "shield_style": {
       "keep": true,
       "value": 0
      },
      "tail_cost": {
       "keep": true,
       "value": 0.25
      },
      "tail_inertia": {
       "keep": true,
       "value": 0.5
      },
      "tail_len": 0,
      "tail_wave": {
       "keep": true,
       "value": 0.12
      },
      "tail_wave_fade": {
       "keep": true,
       "value": 2.5
      },
      "tail_wave_speed": {
       "keep": true,
       "value": 6
      }
     }
    },
    {
     "id": "boss",
