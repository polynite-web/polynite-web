tap_t":-10,"view_zoom":{"keep":true,"value":1}}},{"id":"mood","rules":[{"do":[{"actor":"boss","op":"actor.pose","pose":"smug","time":0.3}],"id":"sq_start1","on":"msg:sq_go","when":"phase == 1"},{"do":[{"actor":"boss","op":"actor.pose","pose":"angry","time":0.3}],"id":"sq_start2","on":"msg:sq_go","when":"phase >= 2"},{"do":[{"actor":"boss","op":"actor.pose","pose":"chat2","time":0.15},{"after":0.9,"id":"sq_calm","op":"timer.start"},{"bus":"snd_speech","gain":0.18,"name":"message","op":"sound.play","pitch":1.3}],"id":"sq_banter","on":"every:3.7","when":"is(game, play) and phase == 1 and is(atk_sq, fan)"},{"do":[{"actor":"boss","op":"actor.pose","pose":"smug","time":0.25}],"id":"sq_calm1","on":"timer:sq_calm","when":"phase == 1"},{"do":[{"actor":"boss","op":"actor.pose","pose":"angry","time":0.25}],"id":"sq_calm2","on":"timer:sq_calm","when":"phase >= 2"},{"do":[{"actor":"boss","at":"self","op":"actor.eyes"},{"actor":"boss","op":"actor.pose","pose":"chat1","time":0.15},{"id":"pv_quad","op":"object.move","time":0.18,"to":[0,0.45,0]},{"after":0.2,"id":"hop","op":"timer.start"},{"after":1.1,"id":"plan","op":"timer.start"},{"op":"var.set","value":2,"var":"emote"},{"op":"var.set","value":"time + 0.9","var":"emote_until"},{"op":"var.set","value":0,"var":"emote_hex"}],"id":"huddle","on":"msg:sq_huddle"},{"do":[{"id":"pv_quad","op":"object.move","time":0.2,"to":[0,0,0]},{"actor":"boss","op":"actor.pose","pose":"chat2","time":0.15},{"bus":"snd_speech","gain":0.3,"name":"message","op":"sound.play","pitch":0.8},{"bus":"snd_speech","gain":0.25,"name":"message","op":"sound.play","pitch":1.1}],"id":"hop","on":"timer:hop"},{"do":[{"actor":"boss","at":"player","op":"actor.eyes"},{"actor":"boss","op":"actor.pose","pose":"angry","time":0.12},{"bus":"snd_speech","gain":2,"name":"click","op":"sound.play","pitch":0.7},{"op":"var.set","value":3,"var":"emote"},{"op":"var.set","value":"time + 0.8","var":"emote_until"},{"op":"var.set","value":0,"var":"emote_hex"}],"id":"plan","on":"timer:plan"},{"do":[{"actor":"hex","op":"actor.pose","pose":"smug","time":0.3}],"id":"hx_start1","on":"msg:hx_go","when":"hphase <= 1"},{"do":[{"actor":"hex","op":"actor.pose","pose":"angry","time":0.3}],"id":"hx_start2","on":"msg:hx_go","when":"hphase >= 2"},{"do":[{"actor":"hex","gap":1.6,"op":"actor.pose","pose":"pain","time":0.05},{"after":0.35,"gap":1.6,"id":"hx_calm","op":"timer.start"}],"id":"hx_ouch","on":"actor.hit:hex","when":"is(game, play)"},{"do":[{"actor":"hex","op":"actor.pose","pose":"smug","time":0.25}],"id":"hx_calm1","on":"timer:hx_calm","when":"hphase <= 1"},{"do":[{"actor":"hex","op":"actor.pose","pose":"angry","time":0.25}],"id":"hx_calm2","on":"timer:hx_calm","when":"hphase >= 2"},{"do":[{"actor":"player","op":"actor.pose","pose":"pain","time":0.05},{"after":0.7,"id":"hero_ok","op":"timer.start"},{"actor":"boss","op":"actor.pose","pose":"smug","time":0.15},{"actor":"hex","op":"actor.pose","pose":"smug","time":0.15},{"op":"var.set","value":1,"var":"emote"},{"op":"var.set","value":"time + 1.2","var":"emote_until"},{"op":"var.set","value":"hp(hex) > 0","var":"emote_hex"}],"id":"hero_hurt","on":"actor.hit:player","when":"is(game, play) and hp(player) < hp_seen"},{"do":[{"actor":"player","gap":0.8,"op":"actor.pose","pose":"wow","time":0.05},{"after":0.45,"gap":0.8,"id":"hero_ok","op":"timer.start"}],"id":"hero_shielded","on":"actor.hit:player","when":"is(game, play) and hp(player) >= hp_seen and nova_open == 0"},{"do":[{"actor":"player","op":"actor.pose","pose":"focus","time":0.25}],"id":"hero_ok1","on":"timer:hero_ok","when":"hp(player) > 1 and not hero_mad and nova_open == 0"},{"do":[{"actor":"player","op":"actor.pose","pose":"angry","time":0.15},{"op":"var.set","value":0,"var":"hero_mad"},{"after":1.4,"id":"hero_ok","op":"timer.start"}],"id":"hero_mad1","on":"timer:hero_ok","when":"hp(player) > 1 and hero_mad and nova_open == 0"},{"do":[{"op":"var.set","value":1,"var":"hero_mad"}],"id":"hero_mad","on":"actor.hit:player","when":"is(game, play) and hp(player) < hp_seen"},{"do":[{"actor":"player","op":"actor.pose","pose":"proud","time":0.2},{"after":1.6,"id":"hero_ok","op":"timer.start"}],"id":"hero_proud","on":"msg:sq_go","when":"is(game, play) and phase >= 2 and nova_open == 0"},{"do":[{"actor":"player","op":"actor.pose","pose":"worried","time":0.25}],"id":"hero_ok2","on":"timer:hero_ok","when":"hp(player) <= 1 and nova_open == 0"},{"do":[{"actor":"player","gap":2,"op":"actor.pose","pose":"wow","time":0.06},{"after":0.5,"gap":2,"id":"hero_ok","op":"timer.start"}],"id":"hero_graze","on":"actor.graze:player","when":"is(game, play) and nova_open == 0"},{"do":[{"actor":"boss","gap":6,"op":"actor.pose","pose":"wow","time":0.1},{"actor":"hex","gap":6,"op":"actor.pose","pose":"wow","time":0.1},{"after":0.9,"gap":6,"id":"sq_calm","op":"timer.start"},{"after":0.9,"gap":6,"id":"hx_calm","op":"timer.start"},{"gap":6,"op":"var.set","value":4,"var":"emote"},{"gap":6,"op":"var.set","value":"time + 1","var":"emote_until"},{"gap":6,"op":"var.set","value":"hp(hex) > 0","var":"emote_hex"}],"id":"boss_wonder","on":"actor.graze:player","when":"is(game, play) and shield(player) >= 3"},{"do":[{"actor":"player","gap":1,"op":"actor.pose","pose":"happy","time":0.1},{"after":0.8,"gap":1,"id":"hero_ok","op":"timer.start"}],"id":"hero_joy","on":"emitter.hit:shards","when":"is(game, play) and nova_open == 0"},{"do":[{"actor":"boss","op":"actor.pose","pose":"pain","time":0.1},{"actor":"player","op":"actor.pose","pose":"happy","time":0.3},{"op":"var.set","value":5,"var":"emote"},{"op":"var.set","value":"time + 1.5","var":"emote_until"},{"op":"var.set","value":0,"var":"emote_hex"}],"id":"sq_down","on":"actor.dead:boss","when":"forms_left <= 0"},{"do":[{"actor":"hex","op":"actor.pose","pose":"pain","time":0.1},{"actor":"player","op":"actor.pose","pose":"happy","time":0.3},{"op":"var.set","value":5,"var":"emote"},{"op":"var.set","value":"time + 1.5","var":"emote_until"},{"op":"var.set","value":1,"var":"emote_hex"}],"id":"hx_down","on":"actor.dead:hex","when":"forms_left <= 0"}],"vars":{"emote":0,"emote_hex":0,"emote_until":0,"hero_mad":0}},{"id":"shield","rules":[{"do":[{"id":"pv_q0_pup_l","on":false,"op":"object.show"},{"id":"pv_q0_pup_r","on":false,"op":"object.show"},{"id":"pv_q2_pup_l","on":false,"op":"object.show"},{"id":"pv_q2_pup_r","on":false,"op":"object.show"},{"after":0.12,"id":"unblink","op":"timer.start"}],"id":"blink","on":"every:3.3","when":"is(game, play) or is(game, title)"},{"do":[{"actor":"player","op":"actor.pose","pose":"blink","time":0.05}],"id":"blink_hero","on":"every:3.3","when":"(is(game, play) or is(game, title)) and nova_open == 0"},{"do":[{"id":"pv_q0_pup_l","on":true,"op":"object.show"},{"id":"pv_q0_pup_r","on":true,"op":"object.show"},{"id":"pv_q2_pup_l","on":true,"op":"object.show"},{"id":"pv_q2_pup_r","on":true,"op":"object.show"}],"id":"unblink","on":"timer:unblink","when":"eyesq_s0 == 0 and eyesq_s2 == 0"},{"do":[{"actor":"player","op":"actor.pose","pose":"focus","time":0.07}],"id":"unblink_hero","on":"timer:unblink","when":"nova_open == 0 and hp(player) > 1"},{"do":[{"actor":"player","op":"actor.pose","pose":"worried","time":0.07}],"id":"unblink_low","on":"timer:unblink","when":"hp(player) <= 1 and nova_open == 0"},{"do":[{"amount":2.5,"gap":0.3,"object":"pv_player","op":"fx.glow","time":0.25},{"amount":0.25,"gap":0.3,"op":"fx.shake","time":0.15},{"gap":0.3,"id":"pv_shock","op":"shape.play","time":0.5},{"bus":"snd_shielded","gain":0.55,"gap":0.3,"name":"thump","op":"sound.play","pitch":0.8},{"bus":"snd_shielded","gain":0.18,"gap":0.3,"name":"whoosh","op":"sound.play","pitch":1.8}],"id":"shielded","on":"actor.hit:player","when":"is(game, play) and hp(player) >= hp_seen"},{"do":[{"bus":"snd_knocked","gain":0.06,"gap":0.12,"name":"chirp","op":"sound.play","pitch":2.3}],"id":"steal_sq","on":"emitter.volley:shards","when":"is(game, play) and hp(boss) > 0"},{"do":[{"bus":"snd_knocked","gain":0.06,"gap":0.12,"name":"chirp","op":"sound.play","pitch":2.3}],"id":"steal_hx","on":"emitter.volley:shards","when":"is(game, play) and hp(boss) <= 0 and hp(hex) > 0"},{"do":[{"bus":"snd_gather","gain":0.18,"name":"whoosh","op":"sound.play","pitch":1.5}],"id":"gather","on":"emitter.volley:boss_aim","when":"is(game, play)"},{"do":[{"bus":"snd_gather","gain":0.18,"name":"whoosh","op":"sound.play","pitch":1.3}],"id":"gather_hx","on":"emitter.volley:hx_curve","when":"is(game, play)"},{"do":[{"op":"var.set","value":"time","var":"shield_hit_t"}],"id":"ripple","on":"actor.hit:player","when":"is(game, play)"},{"do":[{"op":"var.add","value":"n","var":"heal"}],"id":"collect_heal","on":"emitter.hit:shards","when":"is(game, play) and hp(player) < hp_max(player) and life_mode != 2"},{"do":[{"actor":"player","op":"actor.hp","value":"hp(player) + 1"},{"op":"var.add","value":-4,"var":"heal"},{"op":"var.set","value":"hp(player)","var":"hp_seen"},{"op":"var.set","value":"heal * (hp(player) < hp_max(player))","var":"heal"},{"object":"pv_player","op":"fx.pulse","scale":1.5,"time":0.4},{"amount":2.5,"object":"pv_player","op":"fx.glow","time":0.5},{"bus":"snd_heal","gain":0.55,"name":"bell","op":"sound.play","pitch":1.5},{"bus":"snd_heal","gain":0.35,"name":"chirp","op":"sound.play","pitch":1.1}],"id":"heal_up","on":"emitter.hit:shards","when":"is(game, play) and hp(player) < hp_max(player) and heal >= 4 and life_mode != 2"},{"do":[{"op":"var.add","value":"n * shard_tail * (hp(player) >= hp_max(player) or life_mode == 2)","var":"shards"},{"op":"var.add","value":"50 * n","var":"score"},{"amount":1.2,"object":"pv_player","op":"fx.glow","time":0.15},{"bus":"snd_taken","gain":0.16,"gap":0.05,"name":"message","op":"sound.play","pitch":"0.9 + shards * 0.06"}],"id":"collect","on":"emitter.hit:shards","when":"is(game, play)"},{"do":[{"op":"var.add","value":"0 - (8 / shield_rate)","var":"shards"},{"actor":"player","op":"actor.shield","value":"shield(player) + 1"},{"object":"pv_player","op":"fx.pulse","scale":1.4,"time":0.3},{"bus":"snd_turn","gain":0.6,"name":"bell","op":"sound.play","pitch":1}],"id":"collect_up","on":"emitter.hit:shards","when":"is(game, play) and shards >= (8 / shield_rate) and shield(player) < tail_max"},{"do":[{"op":"var.set","value":"max(0, shield(player) * (8 / shield_rate) + shards + (8 / shield_rate) - body_ratio * tail_cost * (8 / shield_rate))","var":"tail_len"},{"actor":"player","op":"actor.shield","value":"floor(tail_len / (8 / shield_rate))"},{"op":"var.set","value":"tail_len - floor(tail_len / (8 / shield_rate)) * (8 / shield_rate)","var":"shards"}],"id":"body_cost","on":"actor.hit:player","when":"is(game, play) and life_mode >= 1 and hp(player) >= hp_seen"},{"do":[{"op":"var.set","value":"max(0, shield(player) * (8 / shield_rate) + shards - body_ratio * tail_cost * (8 / shield_rate))","var":"tail_len"},{"actor":"player","op":"actor.shield","value":"floor(tail_len / (8 / shield_rate))"},{"op":"var.set","value":"tail_len - floor(tail_len / (8 / shield_rate)) * (8 / shield_rate)","var":"shards"},{"actor":"player","op":"actor.hp","value":"hp(player) + 1"},{"op":"var.set","value":"hp(player)","var":"hp_seen"},{"amount":2.2,"object":"pv_player","op":"fx.glow","time":0.4},{"bus":"snd_mend","gain":0.35,"name":"chirp","op":"sound.play","pitch":1.2}],"id":"mend","on":"every:0.05","when":"is(game, play) and life_mode == 2 and hp(player) > 0 and hp(player) < hp_max(player) and shield(player) * (8 / shield_rate) + shards >= body_ratio * tail_cost * (8 / shield_rate)"},{"do":[{"op":"var.set","value":"max(0, shield(player) * (8 / shield_rate) + shards - body_ratio * tail_cost * (8 / shield_rate))","var":"tail_len"},{"actor":"player","op":"actor.shield","value":"floor(tail_len / (8 / shield_rate))"},{"op":"var.set","value":"tail_len - floor(tail_len / (8 / shield_rate)) * (8 / shield_rate)","var":"shards"},{"actor":"player","op":"actor.hp","value":1},{"op":"var.set","value":1,"var":"hp_seen"},{"amount":3,"object":"pv_player","op":"fx.glow","time":0.5},{"bus":"snd_mend","gain":0.4,"name":"chirp","op":"sound.play","pitch":0.9}],"id":"last_mend","on":"actor.dead:player","when":"is(game, play) and life_mode == 2 and shield(player) * (8 / shield_rate) + shards > 0.01"},{"do":[{"op":"var.set","value":"hp(player)","var":"hp_seen"}],"id":"hp_track","on":"actor.hit:player"},{"do":[{"actor":"player","op":"actor.armor","value":"life_mode"}],"id":"life_mode","on":"every:0.2"},{"do":[{"id":"pv_player","op":"object.tint","value":"1 - (0.16 * (hp(player) <= 2) + 0.16 * (hp(player) <= 1) + 0.12 * (hp(player) <= 1) * (0.5 + 0.5 * sin(time * 5))) * (life_mode != 2 or shield(player) * (8 / shield_rate) + shards < 0.01)"}],"id":"weak","on":"every:0.05","when":"is(game, play)"},{"do":[{"actor":"player","op":"actor.radius","value":"0.55 + min(1, shield(player)) * (0.4 + 0.28 * min(tail_max, shield(player)))"}],"id":"reach_rings","on":"every:0.1","when":"is(game, play) and shield_spiral == 0 and life_mode >= 1"},{"do":[{"actor":"player","op":"actor.radius","value":"0.55 + min(1, shield(player)) * (1.24 + 0.14 * min(tail_max, shield(player) + shards / (8 / shield_rate)))"}],"id":"reach_both","on":"every:0.1","when":"is(game, play) and shield_spiral == 1 and shield_style == 2 and life_mode >= 1"},{"do":[{"actor":"player","op":"actor.radius","value":"0.55 + min(1, shield(player)) * (0.95 + 0.18 * min(tail_max, shield(player) + shards / (8 / shield_rate)) - 0.55)"}],"id":"reach_tail","on":"every:0.1","when":"is(game, play) and shield_spiral == 1 and shield_style == 1 and life_mode >= 1"},{"do":[{"actor":"player","op":"actor.radius","value":0.55}],"id":"reach_soft","on":"every:0.1","when":"is(game, play) and ((shield_spiral == 1 and shield_style == 0) or life_mode == 0)"},{"do":[{"op":"var.set","value":"max(0, shield(player) * (8 / shield_rate) + shards - n * tail_cost * (8 / shield_rate))","var":"tail_len"},{"actor":"player","op":"actor.shield","value":"floor(tail_len / (8 / shield_rate))"},{"op":"var.set","value":"tail_len - floor(tail_len / (8 / shield_rate)) * (8 / shield_rate)","var":"shards"},{"amount":1.6,"gap":0.2,"object":"pv_player","op":"fx.glow","time":0.15},{"bus":"snd_tailhit","gain":0.42,"gap":0.15,"name":"thump","op":"sound.play","pitch":1.15},{"bus":"snd_tailhit","gain":0.12,"gap":0.15,"name":"whoosh","op":"sound.play","pitch":2.2}],"id":"tail_hit","on":"msg:tail_hit","when":"is(game, play) and not (nova_hold == 1 and nova_parry == 1)"},{"do":[{"amount":0.35,"gap":0.15,"id":"pv_hud_mult","op":"shape.kick"},{"op":"var.set","value":"min(tail_max, shield(player) + shards / (8 / shield_rate))","var":"tail_seen"}],"id":"tail_up","on":"every:0.05","when":"is(game, play) and min(tail_max, shield(player) + shards / (8 / shield_rate)) > tail_seen + 0.02"},{"do":[{"gap":0.3,"id":"pv_hud_tail_dn","op":"shape.play","time":0.35},{"op":"var.set","value":"min(tail_max, shield(player) + shards / (8 / shield_rate))","var":"tail_seen"}],"id":"tail_dn","on":"every:0.05","when":"is(game, play) and min(tail_max, shield(player) + shards / (8 / shield_rate)) < tail_seen - 0.02"},{"do":[{"actor":"player","op":"actor.shield","value":"floor(min(tail_start, tail_max))"},{"op":"var.set","value":"(min(tail_start, tail_max) - floor(min(tail_start, tail_max))) * (8 / shield_rate)","var":"shards"},{"op":"var.set","value":"min(tail_start, tail_max)","var":"tail_seen"}],"id":"tail_begin0","on":"play.start"},{"do":[{"actor":"player","op":"actor.shield","value":"floor(min(tail_start, tail_max))"},{"op":"var.set","value":"(min(tail_start, tail_max) - floor(min(tail_start, tail_max))) * (8 / shield_rate)","var":"shards"},{"op":"var.set","value":"min(tail_start, tail_max)","var":"tail_seen"}],"id":"tail_begin","on":"msg:start_mode"},{"do":[{"amount":0.25,"id":"pv_hud_tail_max","op":"shape.kick"}],"id":"tail_full","on":"every:1.1","when":"is(game, play) and min(tail_max, shield(player) + shards / (8 / shield_rate)) >= tail_max"},{"do":[{"op":"var.set","value":0,"var":"shards"}],"id":"tail_cap","on":"every:0.1","when":"is(game, play) and shield(player) >= tail_max and shards > 0"},{"do":[{"op":"var.add","value":"1 * n * full_bonus","var":"score"},{"amount":0.4,"id":"pv_hud_tail_max","op":"shape.kick"}],"id":"tail_over","on":"emitter.hit:shards","when":"is(game, play) and shield(player) >= tail_max"},{"do":[{"op":"var.add","value":"1 * n * full_bonus","var":"score"},{"amount":0.4,"id":"pv_hud_tail_max","op":"shape.kick"}],"id":"tail_over_b","on":"emitter.hit:bcores","when":"is(game, play) and shield(player) >= tail_max"},{"do":[{"op":"var.add","value":"1 * n * full_bonus","var":"score"},{"amount":0.4,"id":"pv_hud_tail_max","op":"shape.kick"}],"id":"tail_over_bh","on":"emitter.hit:bcores_h","when":"is(game, play) and shield(player) >= tail_max"},{"do":[{"op":"var.add","value":"(2 * core_val) * n * full_bonus","var":"score"},{"amount":0.4,"id":"pv_hud_tail_max","op":"shape.kick"}],"id":"tail_over_c","on":"emitter.hit:cores","when":"is(game, play) and shield(player) >= tail_max"},{"do":[{"op":"var.add","value":"(2 * core_val) * n * full_bonus","var":"score"},{"amount":0.4,"id":"pv_hud_tail_max","op":"shape.kick"}],"id":"tail_over_ch","on":"emitter.hit:cores_h","when":"is(game, play) and shield(player) >= tail_max"},{"do":[{"amount":0.35,"gap":0.15,"id":"pv_hud_laser","op":"shape.kick"},{"op":"var.set","value":"(wlvl + (wlvl < 5) * min(1, max(0, (wxp - w_at) / max(0.01, w_next - w_at))))","var":"gun_seen"}],"id":"gun_up","on":"every:0.05","when":"is(game, play) and (wlvl + (wlvl < 5) * min(1, max(0, (wxp - w_at) / max(0.01, w_next - w_at)))) > gun_seen + 0.01"},{"do":[{"gap":0.3,"id":"pv_hud_laser_dn","op":"shape.play","time":0.35},{"op":"var.set","value":"(wlvl + (wlvl < 5) * min(1, max(0, (wxp - w_at) / max(0.01, w_next - w_at))))","var":"gun_seen"}],"id":"gun_dn","on":"every:0.05","when":"is(game, play) and (wlvl + (wlvl < 5) * min(1, max(0, (wxp - w_at) / max(0.01, w_next - w_at)))) < gun_seen - 0.01"}],"vars":{"body_ratio":{"keep":true,"value":4},"full_bonus":{"keep":true,"value":150},"gun_seen":1,"heal":0,"life_mode":{"keep":true,"value":2},"shield_hit_t":-10,"shield_rate":{"keep":true,"value":1},"shield_spiral":{"keep":true,"value":1},"shield_style":{"keep":true,"value":0},"tail_cost":{"keep":true,"value":0.25},"tail_inertia":{"keep":true,"value":0.5},"tail_len":0,"tail_max":{"keep":true,"value":4},"tail_seen":0,"tail_start":{"keep":true,"value":2},"tail_wave":{"keep":true,"value":0.12},"tail_wave_fade":{"keep":true,"value":2.5},"tail_wave_speed":{"keep":true,"value":6}}},{"id":"boss","rules":[{"do":[{"id":"pv_boss","on":true,"op":"object.show"},{"id":"pv_orbs","on":false,"op":"object.show"},{"id":"pv_crown","on":true,"op":"object.show"},{"id":"pv_core","on":false,"op":"object.show"},{"id":"pv_gem","on":false,"op":"object.show"},{"id":"pv_player","on":true,"op":"object.show"},{"actor":"boss","op":"actor.radius","value":1.6},{"id":"pv_crown","op":"object.move","s":[0.02,0.02,0.02],"time":0}],"id":"start","on":"state.enter:phase1"},{"do":[{"id":"pv_sq","on":true,"op":"object.show"},{"id":"pv_q0","on":false,"op":"object.show"},{"id":"pv_q1","on":false,"op":"object.show"},{"id":"pv_q2","on":false,"op":"object.show"},{"id":"pv_q3","on":false,"op":"object.show"},{"id":"pv_sq","op":"object.move","r":[0,0,0],"time":0,"to":[0,0,0]},{"op":"var.set","value":1,"var":"solo"}],"id":"start_solo","on":"state.enter:phase1"},{"do":[{"id":"pv_q0","op":"object.move","r":[0,0,0],"s":[2.2,2.2,2.2],"time":0,"to":[0,0,0]},{"id":"pv_q1","op":"object.move","r":[0,0,0],"s":[2.2,2.2,2.2],"time":0,"to":[0,0,0]},{"id":"pv_q2","op":"object.move","r":[0,0,0],"s":[2.2,2.2,2.2],"time":0,"to":[0,0,0]},{"id":"pv_q3","op":"object.move","r":[0,0,0],"s":[2.2,2.2,2.2],"time":0,"to":[0,0,0]},{"actor":"boss","key":"roam_speed","op":"actor.set","value":3.8},{"actor":"boss","key":"roam_wait","op":"actor.set","value":2.2}],"id":"start_form","on":"state.enter:phase1"},{"do":[{"op":"state.set","state":"phase2"}],"id":"to2","on":"actor.hp_below:boss:0.66","when":"is(phase1) and hp(boss) > 0 and not is(game, over)"},{"do":[{"op":"var.set","value":1,"var":"ring_col"},{"op":