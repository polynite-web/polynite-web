ue":1},{"at":"boss","lean":0.45,"op":"camera.move","pitch":-5,"time":4.5,"zoom":0.8},{"after":0.45,"id":"sq_split","op":"timer.start"},{"after":1.7,"id":"sq_blast","op":"timer.start"},{"after":2.1,"id":"sq_close","op":"timer.start"}],"id":"sq_wind","on":"msg:sq_huddle"},{"do":[{"id":"pv_q0","op":"object.move","time":0.45,"to":[-1.55,0,-1.55]},{"id":"pv_q1","op":"object.move","time":0.45,"to":[1.55,0,-1.55]},{"id":"pv_q2","op":"object.move","time":0.45,"to":[1.55,0,1.55]},{"id":"pv_q3","op":"object.move","time":0.45,"to":[-1.55,0,1.55]}],"id":"sq_split1","on":"timer:sq_split","when":"phase == 1 and ls == 0"},{"do":[{"id":"pv_q0","op":"object.move","time":0.45,"to":[-3.3,0,-3.3]},{"id":"pv_q1","op":"object.move","time":0.45,"to":[3.3,0,-3.3]},{"id":"pv_q2","op":"object.move","time":0.45,"to":[3.3,0,3.3]},{"id":"pv_q3","op":"object.move","time":0.45,"to":[-3.3,0,3.3]}],"id":"sq_split2","on":"timer:sq_split","when":"phase >= 2 and ls == 0"},{"do":[{"id":"pv_gem","op":"object.move","r":[0,0,0],"s":[0.25,0.25,0.25],"time":0},{"id":"pv_gem","on":true,"op":"object.show"},{"id":"pv_gem","op":"object.move","r":[0,540,0],"s":[1.6,1.6,1.6],"time":1.2},{"amount":3,"object":"pv_gem","op":"fx.glow","time":1.2},{"bus":"snd_blast","gain":0.35,"name":"magic","op":"sound.play","pitch":0.7},{"bus":"snd_blast","gain":0.25,"name":"whoosh","op":"sound.play","pitch":0.5}],"id":"sq_gem","on":"timer:sq_split"},{"do":[{"amount":1.6,"op":"fx.flash","time":0.9},{"amount":0.55,"op":"fx.shake","time":0.5},{"bus":"snd_blast","gain":0.55,"name":"boom","op":"sound.play","pitch":0.7},{"fx":"lines","id":"pv_gem","on":false,"op":"object.show"}],"id":"sq_blast","on":"timer:sq_blast"},{"do":[{"id":"pv_q0","op":"object.move","time":0.3,"to":[-0.9,0,-0.9]},{"id":"pv_q1","op":"object.move","time":0.3,"to":[0.9,0,-0.9]},{"id":"pv_q2","op":"object.move","time":0.3,"to":[0.9,0,0.9]},{"id":"pv_q3","op":"object.move","time":0.3,"to":[-0.9,0,0.9]},{"bus":"snd_blast","gain":0.5,"name":"thump","op":"sound.play","pi