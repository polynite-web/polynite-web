    },
    {
     "id": "nova",
     "rules": [
      {
       "do": [
        {
         "op": "var.set",
         "value": 1,
         "var": "nova_hold"
        },
        {
         "op": "var.set",
         "value": 1,
         "var": "nova_open"
        },
        {
         "ids": [
          "player_laser"
         ],
         "op": "emitter.stop"
        },
        {
         "gain": 0.45,
         "name": "magic",
         "op": "sound.play",
         "pitch": 0.7
        },
        {
         "actor": "player",
         "op": "actor.pose",
         "pose": "charge",
         "time": 0.25
        }
       ],
       "id": "grab",
       "on": "input.pressed:Fire",
       "when": "is(game, play) and shield_spiral == 1 and shield_style == 0 and shield(player) + shards > 0"
      },
      {
       "do": [
        {
         "op": "var.set",
         "value": "min(nova_rate * 0.05, shield(player) + shards / (8 / shield_rate))",
         "var": "nova_d"
        },
        {
         "op": "var.set",
         "value": "max(0, shield(player) * (8 / shield_rate) + shards - nova_d * (8 / shield_rate))",
         "var": "tail_len"
        },
        {
         "actor": "player",
         "op": "actor.shield",
         "value": "floor(tail_len / (8 / shield_rate))"
        },
        {
         "op": "var.set",
         "value": "tail_len - floor(tail_len / (8 / shield_rate)) * (8 / shield_rate)",
         "var": "shards"
        },
        {
         "max": 4,
         "op": "var.add",
         "value": "nova_d",
         "var": "nova_charge"
        },
        {
         "gain": 0.18,
         "gap": 0.07,
         "name": "tick",
         "op": "sound.play",
         "pitch": "0.7 + nova_charge * 0.4"
        },
        {
         "amount": 0.4,
         "gap": 0.12,
         "object": "pv_player",
         "op": "fx.glow",
         "time": 0.12
        },
        {
         "actor": "player",
         "gap": 0.25,
         "op": "actor.pose",
         "pose": "charge",
         "time": 0.15
        }
       ],
       "id": "drain",
       "on": "every:0.05",
       "when": "nova_hold == 1 and is(game, play)"
      },
      {
       "do": [
        {
         "ids": [
          "player_laser"
         ],
         "op": "emitter.start"
        }
       ],
       "id": "release_l",
       "on": "input.released:Fire",
       "when": "nova_hold == 1 and is(game, play)"
      },
      {
       "do": [
        {
         "op": "var.set",
         "value": 0,
         "var": "nova_hold"
        },
        {
         "op": "var.set",
         "value": "(nova_charge > 0.05) + (nova_charge >= 1) + (nova_charge >= 2.5)",
         "var": "nova_tier"
        },
        {
         "op": "var.set",
         "value": "nova_charge",
         "var": "nova_used"
        },
        {
         "op": "var.set",
         "value": 0,
         "var": "nova_charge"
        },
        {
         "msg": "nova_go",
         "op": "emit"
        },
        {
         "actor": "player",
         "op": "actor.pose",
         "pose": "blast",
         "time": 0.08
        }
       ],
       "id": "release",
       "on": "input.released:Fire",
       "when": "nova_hold == 1"
      },
      {
       "do": [
        {
         "actor": "player",
         "gap": 0.25,
         "op": "actor.pose",
         "pose": "blast",
         "time": 0.08
        }
       ],
       "id": "mouth_open",
       "on": "every:0.05",
       "when": "nova_open == 1 and nova_hold == 0"
      },
      {
       "do": [
        {
         "after": 0.25,
         "id": "mouth_shut",
         "op": "timer.start"
        }
       ],
       "id": "nova0",
       "on": "msg:nova_go",
       "when": "nova_tier == 0 or not is(game, play)"
      },
      {
       "do": [
        {
         "op": "var.set",
         "value": 0,
         "var": "nova_hold"
        },
        {
         "op": "var.set",
         "value": 0,
         "var": "nova_open"
        },
        {
         "op": "var.set",
         "value": 0,
         "var": "nova_charge"
        },
        {
         "op": "var.set",
         "value": 0,
         "var": "nova_left"
        },
        {
         "actor": "player",
         "op": "actor.pose",
         "pose": "focus",
         "time": 0.2
        }
       ],
       "id": "nova_end",
       "on": "every:0.25",
       "when": "(nova_open == 1 or nova_hold == 1) and not is(game, play)"
      },
      {
       "do": [
        {
         "op": "var.set",
         "value": 0,
         "var": "nova_open"
        },
        {
         "actor": "player",
         "op": "actor.pose",
         "pose": "focus",
         "time": 0.3
        }
       ],
       "id": "mouth_shut",
       "on": "timer:mouth_shut",
       "when": "nova_hold == 0"
      },
      {
       "do": [
        {
         "ids": [
          "nova_beam_1"
         ],
         "op": "emitter.fire"
        },
        {
         "op": "var.set",
         "value": 10,
         "var": "nova_left"
        },
        {
         "op": "var.set",
         "value": "nova_used * nova_power * 110 * 1 / 10",
         "var": "nova_dmg"
        },
        {
         "amount": 0.4,
         "op": "fx.flash",
         "time": 0.2
        },
        {
         "gain": 0.5,
         "name": "whoosh",
         "op": "sound.play",
         "pitch": 1.4
        },
        {
         "after": 1.3,
         "id": "mouth_shut",
         "op": "timer.start"
        }
       ],
       "id": "nova1",
       "on": "msg:nova_go",
       "when": "nova_tier == 1 and is(game, play)"
      },
      {
       "do": [
        {
         "ids": [
          "nova_beam_2"
         ],
         "op": "emitter.fire"
        },
        {
         "op": "var.set",
         "value": 16,
         "var": "nova_left"
        },
        {
         "op": "var.set",
         "value": "nova_used * nova_power * 110 * 1.3 / 16",
         "var": "nova_dmg"
        },
        {
         "amount": 1,
         "op": "fx.flash",
         "time": 0.4
        },
        {
         "amount": 0.45,
         "op": "fx.shake",
         "time": 0.4
        },
        {
         "id": "pv_shock",
         "op": "shape.play",
         "time": 1
        },
        {
         "gain": 0.45,
         "name": "boom",
         "op": "sound.play",
         "pitch": 1.2
        },
        {
         "after": 1.9,
         "id": "mouth_shut",
         "op": "timer.start"
        }
       ],
       "id": "nova2",
       "on": "msg:nova_go",
       "when": "nova_tier == 2 and is(game, play)"
      },
      {
       "do": [
        {
         "op": "var.set",
         "value": 0,
         "var": "nova_d"
        },
        {
         "op": "var.set",
         "value": "26 * (1 - nova_aim)",
         "var": "nova_left"
        },
        {
         "op": "var.set",
         "value": "nova_used * nova_power * 110 * 1.8 / 26",
         "var": "nova_dmg"
        },
        {
         "amount": 2.6,
         "op": "fx.flash",
         "time": 0.9
        },
        {
         "amount": 1,
         "op": "fx.shake",
         "time": 1.1
        },
        {
         "op": "fx.slowmo",
         "scale": 0.35,
         "time": 1.3
        },
        {
         "id": "pv_banner_nova",
         "op": "shape.play",
         "time": 2.4
        },
        {
         "gain": 0.8,
         "name": "boom",
         "op": "sound.play",
         "pitch": 0.6
        }
       ],
       "id": "nova3",
       "on": "msg:nova_go",
       "when": "nova_tier == 3 and is(game, play)"
      },
      {
       "do": [
        {
         "ids": [
          "nova_beam_3"
         ],
         "op": "emitter.fire"
        },
        {
         "after": 2.9,
         "id": "mouth_shut",
         "op": "timer.start"
        }
       ],
       "id": "super_auto",
       "on": "msg:nova_go",
       "when": "nova_tier == 3 and nova_aim == 0 and is(game, play)"
      },
      {
       "do": [
        {
         "ids": [
          "nova_beam_aim"
         ],
         "op": "emitter.fire"
        },
        {
         "after": 2.9,
         "id": "mouth_shut",
         "op": "timer.start"
        }
       ],
       "id": "super_aim",
       "on": "msg:nova_go",
       "when": "nova_tier == 3 and nova_aim == 1 and is(game, play)"
      },
      {
       "do": [
        {
         "actor": "boss",
         "op": "actor.hp",
         "value": "hp(boss) - nova_dmg * n"
        },
        {
         "amount": 3,
         "gap": 0.2,
         "object": "pv_boss",
         "op": "fx.glow",
         "time": 0.12
        }
       ],
       "id": "aim_sq",
       "on": "emitter.hit:nova_beam_aim",
       "when": "hp(boss) > 0"
      },
      {
       "do": [
        {
         "actor": "hex",
         "op": "actor.hp",
         "value": "hp(hex) - nova_dmg * n"
        },
        {
         "amount": 3,
         "gap": 0.2,
         "object": "hx_boss",
         "op": "fx.glow",
         "time": 0.12
        }
       ],
       "id": "aim_hx",
       "on": "emitter.hit:nova_beam_aim",
       "when": "hp(boss) <= 0 and hp(hex) > 0"
      },
      {
       "do": [
        {
         "max": 4,
         "op": "var.add",
         "value": "n * tail_cost",
         "var": "nova_charge"
        },
        {
         "amount": 1.2,
         "gap": 0.1,
         "object": "pv_player",
         "op": "fx.glow",
         "time": 0.15
        },
        {
         "gain": 0.35,
         "gap": 0.06,
         "name": "confirm",
         "op": "sound.play",
         "pitch": "1.0 + nova_charge * 0.25"
        }
       ],
       "id": "parry",
       "on": "msg:tail_hit",
       "when": "is(game, play) and nova_hold == 1 and nova_parry == 1"
      },
      {
       "do": [
        {
         "ids": [
          "boss_spiral",
          "boss_ring",
          "boss_aim",
          "boss_wide",
          "boss_laser",
          "orb_fire_0",
          "orb_fire_1",
          "hx_lattice",
          "hx_curve",
          "hx_burst",
          "hx_laser",
          "hx_wide"
         ],
         "op": "emitter.clear"
        },
        {
         "at": "boss",
         "lean": 0.4,
         "op": "camera.move",
         "time": 2.2,
         "zoom": 0.8
        },
        {
         "id": "pv_shock",
         "op": "shape.play",
         "time": 1
        },
        {
         "gain": 0.7,
         "name": "bell",
         "op": "sound.play",
         "pitch": 0.6
        }
       ],
       "id": "supernova",
       "on": "msg:nova_go",
       "when": "nova_tier == 3 and is(game, play)"
      },
      {
       "do": [
        {
         "actor": "boss",
         "op": "actor.hp",
         "value": "hp(boss) - nova_dmg"
        },
        {
         "op": "var.add",
         "value": -1,
         "var": "nova_left"
        },
        {
         "amount": 3,
         "gap": 0.2,
         "object": "pv_boss",
         "op": "fx.glow",
         "time": 0.12
        }
       ],
       "id": "burn_sq",
       "on": "every:0.1",
       "when": "nova_left > 0 and hp(boss) > 0"
      },
      {
       "do": [
        {
         "actor": "hex",
         "op": "actor.hp",
         "value": "hp(hex) - nova_dmg"
        },
        {
         "op": "var.add",
         "value": -1,
         "var": "nova_left"
        },
        {
         "amount": 3,
         "gap": 0.2,
         "object": "hx_boss",
         "op": "fx.glow",
         "time": 0.12
        }
       ],
       "id": "burn_hx",
       "on": "every:0.1",
       "when": "nova_left > 0 and hp(boss) <= 0 and hp(hex) > 0"
      },
      {
       "do": [
        {
         "op": "var.set",
         "value": 0,
         "var": "nova_left"
        }
       ],
       "id": "burn_none",
       "on": "every:0.1",
       "when": "nova_left > 0 and hp(boss) <= 0 and hp(hex) <= 0"
      }
     ],
     "vars": {
      "nova_aim": {
       "keep": true,
       "value": 1
      },
      "nova_charge": 0,
      "nova_d": 0,
      "nova_dmg": 0,
      "nova_hold": 0,
      "nova_left": 0,
      "nova_open": 0,
      "nova_parry": {
       "keep": true,
       "value": 1
      },
      "nova_power": {
       "keep": true,
       "value": 1
      },
      "nova_rate": {
       "keep": true,
       "value": 1.5
      },
      "nova_tier": 0,
      "nova_used": 0
     }
    },
    {
     "id": "setup",
     "rules": [
      {
       "do": [
        {
         "actor": "player",
         "op": "actor.hp",
         "value": "max(hp(player), 3)"
        }
       ],
       "id": "god",
       "on": "every:0.2",
       "when": "dev_god == 1 and is(game, play)"
      },
      {
       "do": [
        {
         "actor": "player",
         "op": "actor.shield",
         "value": 4
        }
       ],
       "id": "full",
       "on": "every:0.3",
       "when": "dev_shield == 1 and is(game, play)"
      }
     ],
     "vars": {
      "dev_god": {
       "keep": true,
       "value": 0
      },
      "dev_shield": {
       "keep": true,
       "value": 0
      },
      "disc_on": {
       "keep": true,
       "value": 1
      },
      "disc_strength": {
       "keep": true,
       "value": 1
      },
      "sfx_enemy": {
       "keep": true,
       "value": 1
      },
      "sfx_hero": {
       "keep": true,
       "value": 1
      }
     }
    }
   ],
   "hud": [
    {
     "shape": "pv_rays",
     "when": "(is(game, title) or is(game, over) or is(game, win)) and not paused"
    },
    {
     "shape": "pv_title",
     "when": "is(game, title) and not paused"
    },
    {
     "shape": "pv_menu_sq",
     "when": "is(game, title) and not paused"
    },
    {
     "shape": "pv_menu_sq_on",
     "when": "is(game, title) and not paused and abs(wrap(angle(player) + 90)) < 32"
    },
    {
     "shape": "pv_menu_sq_arc",
     "when": "is(game, title) and not paused"
    },
    {
     "shape": "pv_menu_sq_on_arc",
     "when": "is(game, title) and not paused and abs(wrap(angle(player) + 90)) < 32"
    },
    {
     "shape": "pv_menu_all",
     "when": "is(game, title) and not paused"
    },
    {
     "shape": "pv_menu_all_on",
     "when": "is(game, title) and not paused and abs(wrap(angle(player))) < 32"
    },
    {
     "shape": "pv_menu_all_arc",
     "when": "is(game, title) and not paused"
    },
    {
     "shape": "pv_menu_all_on_arc",
     "when": "is(game, title) and not paused and abs(wrap(angle(player))) < 32"
    },
    {
     "shape": "pv_menu_hx",
     "when": "is(game, title) and not paused"
    },
    {
     "shape": "pv_menu_hx_on",
     "when": "is(game, title) and not paused and abs(wrap(angle(player) - 90)) < 32"
    },
    {
     "shape": "pv_menu_hx_arc",
     "when": "is(game, title) and not paused"
    },
    {
     "shape": "pv_menu_hx_on_arc",
     "when": "is(game, title) and not paused and abs(wrap(angle(player) - 90)) < 32"
    },
    {
     "shape": "pv_title_ring",
     "when": "is(game, title) and not paused"
    },
    {
     "shape": "pv_title_ring_t",
     "when": "is(game, title) and not paused"
    },
    {
     "shape": "pv_life_sq",
     "v": [
      "hp_ratio(boss)"
     ],
     "when": "is(game, play) and hp(boss) > 0"
    },
    {
     "shape": "pv_life_hx",
     "v": [
      "hp_ratio(hex)"
     ],
     "when": "is(game, play) and hp(hex) > 0 and not is(hex, dormant)"
    },
    {
     "shape": "pv_hud_score",
     "v": [
      "score",
      "hp(player)"
     ],
     "when": "not is(game, title)"
    },
    {
     "shape": "pv_shield_0",
     "v": [
      "x(player)",
      "z(player)",
      "max(0, 1 - (time - shield_hit_t) * 1.6)",
      "(hit_angle(player) - 90) * 0.0174533"
     ],
     "when": "is(game, play) and shield(player) >= 1"
    },
    {
     "shape": "pv_shield_1",
     "v": [
      "x(player)",
      "z(player)",
      "max(0, 1 - (time - shield_hit_t) * 1.6)",
      "(hit_angle(player) - 90) * 0.0174533"
     ],
     "when": "is(game, play) and shield(player) >= 1 and shield_spiral == 0"
    },
    {
     "shape": "pv_shield_2",
     "v": [
      "x(player)",
      "z(player)",
      "max(0, 1 - (time - shield_hit_t) * 1.6)",
      "(hit_angle(player) - 90) * 0.0174533"
     ],
     "when": "is(game, play) and shield(player) >= 2 and shield_spiral == 0"
    },
    {
