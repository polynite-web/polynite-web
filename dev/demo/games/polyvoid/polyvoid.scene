y:0.25","when":"is(game, play) and wlvl >= 4 and hp(ally0) <= 0 and time > ally_cd0 and hp(player) > 0"},{"do":[{"actor":"ally1","op":"actor.hp","value":1},{"id":"pv_ally1","on":true,"op":"object.show"},{"ids":["ally_fire1"],"op":"emitter.start"},{"object":"pv_ally1","op":"fx.pulse","scale":1.8,"time":0.35},{"amount":3,"object":"pv_ally1","op":"fx.glow","time":0.4},{"bus":"snd_allyon","gain":0.5,"name":"chirp","op":"sound.play","pitch":1.7}],"id":"ally_on1","on":"every:0.25","when":"is(game, play) and wlvl >= 5 and hp(ally1) <= 0 and time > ally_cd1 and hp(player) > 0"},{"do":[{"fx":"lines","id":"pv_ally0","on":false,"op":"object.show"},{"ids":["ally_fire0"],"op":"emitter.stop"},{"op":"var.set","value":"time + 6","var":"ally_cd0"},{"bus":"snd_allydown","gain":0.3,"name":"boom","op":"sound.play","pitch":1.9},{"amount":0.15,"op":"fx.shake","time":0.2}],"id":"ally_down0","on":"actor.dead:ally0"},{"do":[{"fx":"lines","id":"pv_ally1","on":false,"op":"object.show"},{"ids":["ally_fire1"],"op":"emitter.stop"},{"op":"var.set","value":"time + 6","var":"ally_cd1"},{"bus":"snd_allydown","gain":0.3,"name":"boom","op":"sound.play","pitch":1.9},{"amount":0.15,"op":"fx.shake","time":0.2}],"id":"ally_down1","on":"actor.dead:ally1"},{"do":[{"op":"var.set","value":"w_start","var":"wlvl"},{"op":"var.set","value":"(((w_start) >= 2) * w_t2 + ((w_start) >= 3) * (w_t3 - w_t2) + ((w_start) >= 4) * (w_t4 - w_t3) + ((w_start) >= 5) * (w_t5 - w_t4)) * w_scale","var":"wxp"},{"op":"var.set","value":"(((wlvl) >= 2) * w_t2 + ((wlvl) >= 3) * (w_t3 - w_t2) + ((wlvl) >= 4) * (w_t4 - w_t3) + ((wlvl) >= 5) * (w_t5 - w_t4)) * w_scale","var":"w_at"},{"op":"var.set","value":"((((wlvl + 1)) >= 2) * w_t2 + (((wlvl + 1)) >= 3) * (w_t3 - w_t2) + (((wlvl + 1)) >= 4) * (w_t4 - w_t3) + (((wlvl + 1)) >= 5) * (w_t5 - w_t4)) * w_scale","var":"w_next"}],"id":"w_begin","on":"msg:start_mode"},{"do":[{"op":"var.set","value":"(((wlvl) >= 2) * w_t2 + ((wlvl) >= 3) * (w_t3 - w_t2) + ((wlvl) >= 4) * (w_t4 - w_t3) + ((wlvl) >= 5) * (w_t5 - w_t4)) * w_scale","var":"w_at"},{"op":"var.set","value":"((((wlvl + 1)) >= 2) * w_t2 + (((wlvl + 1)) >= 3) * (w_t3 - w_t2) + (((wlvl + 1)) >= 4) * (w_t4 - w_t3) + (((wlvl + 1)) >= 5) * (w_t5 - w_t4)) * w_scale","var":"w_next"}],"id":"w_edges","on":"every:0.05"},{"do":[{"op":"emitter.set","set":[{"from":"boss","hit":{"absorb":0.3,"damage":0,"radius":1,"tags":["player"]},"id":"cores","max":24,"pattern":{"aim":"player","arc":2.8,"bounce":0.5,"count":1,"gravity":16,"jitter":0.2,"kind":"burst","land":true,"land_band":[7.9,9.9],"life":6,"speed":6.5,"spin":260,"spread":110,"warn_shape":"pv_shot_shadow"},"seed":17,"shape":"pv_energy_cube","trigger":"manual","y":0.5},{"from":"hex","hit":{"absorb":0.3,"damage":0,"radius":1,"tags":["player"]},"id":"cores_h","max":24,"pattern":{"aim":"player","arc":2.8,"bounce":0.5,"count":1,"gravity":16,"jitter":0.2,"kind":"burst","land":true,"land_band":[7.9,9.9],"life":6,"speed":6.5,"spin":260,"spread":110,"warn_shape":"pv_shot_shadow"},"seed":17,"shape":"pv_energy_cube","trigger":"manual","y":0.5}]}],"id":"core_look0","on":"msg:start_mode","when":"core_look == 0"},{"do":[{"op":"emitter.set","set":[{"from":"boss","hit":{"absorb":0.3,"damage":0,"radius":1,"tags":["player"]},"id":"cores","max":24,"pattern":{"aim":"player","arc":2.8,"bounce":0.5,"count":1,"gravity":16,"jitter":0.2,"kind":"burst","land":true,"land_band":[7.9,9.9],"life":6,"speed":6.5,"spin":260,"spread":110,"warn_shape":"pv_shot_shadow"},"seed":17,"shape":"pv_energy","trigger":"manual","y":0.5},{"from":"hex","hit":{"absorb":0.3,"damage":0,"radius":1,"tags":["player"]},"id":"cores_h","max":24,"pattern":{"aim":"player","arc":2.8,"bounce":0.5,"count":1,"gravity":16,"jitter":0.2,"kind":"burst","land":true,"land_band":[7.9,9.9],"life":6,"speed":6.5,"spin":260,"spread":110,"warn_shape":"pv_shot_shadow"},"seed":17,"shape":"pv_energy","trigger":"manual","y":0.5}]}],"id":"core_look1","on":"msg:start_mode","when":"core_look == 1"},{"do":[{"op":"emitter.set","set":[{"from":"boss","hit":{"absorb":0.3,"damage":0,"radius":1,"tags":["player"]},"id":"cores","max":24,"pattern":{"aim":"player","arc":2.8,"bounce":0.5,"count":1,"gravity":16,"jitter":0.2,"kind":"burst","land":true,"land_band":[7.9,9.9],"life":6,"speed":6.5,"spin":260,"spread":110,"warn_shape":"pv_shot_shadow"},"seed":17,"shape":"pv_energy_dia","trigger":"manual","y":0.5},{"from":"hex","hit":{"absorb":0.3,"damage":0,"radius":1,"tags":["player"]},"id":"cores_h","max":24,"pattern":{"aim":"player","arc":2.8,"bounce":0.5,"count":1,"gravity":16,"jitter":0.2,"kind":"burst","land":true,"land_band":[7.9,9.9],"life":6,"speed":6.5,"spin":260,"spread":110,"warn_shape":"pv_shot_shadow"},"seed":17,"shape":"pv_energy_dia","trigger":"manual","y":0.5}]}],"id":"core_look2","on":"msg:start_mode","when":"core_look == 2"},{"do":[{"op":"var.set","value":"time","var":"gun_lost_t"}],"id":"w_lost_ring","on":"actor.hit:player","when":"is(game, play) and hp(player) < hp_seen and wlvl > 1 and w_loss > 0 and gun_ring == 1"},{"do":[{"op":"var.set","value":"max(0.5, (1 + core_pow * max(0, nova_used - 1)) * (1 + (nova_tier == 3) * (super_core - 1)))","var":"core_val"},{"op":"var.set","value":"(nova_used >= core_min) * min(6 - (nova_tier == 3) * (6 - super_cores), max(1, floor((nova_used * 1.4 + 0.6) / core_val)))","var":"core_left"},{"op":"var.set","value":"(nova_used < core_min) * max(1, floor(nova_used * 4))","var":"core_blue"},{"op":"var.set","value":"min(3, 1 + 0.5 * (core_val - 1))","var":"core_sz"},{"op":"var.set","value":0,"var":"core_n"}],"id":"c_arm","on":"msg:nova_go","when":"nova_tier >= 1"},{"do":[{"ids":["cores"],"op":"emitter.fire","scale":"core_sz"},{"op":"var.add","value":-1,"var":"core_left"},{"bus":"snd_coreborn","gain":0.45,"gap":0.1,"name":"chirp","op":"sound.play","pitch":1.6}],"id":"c_drop","on":"every:0.22","when":"is(game, play) and core_left > 0 and (nova_left > 0 or time - nova_rel_t < 0.8) and hp(boss) > 0"},{"do":[{"ids":["cores_h"],"op":"emitter.fire","scale":"core_sz"},{"op":"va