d hp(player) > 0 and shield_spiral == 1 and shield_style == 0 and shield(player) + shards > 0"},{"do":[{"op":"var.set","value":"shield(player) + shards < 0.05 and nova_charge < 0.05","var":"tail_empty"}],"id":"tail_empty","on":"every:0.1","when":"is(game, play)"},{"do":[{"op":"var.set","value":"min(nova_rate * 0.05, shield(player) + shards / (8 / shield_rate))","var":"nova_d"},{"op":"var.set","value":"max(0, shield(player) * (8 / shield_rate) + shards - nova_d * (8 / shield_rate))","var":"tail_len"},{"actor":"player","op":"actor.shield","value":"floor(tail_len / (8 / shield_rate))"},{"op":"var.set","value":"tail_len - floor(tail_len / (8 / shield_rate)) * (8 / shield_rate)","var":"shards"},{"max":4,"op":"var.add","value":"nova_d","var":"nova_charge"},{"bus":"snd_drain","gain":0.18,"gap":0.07,"name":"tick","op":"sound.play","pitch":"0.7 + nova_charge * 0.4"},{"amount":0.4,"gap":0.12,"object":"pv_player","op":"fx.glow","time":0.12},{"actor":"player","gap":0.25,"op":"actor.pose","pose":"charge","time":0.15}],"id":"drain","on":"every:0.05","when":"nova_hold == 1 and is(game, play)"},{"do":[{"op":"var.set","value":1,"var":"nova_lvl"},{"bus":"snd_lvl","gain":0.45,"name":"bell","op":"sound.play","pitch":1.3},{"amount":2.5,"object":"pv_player","op":"fx.glow","time":0.25},{"amount":0.1,"op":"fx.shake","time":0.15}],"id":"lvl1","on":"every:0.05","when":"nova_hold == 1 and nova_lvl < 1 and nova_charge >= 1"},{"do":[{"op":"var.set","value":2,"var":"nova_lvl"},{"bus":"snd_lvl","gain":0.55,"name":"bell","op":"sound.play","pitch":1.6},{"amount":3.5,"object":"pv_player","op":"fx.glow","time":0.25},{"amount":0.2,"op":"fx.shake","time":0.15}],"id":"lvl2","on":"every:0.05","when":"nova_hold == 1 and nova_lvl < 2 and nova_charge >= 2.5"},{"do":[{"op":"var.set","value":"max(0, shield(player) * (8 / shield_rate) + shards - 0.25 * (8 / shield_rate))","var":"tail_len"},{"actor":"player","op":"actor.shield","value":"floor(tail_len / (8 / shield_rate))"},{"op":"var.set","value":"tail_len - floor(tail_len / (8 / shield_rate)) * (8 / shield_rate)","var":"shards"},{"op":"var.set","value":"min(1, 0.15 + 0.32 * nova_charge)","var":"nova_lf"},{"key":"beam_life","op":"fx.set","value":"min(1, 0.15 + 0.32 * nova_charge)"}],"id":"nova_tax","on":"input.released:Fire","when":"nova_hold == 1 and nova_charge > 0.05"},{"do":[{"op":"var.set","value":"time","var":"nova_rel_t"}],"id":"release_t","on":"input.released:Fire","when":"nova_hold == 1"},{"do":[{"op":"var.set","value":0,"var":"nova_lvl"},{"op":"var.set","value":0,"var":"nova_hold"},{"op":"var.set","value":"(nova_charge > 0.05) + (nova_charge >= 1) + (nova_charge >= 2.5)","var":"nova_tier"},{"op":"var.set","value":"nova_charge","var":"nova_used"},{"op":"var.set","value":0,"var":"nova_charge"},{"msg":"nova_go","op":"emit"},{"actor":"player","op":"actor.pose","pose":"blast","time":0.08}],"id":"release","on":"input.released:Fire","when":"nova_hold == 1"},{"do":[{"actor":"player","gap":0.25,"op":"actor.pose","pose":"blast","time":0.08}],"id":"mouth_open","on":"every:0.05","when":"nova_open == 1 and nova_hold == 0"},{"do":[{"after":0.25,"id":"mouth_shut","op":"timer.start"}],"id":"nova0","on":"msg:nova_go","when":"nova_tier == 0 or not is(game, play)"},{"do":[{"op":"var.set","value":0,"var":"nova_hold"},{"op":"var.set","value":0,"var":"nova_open"},{"op":"var.set","value":0,"var":"nova_charge"},{"op":"var.set","value":0,"var":"nova_left"},{"actor":"player","op":"actor.pose","pose":"focus","time":0.2}],"id":"nova_end","on":"every:0.25","when":"(nova_open == 1 or nova_hold == 1) and not is(game, play)"},{"do":[{"op":"var.set","value":0,"var":"nova_open"},{"actor":"player","op":"actor.pose","pose":"focus","time":0.3}],"id":"mouth_shut","on":"timer:mouth_shut","when":"nova_hold == 0"},{"do":[{"op":"var.set","value":"time","var":"beam_seen_t"}],"id":"mouth_watch","on":"every:0.05","when":"nova_open == 1 and (live(nova_beam_1) + live(nova_beam_2) + live(nova_beam_3) + live(nova_beam_aim)) > 0"},{"do":[{"op":"var.set","value":0,"var":"nova_open"},{"actor":"player","op":"actor.pose","pose":"focus","time":0.15}],"id":"mouth_now","on":"every:0.05","when":"nova_open == 1 and nova_hold == 0 and time - nova_rel_t > 0.2 and time - beam_seen_t > mouth_hold and (live(nova_beam_1) + live(nova_beam_2) + live(nova_beam_3) + live(nova_beam_aim)) == 0"},{"do":[{"ids":["player_laser"],"op":"emitter.start"},{"op":"var.set","value":0,"var":"darts_off"}],"id":"darts_back","on":"timer:mouth_shut","when":"nova_hold == 0 and is(game, play) and hp(player) > 0 and darts_hold == 0"},{"do":[{"ids":["player_laser"],"op":"emitter.start"},{"op":"var.set","value":0,"var":"darts_off"}],"id":"darts_now","on":"every:0.05","when":"is(game, play) and darts_off == 1 and nova_hold == 0 and time - nova_rel_t > 0.06 and (live(nova_beam_1) + live(nova_beam_2) + live(nova_beam_3) + live(nova_beam_aim)) == 0"},{"do":[{"op":"var.set","value":0,"var":"nova_hold"},{"op":"var.set","value":0,"var":"nova_charge"},{"op":"var.set","value":0,"var":"nova_open"},{"op":"var.set","value":0,"var":"nova_lvl"},{"ids":["player_laser"],"op":"emitter.start"},{"op":"var.set","value":0,"var":"darts_off"},{"actor":"player","op":"actor.pose","pose":"focus","time":0.2}],"id":"unstick","on":"every:0.1","when":"is(game, play) and hp(player) > 0 and darts_hold == 0 and nova_hold == 1 and held(Fire) == 0"},{"do":[{"ids":["nova_beam_1"],"op":"emitter.fire","scale":"(0.6 + 0.7 * nova_used + 0.12 * nova_used * nova_used) / 0.8"},{"op":"var.set","value":"max(1, floor(10 * nova_lf))","var":"nova_left"},{"op":"var.set","value":"nova_used * nova_power * 110 * 1 / max(1, floor(10 * nova_lf))","var":"nova_dmg"},{"amount":"min(1, 0.25 + 0.5 * nova_used)","op":"fx.flash","time":0.25},{"amount":"min(0.4, 0.12 + 0.2 * nova_used)","op":"fx.shake","time":0.3},{"bus":"snd_nova1","gain":0.5,"name":"whoosh","op":"sound.play","pitch":1.4},{"after":1.3,"id":"mouth_shut","op":"timer.start"}],"id":"nova1","on":"msg:nova_go","when":"nova_tier == 1 and is(game, play)"},{"do":[