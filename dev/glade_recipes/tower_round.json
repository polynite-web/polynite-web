{
 "what": "A round stone tower with a slate cone, two slit windows and a door.",
 "params": {
  "radius": {
   "default": 2.0,
   "min": 1.6,
   "max": 2.6
  },
  "height": {
   "default": 5.5,
   "min": 4.5,
   "max": 7
  },
  "roof_color": {
   "default": [
    0.55,
    0.25,
    0.2
   ],
   "choices": [
    [
     0.55,
     0.25,
     0.2
    ],
    [
     0.33,
     0.37,
     0.44
    ]
   ]
  }
 },
 "ops": [
  {
   "command": "build.shape",
   "id": "$id",
   "shape": "circle",
   "center": [
    0,
    0
   ],
   "radius": "$radius",
   "height": "$height",
   "thickness": 0.6,
   "style": "stone",
   "color": [
    0.8,
    0.76,
    0.68
   ],
   "seed": "$seed"
  },
  {
   "command": "build.roof",
   "on": "$id",
   "height_01": 0.78,
   "eave_01": 0.3,
   "profile_01": 0.65,
   "color": "$roof_color"
  },
  {
   "command": "build.decorate",
   "on": "$id",
   "type": "door",
   "face": -1,
   "at": 0.25,
   "color": [
    0.35,
    0.22,
    0.12
   ]
  },
  {
   "command": "build.decorate",
   "on": "$id",
   "type": "window",
   "face": -1,
   "at": 0.6,
   "rank": 1,
   "sill": 2.6,
   "height": 0.9
  },
  {
   "command": "build.dress",
   "on": "$id",
   "ivy": 0.3,
   "flowers": 0.3,
   "seed": "$seed"
  }
 ]
}